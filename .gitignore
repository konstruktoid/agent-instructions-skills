.ruff_cache/
.venv/
__pycache__/
node_modules/

# Belt and braces. The eval harness links a credentials file into each run's private
# config directory, which evals/.gitignore already excludes; this makes a credentials
# file uncommittable from anywhere in the tree regardless of how it got there.
**/.credentials.json
.env

# The `local` agent-memory scope moves model-authored notes here rather than making them
# uncommittable, and the files are written without a person reading them first.
/.claude/agent-memory-local/
