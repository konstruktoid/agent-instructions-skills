diff --git a/defaults/main.yml b/defaults/main.yml
index 64b54e4..15f6b4a 100644
--- a/defaults/main.yml
+++ b/defaults/main.yml
@@ -13,3 +13,6 @@ ntp_client_conf_owner: "root"
 
