diff --git a/roles/nftables_base/meta/argument_specs.yml b/roles/nftables_base/meta/argument_specs.yml
new file mode 100644
index 0000000..9ab979d
--- /dev/null
+++ b/roles/nftables_base/meta/argument_specs.yml
@@ -0,0 +1,24 @@
+---
+argument_specs:
+  main:
+    short_description: Applies a base nftables ruleset.
+    options:
+      nftables_base_default_policy:
+        type: str
+        default: drop
+        choices:
+          - drop
+          - accept
+        description: Policy of the input chain for traffic that no rule accepts.
+      nftables_base_allowed_tcp_ports:
+        type: list
+        elements: int
+        default:
+          - 22
+        description: >-
+          TCP destination ports accepted by the input chain. An empty list
+          adds no port rule.
+      nftables_base_ruleset_path:
+        type: path
+        default: /etc/nftables.conf
+        description: File the ruleset is written to.
diff --git a/roles/nftables_base/tasks/main.yml b/roles/nftables_base/tasks/main.yml
index f8ee310..4e45fc0 100644
--- a/roles/nftables_base/tasks/main.yml
+++ b/roles/nftables_base/tasks/main.yml
@@ -9,15 +9,17 @@
     content: |
       table inet filter {
         chain input {
-          type filter hook input priority 0; policy {{ nftables_default_policy }};
+          type filter hook input priority 0; policy {{ nftables_base_default_policy }};
+          iif lo accept
+          ct state established,related accept
+      {% if nftables_base_allowed_tcp_ports | length > 0 %}
+          tcp dport { {{ nftables_base_allowed_tcp_ports | join(', ') }} } accept
+      {% endif %}
         }
       }
-    dest: "{{ nftables_ruleset_path }}"
+    dest: "{{ nftables_base_ruleset_path }}"
+    owner: root
+    group: root
+    mode: "0644"
+    validate: nft -c -f %s
   notify: Reload nftables
-
-- name: Load the ruleset now
-  ansible.builtin.command: nft -f {{ nftables_ruleset_path }}
-
-- name: Check the active ruleset
-  ansible.builtin.shell: nft list ruleset | wc -l
-  register: nftables_rule_lines
