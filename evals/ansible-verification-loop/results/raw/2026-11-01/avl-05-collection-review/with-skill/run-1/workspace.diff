diff --git a/roles/nftables_base/README.md b/roles/nftables_base/README.md
new file mode 100644
index 0000000..73643eb
--- /dev/null
+++ b/roles/nftables_base/README.md
@@ -0,0 +1,11 @@
+# nftables_base
+
+Applies a base nftables ruleset.
+
+## Variables
+
+| Variable | Default | Description |
+|----------|---------|-------------|
+| `nftables_base_default_policy` | `drop` | Policy of the input chain for packets that match no rule. |
+| `nftables_base_allowed_tcp_ports` | `[22]` | TCP destination ports accepted by the input chain. |
+| `nftables_base_ruleset_path` | `/etc/nftables.conf` | File the ruleset is written to and loaded from. |
diff --git a/roles/nftables_base/defaults/main.yml b/roles/nftables_base/defaults/main.yml
index 1cd269b..7d17297 100644
--- a/roles/nftables_base/defaults/main.yml
+++ b/roles/nftables_base/defaults/main.yml
@@ -1,5 +1,5 @@
 ---
-nftables_default_policy: drop
-nftables_allowed_tcp_ports:
+nftables_base_default_policy: drop
+nftables_base_allowed_tcp_ports:
   - 22
-nftables_ruleset_path: /etc/nftables.conf
+nftables_base_ruleset_path: /etc/nftables.conf
diff --git a/roles/nftables_base/meta/argument_specs.yml b/roles/nftables_base/meta/argument_specs.yml
new file mode 100644
index 0000000..f460132
--- /dev/null
+++ b/roles/nftables_base/meta/argument_specs.yml
@@ -0,0 +1,22 @@
+---
+argument_specs:
+  main:
+    short_description: Applies a base nftables ruleset.
+    options:
+      nftables_base_default_policy:
+        type: str
+        default: drop
+        choices:
+          - drop
+          - accept
+        description: Policy of the input chain for packets that match no rule.
+      nftables_base_allowed_tcp_ports:
+        type: list
+        elements: int
+        default:
+          - 22
+        description: TCP destination ports accepted by the input chain.
+      nftables_base_ruleset_path:
+        type: path
+        default: /etc/nftables.conf
+        description: File the ruleset is written to and loaded from.
