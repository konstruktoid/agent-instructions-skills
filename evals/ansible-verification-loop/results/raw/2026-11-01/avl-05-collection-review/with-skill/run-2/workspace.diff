diff --git a/roles/nftables_base/meta/argument_specs.yml b/roles/nftables_base/meta/argument_specs.yml
new file mode 100644
index 0000000..72227f7
--- /dev/null
+++ b/roles/nftables_base/meta/argument_specs.yml
@@ -0,0 +1,27 @@
+---
+argument_specs:
+  main:
+    short_description: Applies a base nftables ruleset.
+    options:
+      nftables_base_default_policy:
+        type: str
+        default: drop
+        choices:
+          - drop
+          - accept
+        description: >-
+          Policy of the input chain. Traffic not matched by an accept rule
+          is handled according to this value.
+      nftables_base_allowed_tcp_ports:
+        type: list
+        elements: int
+        default:
+          - 22
+        description: >-
+          TCP destination ports accepted on the input chain. An empty list
+          adds no port rule.
+      nftables_base_ruleset_path:
+        type: path
+        default: /etc/nftables.conf
+        description: >-
+          File the ruleset is written to and loaded from.
