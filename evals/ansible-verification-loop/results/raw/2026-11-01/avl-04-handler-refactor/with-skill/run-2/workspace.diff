diff --git a/molecule/default/verify.yml b/molecule/default/verify.yml
index 1b182e0..5e34d1b 100644
--- a/molecule/default/verify.yml
+++ b/molecule/default/verify.yml
@@ -11,3 +11,20 @@
       ansible.builtin.assert:
         that:
           - rules_file.stat.exists
+
+    - name: Read auditd.conf
+      ansible.builtin.slurp:
+        src: /etc/audit/auditd.conf
+      register: auditd_conf
+
+    - name: Assert the rotation settings are applied
+      ansible.builtin.assert:
+        that:
+          - >-
+            (auditd_conf.content | b64decode).splitlines()
+            | select('match', '^max_log_file = ' ~ auditd_max_log_file | default(8) ~ '$')
+            | list | length == 1
+          - >-
+            (auditd_conf.content | b64decode).splitlines()
+            | select('match', '^num_logs = ' ~ auditd_num_logs | default(5) ~ '$')
+            | list | length == 1
