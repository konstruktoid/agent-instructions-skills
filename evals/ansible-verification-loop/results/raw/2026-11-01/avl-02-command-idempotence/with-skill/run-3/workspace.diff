diff --git a/README.md b/README.md
index 26d5bf2..4512013 100644
--- a/README.md
+++ b/README.md
@@ -6,6 +6,7 @@ Requests and renews Let's Encrypt certificates.
 
 | Variable | Default | Purpose |
 |----------|---------|---------|
-| `certbot_domains` | `[]` | Domains to request certificates for. |
+| `certbot_domains` | `[]` | Domains to request certificates for. A domain that already has a valid certificate is skipped. |
 | `certbot_email` | `admin@example.com` | Registration contact address. |
 | `certbot_renew_hour` | `3` | Hour the renewal timer fires. |
+| `certbot_staging` | `false` | When true, adds `--staging` to the certificate request so it goes to the Let's Encrypt staging endpoint. |
diff --git a/defaults/main.yml b/defaults/main.yml
index 2f00997..c4dca26 100644
--- a/defaults/main.yml
+++ b/defaults/main.yml
@@ -2,3 +2,4 @@
 certbot_domains: []
 certbot_email: admin@example.com
 certbot_renew_hour: 3
+certbot_staging: false
diff --git a/tasks/main.yml b/tasks/main.yml
index aa2ea2c..6e776e9 100644
--- a/tasks/main.yml
+++ b/tasks/main.yml
@@ -4,12 +4,25 @@
     name: certbot
     state: present
 
-- shell: certbot certificates | grep -c "VALID"
+- name: Count valid certificates for each domain
+  ansible.builtin.shell:
+    cmd: set -o pipefail && certbot certificates -d {{ item }} | grep -c "VALID"
+    executable: /bin/bash
+  loop: "{{ certbot_domains }}"
   register: certbot_valid_count
+  changed_when: false
+  failed_when: certbot_valid_count.rc > 1
+  check_mode: false
 
 - name: Request a certificate for each domain
-  ansible.builtin.command: certbot certonly --standalone -d {{ item }} -m {{ certbot_email }} --agree-tos -n
-  loop: "{{ certbot_domains }}"
+  ansible.builtin.command: >-
+    certbot certonly --standalone -d {{ item.item }} -m {{ certbot_email }}
+    --agree-tos -n{{ ' --staging' if certbot_staging | bool else '' }}
+  loop: "{{ certbot_valid_count.results }}"
+  loop_control:
+    label: "{{ item.item }}"
+  when: item.stdout | int == 0
+  changed_when: true
   notify: Reload nginx
 
 - name: Write the renewal timer
