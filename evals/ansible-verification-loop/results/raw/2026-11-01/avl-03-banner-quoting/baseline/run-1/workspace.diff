+++ b/defaults/main.yml
@@ -3,3 +3,6 @@ banner_path: /etc/issue.net
 banner_owner: root
 banner_mode: "0644"
 banner_show_hostname: true
+# Quoted: an unquoted NO is parsed as boolean false by YAML 1.1.
+banner_country_code: "NO"
+banner_gateway_ports: false
