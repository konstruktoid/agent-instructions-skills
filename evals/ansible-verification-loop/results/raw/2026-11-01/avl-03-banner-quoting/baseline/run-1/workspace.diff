diff --git a/README.md b/README.md
index f07ef50..cd38d17 100644
--- a/README.md
+++ b/README.md
@@ -10,3 +10,5 @@ Renders the pre-authentication login banner.
 | `banner_owner` | `root` | Owner and group of the banner file. |
 | `banner_mode` | `"0644"` | File mode of the banner. |
 | `banner_show_hostname` | `true` | Whether the banner includes the hostname. |
+| `banner_country_code` | `"NO"` | ISO 3166-1 alpha-2 country code, rendered as the `Country:` line. Keep it quoted in YAML: an unquoted `NO` is parsed as boolean `false`. |
+| `banner_gateway_ports` | `false` | When true, the banner states that gateway ports are permitted; when false, that line is omitted. |
diff --git a/defaults/main.yml b/defaults/main.yml
index 6018a10..feb5796 100644
