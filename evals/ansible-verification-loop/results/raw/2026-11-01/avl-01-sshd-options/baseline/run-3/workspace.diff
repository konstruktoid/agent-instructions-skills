diff --git a/molecule/default/verify.yml b/molecule/default/verify.yml
index 13d0aca..c200dfa 100644
--- a/molecule/default/verify.yml
+++ b/molecule/default/verify.yml
@@ -11,3 +11,18 @@
       ansible.builtin.assert:
         that:
           - "'PermitRootLogin no' in (sshd_config.content | b64decode)"
+
+    - name: Confirm MaxAuthTries and LoginGraceTime are set
+      ansible.builtin.assert:
+        that:
+          - "'MaxAuthTries 4' in (sshd_config.content | b64decode)"
+          - "'LoginGraceTime 30' in (sshd_config.content | b64decode)"
+
+    - name: Gather service facts
+      ansible.builtin.service_facts:
+
+    - name: Confirm the OS-appropriate ssh service is known
+      ansible.builtin.assert:
+        that:
+          - (ansible_facts['os_family'] == 'RedHat' and 'sshd.service' in ansible_facts.services)
+            or (ansible_facts['os_family'] == 'Debian' and 'ssh.service' in ansible_facts.services)
diff --git a/tasks/main.yml b/tasks/main.yml
index bcfcc45..d3514d1 100644
--- a/tasks/main.yml
+++ b/tasks/main.yml
@@ -1,7 +1,10 @@
 ---
+- name: Load OS family specific variables
+  ansible.builtin.include_vars: "{{ ansible_facts['os_family'] }}.yml"
+
 - name: Install the openssh server package
   ansible.builtin.package:
-    name: openssh-server
+    name: "{{ sshd_package_name }}"
     state: present
 
 - name: Set the sshd port
@@ -30,3 +33,21 @@
     validate: /usr/sbin/sshd -T -f %s
     mode: "0600"
   notify: Restart sshd
+
+- name: Set maximum authentication attempts
+  ansible.builtin.lineinfile:
+    path: "{{ sshd_config_path }}"
+    regexp: "^#?MaxAuthTries"
+    line: "MaxAuthTries {{ sshd_max_auth_tries }}"
+    validate: /usr/sbin/sshd -T -f %s
+    mode: "0600"
+  notify: Restart sshd
+
+- name: Set login grace time
+  ansible.builtin.lineinfile:
+    path: "{{ sshd_config_path }}"
+    regexp: "^#?LoginGraceTime"
+    line: "LoginGraceTime {{ sshd_login_grace_time }}"
+    validate: /usr/sbin/sshd -T -f %s
+    mode: "0600"
+  notify: Restart sshd
