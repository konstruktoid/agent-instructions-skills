diff --git a/molecule/default/molecule.yml b/molecule/default/molecule.yml
new file mode 100644
index 0000000..847b1f8
--- /dev/null
+++ b/molecule/default/molecule.yml
@@ -0,0 +1,20 @@
+---
+driver:
+  name: docker
+platforms:
+  - name: debian
+    image: geerlingguy/docker-debian12-ansible:latest
+    privileged: true
+    cgroupns_mode: host
+    volumes: ["/sys/fs/cgroup:/sys/fs/cgroup:rw"]
+    command: /lib/systemd/systemd
+  - name: rocky
+    image: geerlingguy/docker-rockylinux9-ansible:latest
+    privileged: true
+    cgroupns_mode: host
+    volumes: ["/sys/fs/cgroup:/sys/fs/cgroup:rw"]
+    command: /usr/lib/systemd/systemd
+provisioner:
+  name: ansible
+verifier:
+  name: ansible
diff --git a/molecule/default/prepare.yml b/molecule/default/prepare.yml
new file mode 100644
index 0000000..3dddde4
--- /dev/null
+++ b/molecule/default/prepare.yml
@@ -0,0 +1,23 @@
+---
+- name: Prepare
+  hosts: all
+  tasks:
+    - name: Refresh the apt cache
+      ansible.builtin.apt:
+        update_cache: true
+      when: ansible_facts['os_family'] == 'Debian'
+
+    - name: Install openssh-server so host keys can be generated
+      ansible.builtin.package:
+        name: openssh-server
+        state: present
+
+    - name: Generate host keys (needed by sshd -T validation)
+      ansible.builtin.command: ssh-keygen -A
+      changed_when: false
+
+    - name: Create the privilege separation directory used by sshd -T
+      ansible.builtin.file:
+        path: /run/sshd
+        state: directory
+        mode: "0755"
diff --git a/molecule/default/verify.yml b/molecule/default/verify.yml
index 13d0aca..13a1abf 100644
--- a/molecule/default/verify.yml
+++ b/molecule/default/verify.yml
@@ -7,7 +7,26 @@
         src: /etc/ssh/sshd_config
       register: sshd_config
 
-    - name: Confirm root login is disabled
+    - name: Confirm the configured options
       ansible.builtin.assert:
         that:
           - "'PermitRootLogin no' in (sshd_config.content | b64decode)"
+          - "'PasswordAuthentication no' in (sshd_config.content | b64decode)"
+          - "(sshd_config.content | b64decode) is search('(?m)^MaxAuthTries 4$')"
+          - "(sshd_config.content | b64decode) is search('(?m)^LoginGraceTime 30$')"
+
+    - name: Gather service and package facts
+      ansible.builtin.service_facts:
+
+    - name: Gather package facts
+      ansible.builtin.package_facts:
+
+    - name: Confirm openssh-server is installed
+      ansible.builtin.assert:
+        that: "'openssh-server' in ansible_facts.packages"
+
+    - name: Confirm the OS-specific service exists
+      ansible.builtin.assert:
+        that:
+          - (ansible_facts['os_family'] == 'RedHat' and 'sshd.service' in ansible_facts.services)
+            or (ansible_facts['os_family'] == 'Debian' and 'ssh.service' in ansible_facts.services)
diff --git a/tasks/main.yml b/tasks/main.yml
index bcfcc45..ca6483a 100644
--- a/tasks/main.yml
+++ b/tasks/main.yml
@@ -1,7 +1,10 @@
 ---
+- name: Load OS-family specific variables
+  ansible.builtin.include_vars: "{{ ansible_facts['os_family'] }}.yml"
+
 - name: Install the openssh server package
   ansible.builtin.package:
-    name: openssh-server
+    name: "{{ sshd_package_name }}"
     state: present
 
 - name: Set the sshd port
@@ -30,3 +33,21 @@
     validate: /usr/sbin/sshd -T -f %s
     mode: "0600"
   notify: Restart sshd
+
+- name: Set maximum authentication attempts
+  ansible.builtin.lineinfile:
+    path: "{{ sshd_config_path }}"
+    regexp: "^#?MaxAuthTries"
+    line: "MaxAuthTries {{ sshd_max_auth_tries }}"
+    validate: /usr/sbin/sshd -T -f %s
+    mode: "0600"
+  notify: Restart sshd
+
+- name: Set login grace time
+  ansible.builtin.lineinfile:
+    path: "{{ sshd_config_path }}"
+    regexp: "^#?LoginGraceTime"
+    line: "LoginGraceTime {{ sshd_login_grace_time }}"
+    validate: /usr/sbin/sshd -T -f %s
+    mode: "0600"
+  notify: Restart sshd
