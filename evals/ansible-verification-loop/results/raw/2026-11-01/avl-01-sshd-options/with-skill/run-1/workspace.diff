diff --git a/meta/argument_specs.yml b/meta/argument_specs.yml
new file mode 100644
index 0000000..8b9eed3
--- /dev/null
+++ b/meta/argument_specs.yml
@@ -0,0 +1,33 @@
+---
+argument_specs:
+  main:
+    short_description: Applies a hardened sshd configuration.
+    options:
+      sshd_port:
+        type: int
+        default: 22
+        description: Port sshd listens on.
+      sshd_permit_root_login:
+        type: str
+        default: "no"
+        description: Value for PermitRootLogin.
+      sshd_password_authentication:
+        type: str
+        default: "no"
+        description: Value for PasswordAuthentication.
+      sshd_max_auth_tries:
+        type: int
+        default: 4
+        description: >-
+          Value for MaxAuthTries, the number of authentication attempts
+          allowed per connection.
+      sshd_login_grace_time:
+        type: int
+        default: 30
+        description: >-
+          Value for LoginGraceTime in seconds, the time a client has to
+          authenticate before the connection is closed.
+      sshd_config_path:
+        type: path
+        default: /etc/ssh/sshd_config
+        description: Path to the sshd configuration file.
