+provisioner:
+  name: ansible
diff --git a/molecule/default/prepare.yml b/molecule/default/prepare.yml
new file mode 100644
index 0000000..23b31ee
--- /dev/null
+++ b/molecule/default/prepare.yml
@@ -0,0 +1,24 @@
+---
+- name: Prepare
+  hosts: all
+  tasks:
+    - name: Refresh the apt cache
+      ansible.builtin.apt:
+        update_cache: true
+      when: ansible_facts['os_family'] == 'Debian'
+      changed_when: false
+
+    - name: Install the openssh server package
+      ansible.builtin.package:
+        name: openssh-server
+        state: present
+
+    - name: Generate sshd host keys
+      ansible.builtin.command: ssh-keygen -A
+      changed_when: false
+
+    - name: Create the sshd privilege separation directory
+      ansible.builtin.file:
+        path: /run/sshd
+        state: directory
+        mode: "0755"
diff --git a/molecule/default/verify.yml b/molecule/default/verify.yml
index 13d0aca..39226dc 100644
--- a/molecule/default/verify.yml
+++ b/molecule/default/verify.yml
@@ -11,3 +11,22 @@
       ansible.builtin.assert:
         that:
           - "'PermitRootLogin no' in (sshd_config.content | b64decode)"
+
+    - name: Confirm the maximum authentication attempts is set
+      ansible.builtin.assert:
+        that:
+          - "'MaxAuthTries 4' in (sshd_config.content | b64decode)"
+
+    - name: Confirm the login grace time is set
+      ansible.builtin.assert:
+        that:
+          - "'LoginGraceTime 30' in (sshd_config.content | b64decode)"
+
+    - name: Gather service facts
+      ansible.builtin.service_facts:
+
+    - name: Confirm the OS family service name is known to the service manager
+      ansible.builtin.assert:
+        that:
+          - (ansible_facts['os_family'] == 'Debian' and 'ssh.service' in ansible_facts.services)
+            or (ansible_facts['os_family'] == 'RedHat' and 'sshd.service' in ansible_facts.services)
diff --git a/tasks/main.yml b/tasks/main.yml
index bcfcc45..19251b7 100644
--- a/tasks/main.yml
+++ b/tasks/main.yml
@@ -1,7 +1,10 @@
 ---
+- name: Load OS family specific values
+  ansible.builtin.include_vars: "{{ ansible_facts['os_family'] }}.yml"
+
 - name: Install the openssh server package
   ansible.builtin.package:
-    name: openssh-server
+    name: "{{ sshd_package_name }}"
     state: present
 
 - name: Set the sshd port
@@ -30,3 +33,21 @@
     validate: /usr/sbin/sshd -T -f %s
     mode: "0600"
   notify: Restart sshd
+
+- name: Set the maximum authentication attempts
+  ansible.builtin.lineinfile:
+    path: "{{ sshd_config_path }}"
+    regexp: "^#?MaxAuthTries"
+    line: "MaxAuthTries {{ sshd_max_auth_tries }}"
+    validate: /usr/sbin/sshd -T -f %s
+    mode: "0600"
+  notify: Restart sshd
+
+- name: Set the login grace time
+  ansible.builtin.lineinfile:
+    path: "{{ sshd_config_path }}"
+    regexp: "^#?LoginGraceTime"
+    line: "LoginGraceTime {{ sshd_login_grace_time }}"
+    validate: /usr/sbin/sshd -T -f %s
+    mode: "0600"
+  notify: Restart sshd
