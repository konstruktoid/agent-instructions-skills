diff --git a/molecule/default/molecule.yml b/molecule/default/molecule.yml
new file mode 100644
index 0000000..c931b7d
--- /dev/null
+++ b/molecule/default/molecule.yml
@@ -0,0 +1,26 @@
+---
+driver:
+  name: docker
+platforms:
+  - name: debian12
+    image: geerlingguy/docker-debian12-ansible:latest
+    command: ""
+    privileged: true
+    cgroupns_mode: host
+    volumes:
+      - /sys/fs/cgroup:/sys/fs/cgroup:rw
+    pre_build_image: true
+  - name: rocky9
+    image: geerlingguy/docker-rockylinux9-ansible:latest
+    command: ""
+    privileged: true
+    cgroupns_mode: host
+    volumes:
+      - /sys/fs/cgroup:/sys/fs/cgroup:rw
+    pre_build_image: true
+provisioner:
+  name: ansible
+  env:
+    ANSIBLE_ROLES_PATH: "${MOLECULE_PROJECT_DIRECTORY}/.."
+verifier:
+  name: ansible
diff --git a/molecule/default/verify.yml b/molecule/default/verify.yml
index 13d0aca..1e8a083 100644
--- a/molecule/default/verify.yml
+++ b/molecule/default/verify.yml
@@ -11,3 +11,23 @@
       ansible.builtin.assert:
         that:
           - "'PermitRootLogin no' in (sshd_config.content | b64decode)"
+
+    - name: Confirm maximum authentication attempts is set
+      ansible.builtin.assert:
+        that:
+          - "'MaxAuthTries 4' in (sshd_config.content | b64decode)"
+
+    - name: Confirm login grace time is set
+      ansible.builtin.assert:
+        that:
+          - "'LoginGraceTime 30' in (sshd_config.content | b64decode)"
+
+    - name: Gather service facts
+      ansible.builtin.service_facts:
+
+    - name: Confirm the OS family specific sshd service exists
+      ansible.builtin.assert:
+        that:
+          - (sshd_service ~ '.service') in ansible_facts.services
+      vars:
+        sshd_service: "{{ 'sshd' if ansible_facts['os_family'] == 'RedHat' else 'ssh' }}"
diff --git a/tasks/main.yml b/tasks/main.yml
index bcfcc45..7878d68 100644
--- a/tasks/main.yml
+++ b/tasks/main.yml
@@ -1,7 +1,10 @@
 ---
+- name: Load OS family specific variables
+  ansible.builtin.include_vars: "{{ ansible_facts['os_family'] }}.yml"
+
 - name: Install the openssh server package
   ansible.builtin.package:
-    name: openssh-server
+    name: "{{ sshd_package }}"
     state: present
 
 - name: Set the sshd port
@@ -30,3 +33,21 @@
     validate: /usr/sbin/sshd -T -f %s
     mode: "0600"
   notify: Restart sshd
+
+- name: Set maximum authentication attempts
+  ansible.builtin.lineinfile:
+    path: "{{ sshd_config_path }}"
+    regexp: "^#?MaxAuthTries"
+    line: "MaxAuthTries {{ sshd_max_auth_tries }}"
+    validate: /usr/sbin/sshd -T -f %s
+    mode: "0600"
+  notify: Restart sshd
+
+- name: Set login grace time
+  ansible.builtin.lineinfile:
+    path: "{{ sshd_config_path }}"
+    regexp: "^#?LoginGraceTime"
+    line: "LoginGraceTime {{ sshd_login_grace_time }}"
+    validate: /usr/sbin/sshd -T -f %s
+    mode: "0600"
+  notify: Restart sshd
