diff --git a/meta/argument_specs.yml b/meta/argument_specs.yml
new file mode 100644
index 0000000..5b45fe0
--- /dev/null
+++ b/meta/argument_specs.yml
@@ -0,0 +1,29 @@
+---
+argument_specs:
+  main:
+    short_description: Applies a hardened sshd configuration.
+    options:
+      sshd_port:
+        type: int
+        default: 22
+        description: Port sshd listens on.
+      sshd_permit_root_login:
+        type: str
+        default: "no"
+        description: Value written to the PermitRootLogin option.
+      sshd_password_authentication:
+        type: str
+        default: "no"
+        description: Value written to the PasswordAuthentication option.
+      sshd_max_auth_tries:
+        type: int
+        default: 4
+        description: Value written to the MaxAuthTries option.
+      sshd_login_grace_time:
+        type: int
+        default: 30
+        description: Value in seconds written to the LoginGraceTime option.
+      sshd_config_path:
+        type: path
+        default: /etc/ssh/sshd_config
+        description: Path to the sshd configuration file.
