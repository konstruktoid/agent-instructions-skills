+# Molecule managed
+
+FROM {{ item.image }}
+
+RUN if [ $(command -v apt-get) ]; then export DEBIAN_FRONTEND=noninteractive && apt-get update && apt-get install -y python3 sudo bash ca-certificates iproute2 python3-apt aptitude rsync systemd systemd-sysv && apt-get clean && rm -rf /var/lib/apt/lists/*; fi
+
+STOPSIGNAL SIGRTMIN+3
+CMD ["/lib/systemd/systemd"]
