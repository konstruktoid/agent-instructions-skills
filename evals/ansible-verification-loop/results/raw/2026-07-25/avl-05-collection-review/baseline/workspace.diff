diff --git a/.ansible/collections/ansible_collections/platform/firewall/roles/nftables_base/tasks/main.yml b/.ansible/collections/ansible_collections/platform/firewall/roles/nftables_base/tasks/main.yml
new file mode 100644
index 0000000..d01bb24
--- /dev/null
+++ b/.ansible/collections/ansible_collections/platform/firewall/roles/nftables_base/tasks/main.yml
@@ -0,0 +1,31 @@
+---
+- name: Install nftables
+  ansible.builtin.package:
+    name: nftables
+    state: present
+    update_cache: true
+
+- name: Write the ruleset
+  ansible.builtin.copy:
+    content: |
+      table inet filter {
+        chain input {
+          type filter hook input priority 0; policy {{ nftables_base_default_policy }};
+      {% for port in nftables_base_allowed_tcp_ports %}
+          tcp dport {{ port }} accept
+      {% endfor %}
+        }
+      }
+    dest: "{{ nftables_base_ruleset_path }}"
+    mode: "0644"
+  notify: Reload nftables
+
+- name: Apply pending handlers
+  ansible.builtin.meta: flush_handlers
+
+- name: Check the active ruleset
+  ansible.builtin.shell:
+    cmd: set -o pipefail && nft list ruleset | wc -l
+    executable: /bin/bash
+  register: nftables_base_rule_lines
+  changed_when: false
