@@ -4,12 +4,21 @@
     name: certbot
     state: present
 
-- shell: certbot certificates | grep -c "VALID"
+- name: Count valid certificates
+  ansible.builtin.shell:
+    cmd: set -o pipefail && certbot certificates | grep -c "VALID"
+    executable: /bin/bash
   register: certbot_valid_count
+  changed_when: false
 
 - name: Request a certificate for each domain
-  ansible.builtin.command: certbot certonly --standalone -d {{ item }} -m {{ certbot_email }} --agree-tos -n
+  ansible.builtin.command:
+    cmd: >-
+      certbot certonly --standalone -d {{ item }} -m {{ certbot_email }} --agree-tos -n
+      {{ '--staging' if certbot_staging | bool else '' }}
   loop: "{{ certbot_domains }}"
+  when: certbot_valid_count.stdout | int == 0
+  changed_when: true
   notify: Reload nginx
 
 - name: Write the renewal timer
