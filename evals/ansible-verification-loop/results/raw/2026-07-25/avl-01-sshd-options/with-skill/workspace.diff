diff --git a/tasks/main.yml b/tasks/main.yml
index bcfcc45..5a0e88f 100644
--- a/tasks/main.yml
+++ b/tasks/main.yml
@@ -1,9 +1,30 @@
 ---
+- name: Include OS-specific variables
+  ansible.builtin.include_vars: "{{ ansible_facts['os_family'] }}.yml"
+
+- name: Update the apt package cache
+  ansible.builtin.apt:
+    update_cache: true
+    cache_valid_time: 3600
+  when: ansible_facts['os_family'] == 'Debian'
+
 - name: Install the openssh server package
   ansible.builtin.package:
-    name: openssh-server
+    name: "{{ sshd_package_name }}"
     state: present
 
+- name: Generate missing sshd host keys
+  ansible.builtin.command: ssh-keygen -A
+  register: sshd_host_keys
+  changed_when: "'generating new host keys' in sshd_host_keys.stdout"
+
+- name: Ensure the sshd privilege separation directory exists
+  ansible.builtin.file:
+    path: /run/sshd
+    state: directory
+    mode: "0755"
+  when: ansible_facts['os_family'] == 'Debian'
+
 - name: Set the sshd port
   ansible.builtin.lineinfile:
     path: "{{ sshd_config_path }}"
@@ -30,3 +51,21 @@
     validate: /usr/sbin/sshd -T -f %s
     mode: "0600"
   notify: Restart sshd
+
+- name: Set maximum authentication tries
+  ansible.builtin.lineinfile:
+    path: "{{ sshd_config_path }}"
+    regexp: "^#?MaxAuthTries"
+    line: "MaxAuthTries {{ sshd_max_auth_tries }}"
+    validate: /usr/sbin/sshd -T -f %s
+    mode: "0600"
+  notify: Restart sshd
+
+- name: Set login grace time
+  ansible.builtin.lineinfile:
+    path: "{{ sshd_config_path }}"
+    regexp: "^#?LoginGraceTime"
+    line: "LoginGraceTime {{ sshd_login_grace_time }}"
+    validate: /usr/sbin/sshd -T -f %s
+    mode: "0600"
+  notify: Restart sshd
