+
+    - name: Confirm the maximum authentication tries
+      ansible.builtin.assert:
+        that:
+          - "'MaxAuthTries 4' in (sshd_config.content | b64decode)"
+
+    - name: Confirm the login grace time
+      ansible.builtin.assert:
+        that:
