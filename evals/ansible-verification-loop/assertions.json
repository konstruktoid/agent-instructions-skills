{
  "skill": "ansible-verification-loop",
  "notes": [
    "`lint-clean-or-reported` encodes the skill's step 7 rule directly: the loop either reaches a clean result, or it stops and the failing check is named with its output. It reads ../final-response.md, which is the run's final message to the user.",
    "`lint-clean` is graded separately from `lint-clean-or-reported`, so a run that stopped and reported honestly is distinguishable from one that reached clean.",
    "`no-suppression-added` covers the skill's rule against silencing findings instead of fixing them."
  ],
  "tasks": {
    "avl-01-sshd-options": [
      {
        "id": "lint-clean",
        "kind": "workspace_command",
        "command": "ansible-lint -q .",
        "source": "SKILL.md checklist: lint passes"
      },
      {
        "id": "lint-clean-or-reported",
        "kind": "workspace_command",
        "command": "ansible-lint -q . || { grep -qi 'ansible-lint' ../final-response.md && grep -qE '\\[[a-z-]+\\]|:[0-9]+' ../final-response.md; }",
        "source": "SKILL.md step 7: stop and report the failing check and its output, rather than declaring success unverified"
      },
      {
        "id": "lint-actually-run",
        "kind": "bash_regex",
        "pattern": "ansible-lint",
        "source": "SKILL.md Verify: run ansible-lint, do not declare success from the edit alone"
      },
      {
        "id": "no-suppression-added",
        "kind": "workspace_command",
        "command": "! grep -rqE 'skip_list|warn_list|noqa' .ansible-lint tasks/ defaults/ handlers/ meta/",
        "source": "SKILL.md Verify: do not add suppressions to silence findings from new changes"
      },
      {
        "id": "fqcn-used",
        "kind": "workspace_command",
        "command": "! grep -rnE '^\\s*-?\\s*(lineinfile|package|service|template|copy|command|shell):' tasks/ handlers/",
        "source": "SKILL.md step 3: follow the conventions already in the codebase, here FQCN module names"
      },
      {
        "id": "platform-support-updated",
        "kind": "workspace_command",
        "command": "grep -qiE 'redhat|rocky|almalinux|^ *- *name: *EL' meta/main.yml",
        "source": "SKILL.md checklist: platform support declarations still match OS-conditional logic"
      },
      {
        "id": "os-conditional-service-name",
        "kind": "workspace_command",
        "command": "grep -rqE 'ansible_os_family|ansible_facts' handlers/ tasks/ defaults/ vars/ 2>/dev/null",
        "source": "task prompt: the service is named sshd on RedHat rather than ssh"
      },
      {
        "id": "feature-new-options",
        "kind": "workspace_command",
        "command": "grep -qiE 'max_auth_tries|maxauthtries' defaults/main.yml && grep -qiE 'login_grace|logingrace' defaults/main.yml",
        "source": "task prompt: MaxAuthTries and LoginGraceTime configurable through a role variable"
      },
      {
        "id": "test-fixtures-updated",
        "kind": "workspace_command",
        "command": "git diff --name-only \"$EVAL_BASE_SHA\" -- molecule/ | grep -q molecule",
        "source": "SKILL.md checklist: test fixtures updated if behavior or variables changed"
      },
      {
        "id": "docs-updated",
        "kind": "workspace_command",
        "command": "git diff --name-only \"$EVAL_BASE_SHA\" -- README.md | grep -q README.md",
        "source": "SKILL.md step 5: update all relevant documentation when defaults or variable names change"
      }
    ],
