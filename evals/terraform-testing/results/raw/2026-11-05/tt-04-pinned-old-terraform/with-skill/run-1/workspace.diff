@@ -0,0 +1,32 @@
+#!/usr/bin/env bash
+# Plan-and-assert check for the full_name output. Runs on Terraform 1.3 and later.
+set -euo pipefail
+
+root=$(cd "$(dirname "$0")/.." && pwd)
+work=$(mktemp -d)
+trap 'rm -rf "$work"' EXIT
+
+planned_full_name() {
+  terraform -chdir="$root" plan -input=false -lock=false -refresh=false \
+    -var "team=$1" -var "name=$2" -out="$work/plan.bin" >/dev/null
+  terraform -chdir="$root" show -json "$work/plan.bin" |
+    jq -r '.planned_values.outputs.full_name.value'
+}
+
+assert_eq() {
+  if [ "$1" != "$2" ]; then
+    echo "FAIL: $3: expected '$2', got '$1'" >&2
+    exit 1
+  fi
+  echo "ok: $3"
+}
+
+assert_eq "$(planned_full_name platform web)" "platform-web" "joins team and name with a hyphen"
+assert_eq "$(planned_full_name a-b c-d)" "a-b-c-d" "keeps hyphens already present in the inputs"
+
+# Failure path: a missing input must stop the plan rather than yield a partial name.
+if terraform -chdir="$root" plan -input=false -lock=false -var "team=platform" >/dev/null 2>&1; then
+  echo "FAIL: plan succeeded without a name" >&2
+  exit 1
+fi
+echo "ok: plan fails when name is missing"
