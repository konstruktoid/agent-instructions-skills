@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+# Plan-only check (Terraform 1.5.7 has no `terraform test`): asserts the planned
+# full_name output. Creates nothing; the plan file lives in a temp dir.
+set -euo pipefail
+
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+
+assert_full_name() {
+  local team=$1 name=$2 want=$3 got
+  terraform plan -input=false -out="$tmp/plan" -var "team=$team" -var "name=$name" >/dev/null
+  got=$(terraform show -json "$tmp/plan" | jq -r '.planned_values.outputs.full_name.value')
+  if [ "$got" != "$want" ]; then
+    echo "FAIL: team=$team name=$name: full_name=$got, want $want" >&2
+    exit 1
+  fi
+  echo "ok: team=$team name=$name -> $got"
+}
+
+assert_full_name platform web platform-web
+assert_full_name a b-c a-b-c
