diff --git a/Makefile b/Makefile
index 0ca016a..658b701 100644
--- a/Makefile
+++ b/Makefile
@@ -1,5 +1,11 @@
+STATE := .terraform/check.tfstate
+
 .PHONY: check
 check:
 	terraform init -backend=false -input=false
 	terraform fmt -check -recursive
 	terraform validate
+	# Behavioural check (`terraform test` needs >= 1.6; CI pins 1.5.7, module supports 1.3+).
+	terraform apply -auto-approve -input=false -state=$(STATE) -var team=alpha -var name=web >/dev/null
+	@got=$$(terraform output -state=$(STATE) -raw full_name); \
+	[ "$$got" = "alpha-web" ] || { echo "full_name check failed: got '$$got'"; exit 1; }
