diff --git a/tests/full_name/main.tf b/tests/full_name/main.tf
new file mode 100644
index 0000000..08d66f1
--- /dev/null
+++ b/tests/full_name/main.tf
@@ -0,0 +1,15 @@
+# Plan-time check (works on Terraform 1.5.7; `terraform test` needs 1.6+).
+module "subject" {
+  source = "../.."
+  team   = "platform"
+  name   = "db"
+}
+
+resource "terraform_data" "assert_full_name" {
+  lifecycle {
+    precondition {
+      condition     = module.subject.full_name == "platform-db"
+      error_message = "full_name should be team and name joined by a hyphen, got ${module.subject.full_name}."
+    }
+  }
+}
