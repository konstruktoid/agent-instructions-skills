diff --git a/main.tf b/main.tf
index 2899c45..99afde5 100644
--- a/main.tf
+++ b/main.tf
@@ -1,3 +1,9 @@
 resource "terraform_data" "service" {
   input = var.name
 }
+
+resource "terraform_data" "audit" {
+  count = var.enable_audit ? 1 : 0
+
+  input = var.name
+}
diff --git a/outputs.tf b/outputs.tf
index 2930f48..6475018 100644
--- a/outputs.tf
+++ b/outputs.tf
@@ -2,3 +2,8 @@ output "service_id" {
   description = "Identifier of the service record."
   value       = terraform_data.service.id
 }
+
+output "audit_enabled" {
+  description = "Whether the audit record was created."
+  value       = length(terraform_data.audit) > 0
+}
diff --git a/variables.tf b/variables.tf
index e642132..985b1b2 100644
--- a/variables.tf
+++ b/variables.tf
@@ -2,3 +2,9 @@ variable "name" {
   description = "Name of the service."
   type        = string
 }
+
+variable "enable_audit" {
+  description = "Whether to create the optional audit record."
+  type        = bool
+  default     = false
+}
