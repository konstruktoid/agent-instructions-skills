diff --git a/test/test_mkbackup_exclude.sh b/test/test_mkbackup_exclude.sh
new file mode 100644
index 0000000..4135bc2
--- /dev/null
+++ b/test/test_mkbackup_exclude.sh
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+# Regression: --exclude=PATTERN and --exclude PATTERN must behave the same.
+
+set -uo pipefail
+
+TEST_NAME='mkbackup exclude'
+# shellcheck source=test/helpers.sh
+source "$(dirname "${BASH_SOURCE[0]}")/helpers.sh"
+
+workdir="$(mktemp -d)"
+trap 'rm -rf -- "${workdir}"' EXIT
+
+make_tree "${workdir}/src"
+
+"${REPO_ROOT}/bin/mkbackup.sh" --exclude skipme "${workdir}/src" "${workdir}/space.tar.gz"
+assert_status 0 $?
+"${REPO_ROOT}/bin/mkbackup.sh" --exclude=skipme "${workdir}/src" "${workdir}/equals.tar.gz"
+assert_status 0 $?
+
+for name in space equals; do
+  contents="$(tar --list --file "${workdir}/${name}.tar.gz")"
+  assert_contains "${contents}" 'keepme/file.txt'
+  [[ ${contents} == *skipme* ]] && fail "--exclude (${name} form) left skipme in the archive"
+done
+
+"${REPO_ROOT}/bin/mkbackup.sh" --exclude > /dev/null 2>&1
+assert_status 64 $?
+
+printf 'PASS %s\n' "${TEST_NAME}"
