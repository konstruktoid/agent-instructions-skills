diff --git a/test/test_mkbackup_exclude.sh b/test/test_mkbackup_exclude.sh
new file mode 100644
index 0000000..afe3002
--- /dev/null
+++ b/test/test_mkbackup_exclude.sh
@@ -0,0 +1,35 @@
+#!/usr/bin/env bash
+# --exclude PATTERN and --exclude=PATTERN must behave identically.
+
+set -uo pipefail
+
+TEST_NAME='mkbackup exclude spellings'
+# shellcheck source=test/helpers.sh
+source "$(dirname "${BASH_SOURCE[0]}")/helpers.sh"
+
+workdir="$(mktemp -d)"
+trap 'rm -rf -- "${workdir}"' EXIT
+
+make_tree "${workdir}/my src"
+
+check_excluded() {
+  local label="$1"
+  shift
+  local archive="${workdir}/${label}.tar.gz"
+  "${REPO_ROOT}/bin/mkbackup.sh" "$@" "${workdir}/my src" "${archive}"
+  assert_status 0 $?
+  local contents
+  contents="$(tar --list --file "${archive}")"
+  assert_contains "${contents}" 'keepme/file.txt'
+  [[ ${contents} == *skipme* ]] && fail "${label}: excluded directory is present in the archive"
+  return 0
+}
+
+check_excluded separate --exclude skipme
+check_excluded equals --exclude=skipme
+
+# An empty value after = excludes nothing and must not fail.
+"${REPO_ROOT}/bin/mkbackup.sh" --exclude= "${workdir}/my src" "${workdir}/empty.tar.gz"
+assert_status 0 $?
+
+printf 'PASS %s\n' "${TEST_NAME}"
