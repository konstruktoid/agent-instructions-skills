diff --git a/bin/report.sh b/bin/report.sh
index caf882c..d3f94d7 100755
--- a/bin/report.sh
+++ b/bin/report.sh
@@ -4,10 +4,17 @@
 set -euo pipefail
 
 main() {
-  local file="${1:-}"
+  local file="" json=0 arg
+
+  for arg in "$@"; do
+    case "${arg}" in
+      --json) json=1 ;;
+      *) [[ -z ${file} ]] && file="${arg}" ;;
+    esac
+  done
 
   if [[ -z ${file} ]]; then
-    printf 'usage: %s FILE\n' "${0##*/}" >&2
+    printf 'usage: %s [--json] FILE\n' "${0##*/}" >&2
     return 64
   fi
 
@@ -30,7 +37,11 @@ main() {
     esac
   done < "${file}"
 
-  printf 'total=%d passed=%d failed=%d\n' "${total}" "${passed}" "${failed}"
+  if ((json)); then
+    printf '{"total":%d,"passed":%d,"failed":%d}\n' "${total}" "${passed}" "${failed}"
+  else
+    printf 'total=%d passed=%d failed=%d\n' "${total}" "${passed}" "${failed}"
+  fi
 }
 
 main "$@"
diff --git a/test/report.bats b/test/report.bats
index 9e835a5..1f568a2 100755
--- a/test/report.bats
+++ b/test/report.bats
@@ -1,5 +1,6 @@
 #!/usr/bin/env bats
 
+bats_require_minimum_version 1.5.0
 load test_helper
 
 @test "summarizes a mixed result file" {
@@ -17,3 +18,35 @@ load test_helper
   run "${REPO_ROOT}/bin/report.sh" "${REPO_ROOT}/data/absent.csv"
   [ "$status" -eq 66 ]
 }
+
+@test "--json prints the counters as JSON" {
+  run "${REPO_ROOT}/bin/report.sh" --json "${REPO_ROOT}/data/sample.csv"
+  [ "$status" -eq 0 ]
+  [ "$output" = '{"total":3,"passed":2,"failed":1}' ]
+}
+
+@test "--json is accepted after the file" {
+  run "${REPO_ROOT}/bin/report.sh" "${REPO_ROOT}/data/sample.csv" --json
+  [ "$status" -eq 0 ]
+  [ "$output" = '{"total":3,"passed":2,"failed":1}' ]
+}
+
+@test "--json works on a path containing a space" {
+  local dir="${BATS_TEST_TMPDIR}/with space"
+  mkdir -p "${dir}"
+  printf 'job,status,duration\na,pass,1\n' > "${dir}/r.csv"
+  run "${REPO_ROOT}/bin/report.sh" --json "${dir}/r.csv"
+  [ "$status" -eq 0 ]
+  [ "$output" = '{"total":1,"passed":1,"failed":0}' ]
+}
+
+@test "--json without a file reports usage" {
+  run "${REPO_ROOT}/bin/report.sh" --json
+  [ "$status" -eq 64 ]
+}
+
+@test "--json with a missing file keeps JSON off stdout" {
+  run --separate-stderr "${REPO_ROOT}/bin/report.sh" --json "${REPO_ROOT}/data/absent.csv"
+  [ "$status" -eq 66 ]
+  [ -z "$output" ]
+}
