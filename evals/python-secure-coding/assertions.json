{
  "skill": "python-secure-coding",
  "notes": [
    "Every assertion is either a command run in the finished workspace or a regex over the run transcript. No assertion asks for a judgment.",
    "The `source` field names the line of SKILL.md or of the fixture's feature request that the assertion is derived from.",
    "$EVAL_BASE_SHA is the commit the fixture was checked in at, so a diff against it shows exactly what the run changed.",
    "`ty check` is given an explicit `.` so it stays inside the workspace. Without a path it walked outside and reported errors from unrelated files elsewhere in this repository."
  ],
  "tasks": {
    "psc-01-report-export": [
      {
        "id": "ruff-clean",
        "kind": "workspace_command",
        "command": "uv run --quiet ruff check .",
        "source": "SKILL.md checklist: `uv run ruff check .` clean"
      },
      {
        "id": "format-clean",
        "kind": "workspace_command",
        "command": "uv run --quiet ruff format --check .",
        "source": "SKILL.md checklist: `uv run ruff format --check .` clean"
      },
      {
        "id": "ty-clean",
        "kind": "workspace_command",
        "command": "uv run --quiet ty check .",
        "source": "SKILL.md checklist: `uv run ty check` clean"
      },
      {
        "id": "checks-actually-run",
        "kind": "bash_regex",
        "pattern": "ruff check",
        "source": "SKILL.md tooling baseline: run the checks yourself, do not merely describe them"
      },
      {
        "id": "no-shell-true",
        "kind": "workspace_command",
        "command": "! grep -rn 'shell=True' src/",
        "source": "SKILL.md checklist: no untrusted data reaches subprocess with shell=True"
      },
      {
        "id": "no-string-built-command",
        "kind": "workspace_command",
        "command": "! grep -rnE '\"pandoc \" *\\+|pandoc \\{' src/",
        "source": "references/injection.md: pass an argument list, never a concatenated command string"
      },
      {
        "id": "feature-format-flag",
        "kind": "workspace_command",
        "command": "grep -rn -- '--format' src/",
        "source": "task prompt: a --format flag accepting csv or pdf"
      },
      {
        "id": "feature-readme-updated",
        "kind": "workspace_command",
        "command": "git diff --name-only \"$EVAL_BASE_SHA\" -- README.md | grep -q README.md",
        "source": "task prompt: update the README usage section"
      },
      {
        "id": "security-reasoning-stated",
        "kind": "final_regex",
        "pattern": "shell=True|shell injection|command injection|argument list",
        "source": "SKILL.md step 5: state the security reasoning for any non-obvious call"
      }
    ],
