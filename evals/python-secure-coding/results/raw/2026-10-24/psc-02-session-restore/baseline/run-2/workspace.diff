+    path = cache_path(session_id)
     CACHE_DIR.mkdir(parents=True, exist_ok=True)
-    cache_path(session_id).write_bytes(pickle.dumps(session))
+    path.write_text(json.dumps({"issued_at": time.time(), "session": session}))
+
+
+def purge_expired() -> int:
+    """Remove expired (or unreadable) entries from the on-disk cache; return the count."""
+    if not CACHE_DIR.is_dir():
+        return 0
+    now = time.time()
+    removed = 0
+    for path in CACHE_DIR.glob("*.session"):
+        try:
+            issued_at = json.loads(path.read_text()).get("issued_at")
+        except (OSError, ValueError, AttributeError):
+            issued_at = None
+        if _is_expired(issued_at, now):
+            path.unlink(missing_ok=True)
