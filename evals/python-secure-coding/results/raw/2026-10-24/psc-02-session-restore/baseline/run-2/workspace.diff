+    """Restore a session from the base64 resume blob a client sent.
+
+    The blob is base64-encoded JSON: {"issued_at": <unix seconds>, "session": {...}}.
+    Raises SessionExpiredError if the session is older than SESSION_TTL.
+    """
+    purge_expired()
+    data = json.loads(base64.b64decode(blob))
+    if not isinstance(data, dict) or not isinstance(data.get("session"), dict):
+        raise ValueError("malformed session blob")
+    if _is_expired(data.get("issued_at"), time.time()):
