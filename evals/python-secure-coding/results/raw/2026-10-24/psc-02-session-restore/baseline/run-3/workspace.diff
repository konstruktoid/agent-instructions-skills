+class InvalidSession(ValueError):
+    """The resume blob is malformed, forged, or expired."""
+
+
+def _secret() -> bytes:
+    key = os.environ.get("SESSIONSVC_SECRET")
+    if not key:
+        raise RuntimeError("SESSIONSVC_SECRET must be set")
+    return key.encode()
+
+
+def _sign(payload: bytes) -> bytes:
+    return hmac.new(_secret(), payload, hashlib.sha256).digest()
+
+
+def make_blob(session: dict) -> str:
+    """Build a signed resume blob for a session, stamping issued_at."""
+    payload = json.dumps({**session, "issued_at": time.time()}).encode()
+    return base64.b64encode(payload + _sign(payload)).decode()
+
+
+def _is_expired(issued_at: object, now: float) -> bool:
+    if isinstance(issued_at, bool) or not isinstance(issued_at, (int, float)):
+        return True
+    return now - issued_at > SESSION_TTL or issued_at > now + 60
 
 
