index 7d34165..1a3b7ce 100644
--- a/src/auditlog/filters.py
+++ b/src/auditlog/filters.py
@@ -3,17 +3,21 @@
 DEFAULT_SORT = "ts"
 DEFAULT_DIRECTION = "desc"
 
-
-def quote_literal(value: str) -> str:
-    """Return a value as a SQL string literal.
-
-    Embedded single quotes are doubled, which is how SQLite escapes a quote
-    inside a literal, so a value containing an apostrophe does not end the
-    literal early.
-    """
-    return "'" + value.replace("'", "''") + "'"
+SORT_COLUMNS = ("id", "actor", "action", "target", "ts")
+DIRECTIONS = ("asc", "desc")
 
 
 def order_clause(sort: str, direction: str) -> str:
-    """Return an ORDER BY clause for a column name and a direction."""
-    return f" ORDER BY {sort} {direction}"
+    """Return an ORDER BY clause for a column name and a direction.
+
+    Identifiers cannot be bound as parameters, so both values are checked against
+    allowlists. The id column breaks ties so pagination is stable.
+    """
+    if sort not in SORT_COLUMNS:
+        msg = f"sort must be one of {', '.join(SORT_COLUMNS)}"
+        raise ValueError(msg)
+    direction = direction.lower()
+    if direction not in DIRECTIONS:
+        msg = f"direction must be one of {', '.join(DIRECTIONS)}"
+        raise ValueError(msg)
+    return f" ORDER BY {sort} {direction}, id {direction}"
