@@ -1,5 +1,7 @@
 """Clause builders shared by the audit log queries."""
 
+COLUMNS = ("id", "actor", "action", "target", "ts")
+DIRECTIONS = ("asc", "desc")
 DEFAULT_SORT = "ts"
 DEFAULT_DIRECTION = "desc"
 
@@ -15,5 +17,13 @@ def quote_literal(value: str) -> str:
 
 
 def order_clause(sort: str, direction: str) -> str:
-    """Return an ORDER BY clause for a column name and a direction."""
-    return f" ORDER BY {sort} {direction}"
+    """Return an ORDER BY clause for an audit column and a direction.
+
+    Identifiers cannot be bound as parameters, so both values are checked
+    against fixed allowlists and anything else is rejected.
+    """
+    if sort not in COLUMNS:
+        raise ValueError(f"unknown sort column: {sort!r}; expected one of {', '.join(COLUMNS)}")
+    if direction.lower() not in DIRECTIONS:
+        raise ValueError(f"unknown direction: {direction!r}; expected asc or desc")
+    return f" ORDER BY {sort} {direction.lower()}, id {direction.lower()}"
