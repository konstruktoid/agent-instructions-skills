 logger = logging.getLogger(__name__)
 
+REQUEST_TIMEOUT_SECONDS = 5
+MAX_RETRIES = 3
+BACKOFF_BASE_SECONDS = 1.0
+ALLOWED_SCHEMES = ("http", "https")
