 SIGNING_TOKEN = "whsec_9f2c41ab7de84c0195aa63d0b7e21f88"
 
 
+@dataclass
+class Attempt:
+    """One request made while delivering a webhook."""
+
+    number: int
+    status: int | None
+    error: str | None
+
+
+@dataclass
+class DeliveryResult:
+    """Outcome of a delivery, with every attempt made."""
+
+    attempts: list[Attempt] = field(default_factory=list)
+
+    @property
+    def status(self) -> int | None:
+        """Status code of the last attempt, or None if it never got a response."""
+        return self.attempts[-1].status if self.attempts else None
+
+    @property
+    def delivered(self) -> bool:
+        """True if the last attempt got a 2xx response."""
+        return self.status is not None and 200 <= self.status < 300
+
