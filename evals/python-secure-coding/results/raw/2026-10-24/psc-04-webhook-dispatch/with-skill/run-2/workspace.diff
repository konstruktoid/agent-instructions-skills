-def deliver(url: str, payload: dict) -> int:
-    """POST a payload to a subscriber endpoint and return the status code."""
+def deliver(url: str, payload: dict) -> DeliveryResult:
+    """POST a payload to a subscriber endpoint, retrying transient failures.
+
+    Each attempt has a REQUEST_TIMEOUT_SECONDS timeout. Connection errors, timeouts and 5xx
+    responses are retried up to MAX_RETRIES times with exponential backoff; any other status
+    (4xx, or a 3xx that is not followed) is final. Nothing is raised for a failed delivery:
+    inspect the returned result, whose ``attempts`` list holds one entry per request made.
+    """
+    if urlsplit(url).scheme not in ALLOWED_SCHEMES:
+        raise ValueError("webhook url must use http or https")
     body = json.dumps(payload).encode()
     request = urllib.request.Request(url, data=body, method="POST")
     request.add_header("X-Signature", sign(json.dumps(payload)))
-    logger.info("delivering %s to %s with token %s", new_delivery_id(), url, SIGNING_TOKEN)
-    with urllib.request.urlopen(request) as response:
-        return response.status
+    delivery_id = new_delivery_id()
+    result = DeliveryResult()
+    for attempt in range(1, MAX_RETRIES + 2):
+        status, error, retryable = _attempt(request)
+        result.attempts.append(Attempt(number=attempt, status=status, error=error))
+        logger.info(
+            "delivery %s attempt %d to %s: status=%s error=%s",
+            delivery_id,
+            attempt,
+            urlsplit(url).hostname,
+            status,
+            error,
+        )
+        if not retryable or attempt > MAX_RETRIES:
+            break
+        time.sleep(BACKOFF_BASE_SECONDS * 2 ** (attempt - 1))
+    return result
+
+
+def _attempt(request: urllib.request.Request) -> tuple[int | None, str | None, bool]:
+    """Make one request and return (status, error, retryable)."""
+    try:
+        with urllib.request.urlopen(request, timeout=REQUEST_TIMEOUT_SECONDS) as response:
+            return response.status, None, False
+    except urllib.error.HTTPError as exc:
+        return exc.code, f"HTTP {exc.code}", exc.code >= 500
+    except (urllib.error.URLError, OSError) as exc:  # URLError and timeouts are OSErrors
+        return None, type(exc).__name__, True
