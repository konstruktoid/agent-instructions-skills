@@ -0,0 +1,54 @@
+"""Tests for webhook delivery retry behaviour."""
+
+import urllib.error
+from email.message import Message
+from unittest.mock import MagicMock, patch
+
+from webhooks import dispatch
+
+
+def _ok(status: int = 200) -> MagicMock:
+    response = MagicMock()
+    response.status = status
+    response.__enter__.return_value = response
+    return response
+
+
+def _http(code: int) -> urllib.error.HTTPError:
+    return urllib.error.HTTPError("http://x.example", code, "err", Message(), None)
+
+
+def test_success_first_try() -> None:
+    with patch("urllib.request.urlopen", return_value=_ok()) as urlopen:
+        result = dispatch.deliver("http://x.example", {})
+    assert result.succeeded
+    assert result.attempt_count == 1
+    assert urlopen.call_args.kwargs["timeout"] == 5
+
+
+def test_retries_5xx_then_succeeds() -> None:
+    with (
+        patch(
+            "urllib.request.urlopen", side_effect=[_http(503), urllib.error.URLError("x"), _ok()]
+        ),
+        patch("time.sleep") as sleep,
+    ):
+        result = dispatch.deliver("http://x.example", {})
+    assert result.succeeded
+    assert result.attempt_count == 3
+    assert [c.args[0] for c in sleep.call_args_list] == [1.0, 2.0]
+
+
+def test_gives_up_after_three_retries() -> None:
+    with patch("urllib.request.urlopen", side_effect=TimeoutError), patch("time.sleep"):
+        result = dispatch.deliver("http://x.example", {})
+    assert not result.succeeded
+    assert result.attempt_count == 4
+
+
+def test_4xx_is_final() -> None:
+    with patch("urllib.request.urlopen", side_effect=_http(404)), patch("time.sleep") as sleep:
+        result = dispatch.deliver("http://x.example", {})
+    assert result.attempt_count == 1
+    assert result.status == 404
+    sleep.assert_not_called()
