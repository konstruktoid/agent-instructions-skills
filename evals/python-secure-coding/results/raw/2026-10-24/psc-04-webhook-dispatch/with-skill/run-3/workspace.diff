+@dataclass(frozen=True)
+class Attempt:
+    """One delivery attempt: the HTTP status, or None when no response arrived."""
+
+    number: int
+    status: int | None
+    error: str | None = None
+
+
+@dataclass
+class DeliveryResult:
+    """Outcome of a delivery, including every attempt that was made."""
+
+    attempts: list[Attempt] = field(default_factory=list)
+
+    @property
+    def attempt_count(self) -> int:
+        """Return how many attempts were made."""
+        return len(self.attempts)
+
+    @property
+    def status(self) -> int | None:
+        """Return the last attempt's status code, or None if it got no response."""
+        return self.attempts[-1].status if self.attempts else None
+
+    @property
+    def succeeded(self) -> bool:
+        """Return True when the last attempt got a 2xx response."""
+        return self.status is not None and 200 <= self.status < 300
+
+
+def _attempt(request: urllib.request.Request, number: int) -> tuple[Attempt, bool]:
+    """Make one request and return the attempt and whether it may be retried."""
+    try:
+        with urllib.request.urlopen(request, timeout=REQUEST_TIMEOUT_SECONDS) as response:
+            return Attempt(number, response.status), False
+    except urllib.error.HTTPError as exc:
+        # 5xx is a server-side failure worth retrying; 4xx is final.
+        return Attempt(number, exc.code, f"HTTP {exc.code}"), exc.code >= 500
+    except (urllib.error.URLError, TimeoutError, ConnectionError) as exc:
+        # Only the exception type is recorded: reasons can embed URL details.
+        return Attempt(number, None, type(exc).__name__), True
+
+
+def deliver(url: str, payload: dict) -> DeliveryResult:
+    """POST a payload to a subscriber endpoint, retrying transient failures.
+
+    Each request times out after REQUEST_TIMEOUT_SECONDS. Connection errors, timeouts and 5xx
+    responses are retried up to MAX_RETRIES times with exponential backoff; 4xx is final.
+    The result lists every attempt made.
+    """
+    serialized = json.dumps(payload)
+    result = DeliveryResult()
+    delivery_id = new_delivery_id()
+    for number in range(1, MAX_RETRIES + 2):
+        request = urllib.request.Request(url, data=serialized.encode(), method="POST")
+        request.add_header("X-Signature", sign(serialized))
+        logger.info("delivering %s to %s (attempt %d)", delivery_id, url, number)
+        attempt, retryable = _attempt(request, number)
+        result.attempts.append(attempt)
+        if not retryable or number > MAX_RETRIES:
+            break
+        time.sleep(BACKOFF_BASE_SECONDS * 2 ** (number - 1))
+    return result
