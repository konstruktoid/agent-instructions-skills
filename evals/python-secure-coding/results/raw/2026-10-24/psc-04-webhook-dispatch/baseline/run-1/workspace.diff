+@dataclass
+class DeliveryResult:
+    """Every attempt made for one delivery."""
+
+    attempts: list[Attempt] = field(default_factory=list)
+
+    @property
+    def status(self) -> int | None:
+        """Status code of the last attempt, or None if it got no response."""
+        return self.attempts[-1].status if self.attempts else None
+
+    @property
+    def succeeded(self) -> bool:
+        return self.status is not None and 200 <= self.status < 400
+
+
+def _attempt(request: urllib.request.Request, number: int) -> Attempt:
+    try:
+        with urllib.request.urlopen(request, timeout=REQUEST_TIMEOUT) as response:
+            return Attempt(number, status=response.status)
+    except urllib.error.HTTPError as exc:
+        return Attempt(number, status=exc.code, error=str(exc))
+    except (urllib.error.URLError, OSError) as exc:  # includes timeouts
+        return Attempt(number, error=f"{type(exc).__name__}: {exc}")
