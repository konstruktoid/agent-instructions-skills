+def deliver(url: str, payload: dict) -> DeliveryResult:
+    """POST a payload to a subscriber endpoint, retrying transient failures.
+
+    Each request times out after REQUEST_TIMEOUT seconds. Connection errors, timeouts and 5xx
+    responses are retried up to MAX_RETRIES times, sleeping BACKOFF_BASE * 2**n between tries.
+    Other responses, including 4xx, are final. Every attempt is recorded on the result.
