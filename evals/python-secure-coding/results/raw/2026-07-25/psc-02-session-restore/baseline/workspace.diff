 def read_overrides(text: str) -> dict:
@@ -26,4 +37,20 @@ def cache_path(session_id: str) -> Path:
 def save_session(session_id: str, session: dict) -> None:
     """Persist a session to the on-disk cache."""
     CACHE_DIR.mkdir(parents=True, exist_ok=True)
-    cache_path(session_id).write_bytes(pickle.dumps(session))
+    envelope = {"issued_at": time.time(), "session": session}
+    cache_path(session_id).write_bytes(pickle.dumps(envelope))
+
+
+def purge_expired() -> None:
+    """Remove expired session entries from the on-disk cache."""
+    if not CACHE_DIR.exists():
+        return
+    now = time.time()
+    for path in CACHE_DIR.glob("*.session"):
+        try:
+            envelope = pickle.loads(path.read_bytes())
+            issued_at = envelope["issued_at"]
+        except (pickle.UnpicklingError, EOFError, KeyError, TypeError, OSError):
+            continue
+        if now - issued_at > SESSION_TTL:
+            path.unlink(missing_ok=True)
