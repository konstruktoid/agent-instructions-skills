index 7d34165..2873d1f 100644
--- a/src/auditlog/filters.py
+++ b/src/auditlog/filters.py
@@ -3,17 +3,24 @@
 DEFAULT_SORT = "ts"
 DEFAULT_DIRECTION = "desc"
 
-
-def quote_literal(value: str) -> str:
-    """Return a value as a SQL string literal.
-
-    Embedded single quotes are doubled, which is how SQLite escapes a quote
-    inside a literal, so a value containing an apostrophe does not end the
-    literal early.
-    """
-    return "'" + value.replace("'", "''") + "'"
+# Identifiers cannot be bound as query parameters, so the ORDER BY column and direction are
+# checked against allowlists instead. Keep COLUMNS in step with the audit table schema.
+COLUMNS = ("id", "actor", "action", "target", "ts")
+DIRECTIONS = ("asc", "desc")
 
 
 def order_clause(sort: str, direction: str) -> str:
-    """Return an ORDER BY clause for a column name and a direction."""
-    return f" ORDER BY {sort} {direction}"
+    """Return an ORDER BY clause for an audit column and a direction.
+
+    Raises:
+        ValueError: if the column is not an audit table column or the direction is not
+            ``asc``/``desc``. Nothing outside the allowlists reaches the SQL text.
+    """
+    if sort not in COLUMNS:
+        msg = f"invalid sort column: {sort!r} (expected one of {', '.join(COLUMNS)})"
+        raise ValueError(msg)
+    normalized = direction.lower()
+    if normalized not in DIRECTIONS:
+        msg = f"invalid direction: {direction!r} (expected asc or desc)"
+        raise ValueError(msg)
+    return f" ORDER BY {sort} {normalized.upper()}, id {normalized.upper()}"
