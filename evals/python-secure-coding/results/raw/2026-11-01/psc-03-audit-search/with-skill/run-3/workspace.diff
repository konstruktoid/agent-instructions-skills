-    return "'" + value.replace("'", "''") + "'"
+def order_clause(sort: str, direction: str) -> str:
+    """Return an ORDER BY clause for a column name and a direction.
 
+    Identifiers cannot be bound as SQL parameters, so both values are checked
+    against fixed allowlists and the clause is built only from those literals.
+    ``id`` is appended as a tie-breaker so pages are stable across requests.
 
-def order_clause(sort: str, direction: str) -> str:
-    """Return an ORDER BY clause for a column name and a direction."""
-    return f" ORDER BY {sort} {direction}"
+    Raises:
+        ValueError: If ``sort`` is not an audit column or ``direction`` is not asc/desc.
+    """
+    column = sort.lower()
+    way = direction.lower()
+    if column not in COLUMNS:
+        msg = f"unknown sort column: {sort!r}; expected one of {', '.join(COLUMNS)}"
+        raise ValueError(msg)
+    if way not in DIRECTIONS:
+        msg = f"unknown direction: {direction!r}; expected asc or desc"
+        raise ValueError(msg)
+    return f" ORDER BY {column} {way}, id {way}"
