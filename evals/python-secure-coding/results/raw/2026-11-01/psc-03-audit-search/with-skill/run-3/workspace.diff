+def bounded_int(minimum: int, maximum: int | None = None) -> Callable[[str], int]:
+    """Build an argparse type for an integer within [minimum, maximum]."""
+
+    def parse(value: str) -> int:
+        try:
+            number = int(value)
+        except ValueError:
+            msg = f"not an integer: {value!r}"
+            raise argparse.ArgumentTypeError(msg) from None
+        if number < minimum or (maximum is not None and number > maximum):
+            msg = f"must be >= {minimum}" + (f" and <= {maximum}" if maximum else "")
+            raise argparse.ArgumentTypeError(msg)
+        return number
