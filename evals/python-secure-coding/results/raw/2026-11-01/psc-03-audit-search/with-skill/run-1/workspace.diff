-    return f" ORDER BY {sort} {direction}"
+def validate_page(limit: int, offset: int) -> None:
+    """Reject a limit or offset outside the supported range."""
+    if not 1 <= limit <= MAX_LIMIT:
+        msg = f"limit must be between 1 and {MAX_LIMIT}"
+        raise ValueError(msg)
+    if offset < 0:
+        msg = "offset must be 0 or greater"
+        raise ValueError(msg)
+
+
+def validate_since(since: str) -> str:
+    """Return `since` unchanged if it is an ISO 8601 date or datetime, else raise."""
+    try:
+        datetime.fromisoformat(since)
+    except ValueError:
+        msg = "since must be an ISO 8601 date or datetime, e.g. 2026-01-31"
+        raise ValueError(msg) from None
+    return since
