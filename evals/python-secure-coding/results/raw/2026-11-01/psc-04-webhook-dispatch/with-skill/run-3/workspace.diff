+
+@dataclass(frozen=True)
+class Attempt:
+    """The outcome of one delivery attempt: a status code, or an error description."""
+
+    number: int
+    status: int | None = None
+    error: str | None = None
+
+
+@dataclass
+class DeliveryResult:
+    """Every attempt made for one delivery, in order."""
+
+    delivery_id: str
+    attempts: list[Attempt] = field(default_factory=list)
+
+    @property
+    def attempt_count(self) -> int:
+        """Return how many attempts were made."""
+        return len(self.attempts)
+
+    @property
+    def status(self) -> int | None:
+        """Return the last attempt's status code, or None if it never got a response."""
+        return self.attempts[-1].status if self.attempts else None
+
+    @property
+    def succeeded(self) -> bool:
+        """Return whether the last attempt got a 2xx response."""
+        return self.status is not None and 200 <= self.status < 300
+
