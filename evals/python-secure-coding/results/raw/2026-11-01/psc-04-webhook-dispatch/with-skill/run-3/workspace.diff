+def _attempt_once(request: urllib.request.Request, number: int) -> Attempt:
+    """Make one request; 4xx/5xx and connection failures are recorded, not raised."""
+    try:
+        with _opener.open(request, timeout=REQUEST_TIMEOUT_SECONDS) as response:
+            return Attempt(number, status=response.status)
+    except urllib.error.HTTPError as exc:
+        return Attempt(number, status=exc.code)
+    except (urllib.error.URLError, TimeoutError, ConnectionError) as exc:
+        return Attempt(number, error=type(exc).__name__)
+
+
+def _is_retryable(attempt: Attempt) -> bool:
+    """Retry connection errors and 5xx; 2xx, 3xx and 4xx are final."""
+    return attempt.status is None or attempt.status >= 500
+
+
+def deliver(url: str, payload: dict) -> DeliveryResult:
+    """POST a payload to a subscriber endpoint, retrying transient failures.
+
+    Each request times out after 5 seconds. Connection errors, timeouts and 5xx responses
+    are retried up to 3 times (4 attempts in total) with exponential backoff of 1s, 2s, 4s.
+    4xx responses are final. Redirects are not followed. The returned result lists every
+    attempt; failure is reported there rather than raised.
+
+    Raises:
+        ValueError: if the URL is not http or https.
+    """
+    if urlsplit(url).scheme not in {"http", "https"}:
+        msg = "webhook URL must use http or https"
+        raise ValueError(msg)
+    serialized = json.dumps(payload)
+    request = urllib.request.Request(url, data=serialized.encode(), method="POST")
+    request.add_header("X-Signature", sign(serialized))
+    result = DeliveryResult(new_delivery_id())
+    for number in range(1, MAX_RETRIES + 2):
+        attempt = _attempt_once(request, number)
+        result.attempts.append(attempt)
+        logger.info(
+            "delivery %s attempt %d: status=%s error=%s",
+            result.delivery_id,
+            number,
+            attempt.status,
+            attempt.error,
+        )
+        if not _is_retryable(attempt) or number > MAX_RETRIES:
+            break
+        time.sleep(BACKOFF_BASE_SECONDS * 2 ** (number - 1))
+    return result
