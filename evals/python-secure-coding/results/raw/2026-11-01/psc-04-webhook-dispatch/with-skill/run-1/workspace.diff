+def deliver_with_attempts(url: str, payload: dict) -> DeliveryResult:
+    """POST a payload, retrying 5xx responses and connection errors with backoff.
+
+    Each request times out after REQUEST_TIMEOUT_SECONDS. A retryable failure is retried up to
+    MAX_RETRIES times, sleeping 1s, 2s, 4s between attempts. A 4xx (or other non-5xx) response
+    is final and is not retried. Never raises for an HTTP or connection failure; inspect the
+    returned result.
+    """
     body = json.dumps(payload).encode()
-    request = urllib.request.Request(url, data=body, method="POST")
-    request.add_header("X-Signature", sign(json.dumps(payload)))
