-    with urllib.request.urlopen(request) as response:
-        return response.status
+    signature = sign(json.dumps(payload))
+    delivery_id = new_delivery_id()
+    result = DeliveryResult()
+    for number in range(1, MAX_RETRIES + 2):
+        request = urllib.request.Request(url, data=body, method="POST")
+        request.add_header("X-Signature", signature)
+        # The signing token is deliberately not logged.
+        logger.info("delivering %s to %s (attempt %d)", delivery_id, url, number)
+        retryable = True
+        try:
+            with urllib.request.urlopen(request, timeout=REQUEST_TIMEOUT_SECONDS) as response:
+                result.attempts.append(Attempt(number, status=response.status))
+                return result
+        except urllib.error.HTTPError as exc:  # subclass of OSError, so must come first
+            result.attempts.append(Attempt(number, status=exc.code, error=str(exc)))
+            retryable = exc.code >= 500
+        except OSError as exc:  # URLError, connection failures and timeouts
+            result.attempts.append(Attempt(number, error=f"{type(exc).__name__}: {exc}"))
+        if not retryable or number > MAX_RETRIES:
+            break
+        time.sleep(BACKOFF_BASE_SECONDS * 2 ** (number - 1))
+    return result
+
+
+def deliver(url: str, payload: dict) -> int:
+    """POST a payload to a subscriber endpoint and return the status code.
+
+    Retries as described in `deliver_with_attempts`. Raises DeliveryError (carrying the
+    attempts) if the delivery did not end in a 2xx response.
+    """
+    result = deliver_with_attempts(url, payload)
+    if not result.succeeded or result.status is None:
+        raise DeliveryError(result)
+    return result.status
