+@dataclass(frozen=True)
+class Attempt:
+    """Outcome of one HTTP attempt: a status code, or an error description if none arrived."""
+
+    number: int
+    status: int | None = None
+    error: str | None = None
+
+
+@dataclass
+class DeliveryResult:
+    """Outcome of a delivery, including every attempt made."""
+
+    delivery_id: str
+    attempts: list[Attempt] = field(default_factory=list)
+
+    @property
+    def status(self) -> int | None:
+        """Status code of the last attempt, or None if it never got a response."""
+        return self.attempts[-1].status if self.attempts else None
+
+    @property
+    def delivered(self) -> bool:
+        """True if the last attempt got a 2xx response."""
+        return self.status is not None and 200 <= self.status < 300
+
+
+def _attempt(request: urllib.request.Request, number: int) -> Attempt:
+    """Make one request; HTTP errors and connection failures become an Attempt."""
+    try:
+        with urllib.request.urlopen(request, timeout=REQUEST_TIMEOUT_SECONDS) as response:
+            return Attempt(number, status=response.status)
+    except urllib.error.HTTPError as exc:
+        return Attempt(number, status=exc.code)
+    except (urllib.error.URLError, TimeoutError, ConnectionError) as exc:
+        # Only the exception type is recorded; messages can embed the URL.
+        return Attempt(number, error=type(exc).__name__)
+
+
+def _retryable(attempt: Attempt) -> bool:
+    """Connection errors and 5xx responses are retryable; 2xx/3xx/4xx are final."""
+    return attempt.status is None or attempt.status >= 500
+
+
+def deliver(url: str, payload: dict) -> DeliveryResult:
+    """POST a payload to a subscriber endpoint, retrying transient failures.
+
+    Each request has a 5 second timeout. Connection errors, timeouts and 5xx responses are
+    retried up to MAX_RETRIES times with exponential backoff (1s, 2s, 4s); 4xx is final.
+    Every attempt is recorded on the returned DeliveryResult.
+    """
+    if urlsplit(url).scheme not in ("http", "https"):
+        raise ValueError("subscriber URL must use http or https")
+    text = json.dumps(payload)
+    request = urllib.request.Request(url, data=text.encode(), method="POST")
+    request.add_header("X-Signature", sign(text))
+    result = DeliveryResult(delivery_id=new_delivery_id())
+    for number in range(1, MAX_RETRIES + 2):
+        attempt = _attempt(request, number)
+        result.attempts.append(attempt)
+        logger.info(
+            "delivery %s attempt %d: status=%s error=%s",
+            result.delivery_id,
+            number,
+            attempt.status,
+            attempt.error,
+        )
+        if not _retryable(attempt) or number > MAX_RETRIES:
+            break
+        time.sleep(BACKOFF_BASE_SECONDS * 2 ** (number - 1))
+    return result
