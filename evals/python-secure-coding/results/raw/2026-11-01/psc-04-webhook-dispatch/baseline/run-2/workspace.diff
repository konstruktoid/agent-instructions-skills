+@dataclass(frozen=True)
+class Attempt:
+    """Outcome of one HTTP attempt: a status code, or an error with no response."""
+
+    number: int
+    status: int | None = None
+    error: str | None = None
+
+
+@dataclass(frozen=True)
+class DeliveryResult:
+    """A successful delivery and every attempt made to achieve it."""
+
+    status: int
+    attempts: list[Attempt] = field(default_factory=list)
+
+
+class DeliveryError(Exception):
+    """Delivery failed, either with a final 4xx or after exhausting retries."""
+
+    def __init__(self, message: str, attempts: list[Attempt]):
+        super().__init__(message)
+        self.attempts = attempts
+
+
+def deliver(
+    url: str,
+    payload: dict,
+    *,
+    timeout: float = REQUEST_TIMEOUT,
+    max_retries: int = MAX_RETRIES,
+    backoff: float = BACKOFF_BASE,
+    sleep: Callable[[float], None] = time.sleep,
+) -> DeliveryResult:
+    """POST a payload to a subscriber endpoint, retrying transient failures.
+
+    5xx responses, timeouts and connection errors are retried up to ``max_retries`` times
+    with exponential backoff (``backoff``, 2x, 4x, ...). 4xx responses are final. Raises
+    ``DeliveryError`` (carrying ``attempts``) on failure.
+    """
+    body = json.dumps(payload)
+    delivery_id = new_delivery_id()
+    attempts: list[Attempt] = []
+    for number in range(1, max_retries + 2):
+        request = urllib.request.Request(url, data=body.encode(), method="POST")
+        request.add_header("X-Signature", sign(body))
+        logger.info("delivering %s to %s (attempt %d)", delivery_id, url, number)
+        try:
+            with urllib.request.urlopen(request, timeout=timeout) as response:
+                attempts.append(Attempt(number, status=response.status))
+                return DeliveryResult(response.status, attempts)
+        except urllib.error.HTTPError as exc:
+            attempts.append(Attempt(number, status=exc.code, error=str(exc)))
+            if exc.code < 500:
+                raise DeliveryError(f"delivery rejected with {exc.code}", attempts) from exc
+        except OSError as exc:  # URLError, timeouts and connection failures
+            attempts.append(Attempt(number, error=repr(exc)))
+        if number <= max_retries:
+            sleep(backoff * 2 ** (number - 1))
+    raise DeliveryError(f"delivery failed after {len(attempts)} attempts", attempts)
