+def convert(source: Path, destination: Path, to_format: str | None = None) -> None:
+    """Convert a written CSV report into another format using pandoc."""
+    command = ["pandoc", "-f", "csv"]
+    if to_format:
+        command += ["-t", to_format]
+    # Absolute paths guarantee neither can be mistaken for a pandoc option.
+    command += ["-o", str(destination.absolute()), str(source.absolute())]
     run_tool(command)
 
 
 def write_html(destination: Path) -> None:
     """Write the reports as HTML, via an intermediate CSV file pandoc reads."""
-    intermediate = Path(temp_output_path(".csv"))
-    write_csv(intermediate)
-    convert(intermediate, destination)
+    with make_temp_dir() as tmp:
+        intermediate = Path(tmp) / "reports.csv"
+        write_csv(intermediate)
+        convert(intermediate, destination)
+
+
+def write_pdf(destination: Path) -> None:
+    """Write the reports as PDF, via an intermediate CSV file pandoc reads."""
+    with make_temp_dir() as tmp:
+        intermediate = Path(tmp) / "reports.csv"
+        write_csv(intermediate)
+        convert(intermediate, destination, "pdf")
 
 
 def main() -> None:
     """Parse arguments and export the reports."""
     parser = argparse.ArgumentParser(description="Export reports")
-    parser.add_argument("--output", default="reports.csv")
+    parser.add_argument("--format", choices=["csv", "pdf"], default="csv")
+    parser.add_argument(
+        "--output", default=None, help="destination path (default: reports.<format>)"
+    )
     args = parser.parse_args()
-    write_csv(Path(args.output))
+    destination = Path(args.output or f"reports.{args.format}")
+    if args.format == "pdf":
+        write_pdf(destination)
+    else:
+        write_csv(destination)
 
 
