-    return hashlib.sha256((salt + password + PEPPER).encode()).hexdigest()
+    return hashlib.pbkdf2_hmac(
+        "sha256", (password + PEPPER).encode(), salt.encode(), PBKDF2_ITERATIONS
+    ).hex()
 
 
