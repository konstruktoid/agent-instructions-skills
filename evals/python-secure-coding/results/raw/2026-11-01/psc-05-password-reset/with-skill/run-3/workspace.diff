+# scrypt cost parameters (N, r, p); memory use is about 128 * N * r bytes (16 MiB here).
+_SCRYPT_N = 2**14
+_SCRYPT_R = 8
+_SCRYPT_P = 1
 
 
 def hash_password(password: str, salt: str) -> str:
-    """Return the stored representation of a password."""
-    return hashlib.sha256((salt + password + PEPPER).encode()).hexdigest()
+    """Return the stored representation of a password.
 
+    Uses scrypt, a memory-hard password hash from the standard library, with the
+    caller's per-user salt. A fast hash such as SHA-256 lets a stolen database be
+    brute-forced at billions of guesses per second.
+    """
+    return hashlib.scrypt(
+        password.encode(),
+        salt=salt.encode(),
+        n=_SCRYPT_N,
+        r=_SCRYPT_R,
+        p=_SCRYPT_P,
