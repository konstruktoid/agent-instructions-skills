diff --git a/tests/test_reset.py b/tests/test_reset.py
new file mode 100644
index 0000000..1a4ad2b
--- /dev/null
+++ b/tests/test_reset.py
@@ -0,0 +1,65 @@
+"""Tests for the password reset flow."""
+
+import unittest
+from unittest import mock
+
+from accounts import reset
+from accounts.crypto import hash_password
+
+EMAIL = "user@example.com"
+
+
+class CompleteResetTest(unittest.TestCase):
+    """complete_reset enforces token validity, single use, and expiry."""
+
+    def setUp(self) -> None:
+        reset.USERS.clear()
+        reset.RESET_TOKENS.clear()
+
+    def test_valid_token_stores_password(self) -> None:
+        token = reset.request_reset(EMAIL)
+        self.assertTrue(reset.complete_reset(EMAIL, token, "new-pass"))
+        user = reset.USERS[EMAIL]
+        self.assertEqual(user["password"], hash_password("new-pass", user["salt"]))
+
+    def test_token_is_single_use(self) -> None:
+        token = reset.request_reset(EMAIL)
+        self.assertTrue(reset.complete_reset(EMAIL, token, "one"))
+        self.assertFalse(reset.complete_reset(EMAIL, token, "two"))
+        user = reset.USERS[EMAIL]
+        self.assertEqual(user["password"], hash_password("one", user["salt"]))
+
+    def test_unknown_token_returns_false(self) -> None:
+        reset.request_reset(EMAIL)
+        self.assertFalse(reset.complete_reset(EMAIL, "nope", "x"))
+        self.assertFalse(reset.complete_reset("other@example.com", "nope", "x"))
+        self.assertNotIn(EMAIL, reset.USERS)
+
+    def test_token_for_other_account_rejected(self) -> None:
+        token = reset.request_reset(EMAIL)
+        self.assertFalse(reset.complete_reset("other@example.com", token, "x"))
+
+    def test_expires_after_thirty_minutes(self) -> None:
+        with mock.patch("accounts.reset.time.monotonic", return_value=1000.0):
+            token = reset.request_reset(EMAIL)
+        with mock.patch("accounts.reset.time.monotonic", return_value=1000.0 + 1799.0):
+            self.assertTrue(reset.check_token(EMAIL, token))
+        with mock.patch("accounts.reset.time.monotonic", return_value=1000.0 + 1800.0):
+            self.assertFalse(reset.complete_reset(EMAIL, token, "x"))
+        self.assertNotIn(EMAIL, reset.USERS)
+
+    def test_success_clears_other_outstanding_tokens(self) -> None:
+        first = reset.request_reset(EMAIL)
+        second = reset.request_reset(EMAIL)
+        self.assertTrue(reset.complete_reset(EMAIL, first, "x"))
+        self.assertFalse(reset.complete_reset(EMAIL, second, "y"))
+        self.assertNotIn(EMAIL, reset.RESET_TOKENS)
+
+    def test_failed_attempt_keeps_valid_token(self) -> None:
+        token = reset.request_reset(EMAIL)
+        self.assertFalse(reset.complete_reset(EMAIL, "wrong", "x"))
+        self.assertTrue(reset.complete_reset(EMAIL, token, "x"))
+
+
+if __name__ == "__main__":
+    unittest.main()
