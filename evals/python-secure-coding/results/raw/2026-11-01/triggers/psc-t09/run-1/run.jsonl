lt-ins (`list.append`, `dict[k] = v`) are effectively atomic in standard CPython. That's an implementation detail, and free-threaded builds don't guarantee it the same way.\n\nQuick check for your pool: if per-job wall time stays flat as you add threads but CPU sits at about 100% of one core, you're GIL-bound and should switch to processes.","ttft_ms":2933,"type":"result","duration_ms":19217,"uuid":"47497d7b-4f74-4dc2-8d6d-67f0cd29ad80","ttft_stream_ms":2552,"time_to_request_ms":309,"first_content_frame_ms":2552,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":6,"outputTokens":1427,"cacheReadInputTokens":25789,"cacheCreationInputTokens":9624,"webSearchRequests":0,"costUSD":0.1107138,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":85,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":9624,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}}}
