 from pathlib import Path
 
 CACHE_DIR = Path("/tmp/sessioncache")
+SESSION_TTL = 3600  # seconds a session stays valid after issued_at
+_SESSION_ID = re.compile(r"[A-Za-z0-9_-]{1,128}")
+
+
+class SessionExpiredError(ValueError):
+    """Raised when a session is older than SESSION_TTL or has no valid issued_at."""
+
+
+def _is_expired(envelope: object, now: float) -> bool:
+    """Return True unless envelope carries an issued_at within SESSION_TTL (fails closed)."""
+    if not isinstance(envelope, dict):
+        return True
+    issued_at = envelope.get("issued_at")
+    if isinstance(issued_at, bool) or not isinstance(issued_at, int | float):
+        return True
+    # A future timestamp is treated as invalid rather than as a fresh session.
+    return not 0 <= now - issued_at <= SESSION_TTL
+
+
+def purge_expired() -> int:
+    """Delete expired or unreadable entries from the on-disk cache; return the count removed."""
+    if not CACHE_DIR.is_dir():
+        return 0
+    now = time.time()
+    removed = 0
+    for path in CACHE_DIR.glob("*.session"):
+        try:
+            envelope = json.loads(path.read_bytes())
+        except (OSError, ValueError):
+            envelope = None  # unreadable or legacy/corrupt entry: purge it, never deserialize it
+        if _is_expired(envelope, now):
+            try:
+                path.unlink()
+            except FileNotFoundError:
+                continue
+            removed += 1
+    return removed
 
 
