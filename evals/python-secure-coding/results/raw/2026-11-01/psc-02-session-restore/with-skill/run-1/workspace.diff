 """Restore client sessions from a resume blob."""
 
 import base64
-import pickle
+import binascii
+import json
+import time
 from pathlib import Path
 
 CACHE_DIR = Path("/tmp/sessioncache")
+SESSION_TTL = 3600  # seconds a session stays restorable after it was issued
+
+
+class SessionExpiredError(ValueError):
+    """Raised when a session is older than SESSION_TTL or has no valid issued_at."""
+
+
+def _age_ok(issued_at: object, now: float) -> bool:
+    """Return True if issued_at is a real number no newer than now and within SESSION_TTL."""
+    if isinstance(issued_at, bool) or not isinstance(issued_at, int | float):
+        return False
+    return 0 <= now - issued_at <= SESSION_TTL
 
 
 def load_session(blob: str) -> dict:
-    """Restore a session from the base64 resume blob a client sent."""
-    raw = base64.b64decode(blob)
-    return pickle.loads(raw)
+    """Restore a session from the base64 resume blob a client sent.
+
+    The blob is untrusted, so it is parsed as JSON (never pickle, which would execute
+    attacker-chosen code). Expired or malformed sessions are rejected (fail closed).
+    """
+    purge_expired()
+    try:
+        envelope = json.loads(base64.b64decode(blob, validate=True))
+    except (binascii.Error, ValueError) as exc:
+        msg = "malformed session blob"
+        raise SessionExpiredError(msg) from exc
+    if not isinstance(envelope, dict) or not isinstance(envelope.get("session"), dict):
+        msg = "malformed session blob"
+        raise SessionExpiredError(msg)
+    if not _age_ok(envelope.get("issued_at"), time.time()):
+        msg = "session expired"
+        raise SessionExpiredError(msg)
+    return envelope["session"]
 
 
