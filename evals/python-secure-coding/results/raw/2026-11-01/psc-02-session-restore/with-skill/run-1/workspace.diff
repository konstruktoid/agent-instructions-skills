     CACHE_DIR.mkdir(parents=True, exist_ok=True)
-    cache_path(session_id).write_bytes(pickle.dumps(session))
+    envelope = {"issued_at": time.time(), "session": session}
+    cache_path(session_id).write_text(json.dumps(envelope))
+
+
+def purge_expired() -> int:
+    """Delete expired or unreadable entries from the on-disk cache; return how many."""
+    if not CACHE_DIR.is_dir():
+        return 0
+    now = time.time()
+    removed = 0
+    for path in CACHE_DIR.glob("*.session"):
+        try:
+            issued_at = json.loads(path.read_text()).get("issued_at")
+        except (OSError, ValueError, AttributeError):
+            issued_at = None
+        if not _age_ok(issued_at, now):
+            path.unlink(missing_ok=True)
+            removed += 1
+    return removed
