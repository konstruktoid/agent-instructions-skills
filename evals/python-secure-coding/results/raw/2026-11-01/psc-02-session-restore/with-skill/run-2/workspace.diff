 from pathlib import Path
 
 CACHE_DIR = Path("/tmp/sessioncache")
+SESSION_TTL = 3600  # seconds a session stays valid after issued_at
+
+
+class SessionExpiredError(ValueError):
+    """The session is malformed or older than SESSION_TTL."""
+
+
+def _is_fresh(envelope: object, now: float) -> bool:
+    """Return True only for an envelope with a valid issued_at within SESSION_TTL."""
+    if not isinstance(envelope, dict):
+        return False
+    issued_at = envelope.get("issued_at")
+    if isinstance(issued_at, bool) or not isinstance(issued_at, int | float):
+        return False
+    if not math.isfinite(issued_at):
+        return False
+    return 0 <= now - issued_at <= SESSION_TTL
+
+
+def _wrap(session: dict) -> bytes:
+    """Serialize a session with the issued_at time it was saved."""
+    return json.dumps({"issued_at": time.time(), "session": session}).encode()
 
 
