+    """Restore a session from the base64 resume blob a client sent.
+
+    The blob is untrusted, so it is parsed as JSON (never pickle) and fails closed:
+    anything malformed, or issued more than SESSION_TTL seconds ago, is rejected.
+    """
+    purge_expired()
+    try:
+        envelope = json.loads(base64.b64decode(blob, validate=True))
+    except (binascii.Error, ValueError) as exc:
+        raise SessionExpiredError("invalid session blob") from exc
+    if not _is_fresh(envelope, time.time()):
+        raise SessionExpiredError("session expired or invalid")
+    session = envelope.get("session")
+    if not isinstance(session, dict):
+        raise SessionExpiredError("invalid session blob")
+    return session
 
 
