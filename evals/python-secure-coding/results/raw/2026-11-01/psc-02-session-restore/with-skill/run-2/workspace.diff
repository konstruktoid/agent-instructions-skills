+def purge_expired() -> int:
+    """Delete expired or unreadable entries from the on-disk cache; return the count removed.
+
+    The cache directory is world-writable, so entries are parsed as JSON only and any
+    entry that cannot be validated is treated as expired (fail closed).
+    """
+    if not CACHE_DIR.is_dir():
+        return 0
+    now = time.time()
+    removed = 0
+    for path in CACHE_DIR.glob("*.session"):
+        try:
+            envelope = json.loads(path.read_bytes())
+        except (OSError, ValueError):
+            envelope = None
+        if not _is_fresh(envelope, now):
+            path.unlink(missing_ok=True)
+            removed += 1
+    return removed
