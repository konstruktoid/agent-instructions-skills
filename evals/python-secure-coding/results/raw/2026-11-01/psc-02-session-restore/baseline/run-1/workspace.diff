+def purge_expired() -> int:
+    """Delete expired (or unreadable) entries from the cache; return the count removed."""
+    if not CACHE_DIR.is_dir():
+        return 0
+    removed = 0
+    now = time.time()
+    for path in CACHE_DIR.glob("*.session"):
+        try:
+            issued_at = json.loads(path.read_text())["issued_at"]
+            expired = now - issued_at > SESSION_TTL
+        except (OSError, ValueError, KeyError, TypeError):
+            expired = True
+        if expired:
+            path.unlink(missing_ok=True)
+            removed += 1
+    return removed
