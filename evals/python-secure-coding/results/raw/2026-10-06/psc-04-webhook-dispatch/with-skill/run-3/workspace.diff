+    """POST a payload to a subscriber endpoint, retrying transient failures.
+
+    Each request times out after REQUEST_TIMEOUT_SECONDS. Connection errors, timeouts and
+    5xx responses are retried up to MAX_RETRIES times with exponential backoff (1s, 2s, 4s);
+    4xx responses are final and not retried. Every attempt is recorded in the result.
+    """
+    if urlsplit(url).scheme not in ("http", "https"):
