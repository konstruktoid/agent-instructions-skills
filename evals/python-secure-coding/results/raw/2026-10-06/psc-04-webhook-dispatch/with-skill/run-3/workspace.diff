@@ -0,0 +1,64 @@
+import unittest
+import urllib.error
+from email.message import Message
+from unittest import mock
+
+from webhooks import dispatch
+
+URL = "https://subscriber.example.com/hook"
+
+
+class FakeResponse:
+    def __init__(self, status: int) -> None:
+        self.status = status
+
+    def __enter__(self) -> "FakeResponse":
+        return self
+
+    def __exit__(self, *args: object) -> None:
+        return None
+
+
+def http_error(code: int) -> urllib.error.HTTPError:
+    return urllib.error.HTTPError(URL, code, "err", Message(), None)
+
+
+def run(side_effect: list) -> tuple[dispatch.DeliveryResult, mock.MagicMock, list[float]]:
+    sleeps: list[float] = []
+    with mock.patch("urllib.request.urlopen", side_effect=side_effect) as urlopen:
+        result = dispatch.deliver(URL, {"a": 1}, sleep=sleeps.append)
+    return result, urlopen, sleeps
+
+
+class DeliverTest(unittest.TestCase):
+    def test_success_first_try_uses_timeout(self) -> None:
+        result, urlopen, sleeps = run([FakeResponse(200)])
+        self.assertEqual(len(result.attempts), 1)
+        self.assertTrue(result.delivered)
+        self.assertEqual(urlopen.call_args.kwargs["timeout"], 5)
+        self.assertEqual(sleeps, [])
+
+    def test_retries_5xx_then_succeeds(self) -> None:
+        result, _, sleeps = run([http_error(503), ConnectionResetError(), FakeResponse(200)])
+        self.assertEqual([a.status for a in result.attempts], [503, None, 200])
+        self.assertEqual(sleeps, [1.0, 2.0])
+
+    def test_gives_up_after_three_retries(self) -> None:
+        result, urlopen, sleeps = run([TimeoutError()] * 4)
+        self.assertEqual(urlopen.call_count, 4)
+        self.assertFalse(result.delivered)
+        self.assertEqual(sleeps, [1.0, 2.0, 4.0])
+
+    def test_4xx_is_final(self) -> None:
+        result, urlopen, sleeps = run([http_error(404)])
+        self.assertEqual(urlopen.call_count, 1)
+        self.assertEqual(result.status, 404)
+        self.assertEqual(sleeps, [])
+
+    def test_rejects_non_http_scheme(self) -> None:
+        with self.assertRaises(ValueError):
+            dispatch.deliver("file:///etc/passwd", {})
+
+
+if __name__ == "__main__":
+    unittest.main()
