-    with urllib.request.urlopen(request) as response:
-        return response.status
+    signature = sign(json.dumps(payload))
+    delivery_id = new_delivery_id()
+    result = DeliveryResult()
+
+    for number in range(1, MAX_RETRIES + 2):
+        request = urllib.request.Request(url, data=body, method="POST")
+        request.add_header("X-Signature", signature)
+        status: int | None = None
+        error: str | None = None
+        try:
+            # Scheme is restricted to http(s) above.
+            with urllib.request.urlopen(request, timeout=REQUEST_TIMEOUT_SECONDS) as response:  # noqa: S310
+                status = response.status
+        except urllib.error.HTTPError as exc:
+            status = exc.code
+            error = f"HTTP {exc.code}"
+        except OSError as exc:  # URLError, timeouts and connection failures
+            error = type(exc).__name__
+        result.attempts.append(Attempt(number, status, error))
+        logger.info("delivery %s attempt %d to %s: %s", delivery_id, number, url, status or error)
+
+        retryable = error is not None and (status is None or status >= 500)
+        if not retryable or number > MAX_RETRIES:
+            break
+        sleep(BACKOFF_BASE_SECONDS * 2 ** (number - 1))
+    return result
