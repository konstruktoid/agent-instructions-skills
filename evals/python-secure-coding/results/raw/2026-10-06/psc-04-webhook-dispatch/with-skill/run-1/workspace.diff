+@dataclass(frozen=True)
+class Attempt:
+    """One delivery attempt; status is None when no response was received."""
+
+    number: int
+    status: int | None
+    error: str | None = None
+
+
+@dataclass(frozen=True)
+class Delivery:
+    """The outcome of a delivery and every attempt made."""
+
+    attempts: list[Attempt]
+
+    @property
+    def status(self) -> int | None:
+        """Status of the last attempt, or None if it got no response."""
+        return self.attempts[-1].status
+
+    @property
+    def succeeded(self) -> bool:
+        """Whether the last attempt got a 2xx or 3xx response."""
+        status = self.status
+        return status is not None and status < 400
+
