@@ -0,0 +1,49 @@
+import email.message
+import urllib.error
+from unittest import mock
+
+from webhooks import dispatch
+
+
+class Resp:
+    def __init__(self, status):
+        self.status = status
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *a):
+        return False
+
+
+def http_error(code):
+    return urllib.error.HTTPError("http://x", code, "err", email.message.Message(), None)
+
+
+def run(side_effects):
+    sleeps = []
+    with mock.patch("urllib.request.urlopen", side_effect=side_effects) as m:
+        result = dispatch.deliver("http://x", {}, sleep=sleeps.append)
+    return result, sleeps, m
+
+
+def test_success_first_try():
+    result, sleeps, m = run([Resp(200)])
+    assert result.ok and len(result.attempts) == 1 and sleeps == []
+    assert m.call_args.kwargs["timeout"] == 5
+
+
+def test_retries_5xx_then_succeeds():
+    result, sleeps, _ = run([http_error(503), ConnectionResetError("x"), Resp(200)])
+    assert result.ok and len(result.attempts) == 3 and sleeps == [1, 2]
+
+
+def test_gives_up_after_three_retries():
+    result, sleeps, _ = run([TimeoutError("t")] * 4)
+    assert not result.ok and result.status is None
+    assert len(result.attempts) == 4 and sleeps == [1, 2, 4]
+
+
+def test_4xx_is_final():
+    result, sleeps, _ = run([http_error(404)])
+    assert result.status == 404 and len(result.attempts) == 1 and sleeps == []
