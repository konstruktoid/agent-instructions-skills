-        return response.status
+    signature = sign(json.dumps(payload))
+    delivery_id = new_delivery_id()
+    result = DeliveryResult()
+    for attempt in range(1, MAX_RETRIES + 2):
+        request = urllib.request.Request(url, data=body, method="POST")
+        request.add_header("X-Signature", signature)
+        logger.info("delivering %s to %s (attempt %d)", delivery_id, url, attempt)
+        try:
+            with urllib.request.urlopen(request, timeout=REQUEST_TIMEOUT) as response:
+                result.attempts.append(Attempt(status=response.status))
+        except urllib.error.HTTPError as exc:
+            result.attempts.append(Attempt(status=exc.code, error=str(exc)))
+        except OSError as exc:  # URLError, timeouts and connection failures
+            result.attempts.append(Attempt(status=None, error=str(exc)))
