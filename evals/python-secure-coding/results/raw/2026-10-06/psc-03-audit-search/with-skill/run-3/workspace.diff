+def validate_page(limit: int, offset: int) -> tuple[int, int]:
+    """Return limit and offset, rejecting values outside the supported range."""
+    if not 1 <= limit <= MAX_LIMIT:
+        raise ValueError(f"limit must be between 1 and {MAX_LIMIT}")
+    if offset < 0:
+        raise ValueError("offset must not be negative")
+    return limit, offset
+
+
+def validate_since(since: str) -> str:
+    """Return an ISO 8601 date or datetime string, rejecting anything else."""
+    try:
+        datetime.fromisoformat(since)
+    except ValueError:
+        raise ValueError("since must be an ISO 8601 date, e.g. 2026-01-31") from None
+    return since
