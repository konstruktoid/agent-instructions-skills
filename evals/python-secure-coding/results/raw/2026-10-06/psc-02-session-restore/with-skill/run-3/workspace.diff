-import pickle
+import binascii
+import json
+import time
 from pathlib import Path
 
 CACHE_DIR = Path("/tmp/sessioncache")
+SESSION_TTL = 3600  # seconds a saved session stays restorable
+
+
+class SessionError(ValueError):
+    """Raised when a resume blob is malformed or its session has expired."""
+
+
+def _issued_at(record: object) -> float:
+    """Return the issued_at timestamp of a decoded record, or raise SessionError."""
+    if not isinstance(record, dict) or not isinstance(record.get("session"), dict):
+        raise SessionError("malformed session record")
+    issued_at = record.get("issued_at")
+    if isinstance(issued_at, bool) or not isinstance(issued_at, int | float):
+        raise SessionError("malformed session record")
+    return float(issued_at)
+
+
+def _is_expired(issued_at: float, now: float) -> bool:
+    """Treat a session as expired when too old or stamped in the future (fail closed)."""
+    return not 0 <= now - issued_at <= SESSION_TTL
 
 
 def load_session(blob: str) -> dict:
-    """Restore a session from the base64 resume blob a client sent."""
-    raw = base64.b64decode(blob)
-    return pickle.loads(raw)
+    """Restore a session from the base64 resume blob a client sent.
+
+    The blob is untrusted, so it is parsed as JSON, never unpickled. Expired cache
+    entries are purged on every restore.
+    """
+    purge_expired()
+    try:
+        record = json.loads(base64.b64decode(blob, validate=True))
+    except (binascii.Error, ValueError) as exc:  # JSON and UTF-8 errors are ValueErrors
+        raise SessionError("malformed resume blob") from exc
+    if _is_expired(_issued_at(record), time.time()):
+        raise SessionError("session expired")
+    return record["session"]
 
 
