+def _is_expired(issued_at: object, now: float) -> bool:
+    """Treat a missing, non-numeric, future-dated, or too-old timestamp as expired."""
+    if isinstance(issued_at, bool) or not isinstance(issued_at, int | float):
+        return True
+    return not 0 <= now - issued_at <= SESSION_TTL
