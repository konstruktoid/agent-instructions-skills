+    """Restore a session from the base64 resume blob a client sent.
+
+    The blob is untrusted, so it is parsed as JSON, never unpickled.
+    """
+    try:
+        envelope = json.loads(base64.b64decode(blob, validate=True))
+    except (binascii.Error, ValueError) as exc:
+        raise ValueError("malformed resume blob") from exc
+    if not isinstance(envelope, dict) or not isinstance(envelope.get("session"), dict):
+        raise ValueError("malformed resume blob")
+    purge_expired()
+    if _is_expired(envelope.get("issued_at"), time.time()):
+        raise SessionExpiredError("session expired")
+    return envelope["session"]
 
 
