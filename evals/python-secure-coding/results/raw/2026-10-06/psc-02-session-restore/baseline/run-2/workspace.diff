+def purge_expired() -> int:
+    """Remove expired entries from the on-disk cache; return how many were removed."""
+    if not CACHE_DIR.is_dir():
+        return 0
+    now = time.time()
+    removed = 0
+    for path in CACHE_DIR.glob("*.session"):
+        try:
+            issued_at = json.loads(path.read_text()).get("issued_at")
+        except (OSError, ValueError, AttributeError):
+            issued_at = None  # unreadable or legacy entries have no valid timestamp
+        if _is_expired(issued_at, now):
+            path.unlink(missing_ok=True)
+            removed += 1
+    return removed
