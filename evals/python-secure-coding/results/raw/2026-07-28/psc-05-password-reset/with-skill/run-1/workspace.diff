+def _find_live_token(email: str, token: str) -> str | None:
+    """Return the stored token matching `token` for `email`, if any is unexpired.
+
+    Tokens are matched with a constant-time comparison and only ones issued
+    within `TOKEN_LIFETIME` are considered; expired entries are treated as
+    absent rather than raising, since expiry is a normal outcome here.
+    """
+    now = datetime.now(UTC)
+    for stored_token, issued_at in RESET_TOKENS.get(email, {}).items():
+        if now - issued_at > TOKEN_LIFETIME:
+            continue
+        if tokens_match(stored_token, token):
+            return stored_token
+    return None
