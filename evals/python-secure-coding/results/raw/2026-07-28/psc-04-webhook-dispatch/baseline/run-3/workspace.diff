+@dataclass
+class Attempt:
+    """Outcome of a single delivery attempt."""
+
+    status: int | None
+    error: str | None
+
+
+@dataclass
+class DeliveryResult:
+    """Outcome of a delivery, including every attempt made to reach it."""
+
+    status: int
+    attempts: list[Attempt] = field(default_factory=list)
+
+
+class DeliveryError(Exception):
+    """Raised when a webhook could not be delivered."""
+
+    def __init__(self, message: str, attempts: list[Attempt]) -> None:
+        super().__init__(message)
+        self.attempts = attempts
+
+
+def _post(url: str, body: bytes, headers: dict[str, str]) -> int:
+    request = urllib.request.Request(url, data=body, method="POST", headers=headers)
+    with urllib.request.urlopen(request, timeout=REQUEST_TIMEOUT_SECONDS) as response:
         return response.status
+
+
+def deliver(url: str, payload: dict) -> DeliveryResult:
+    """POST a payload to a subscriber endpoint, retrying transient failures.
+
+    Each request is bound by a 5 second timeout. A failed delivery is retried
+    up to MAX_ATTEMPTS times with exponential backoff between attempts. 5xx
+    responses and connection/timeout errors are treated as retryable; 4xx
+    responses are treated as final and raised immediately. Every attempt is
+    recorded on the returned result (or on the raised DeliveryError) so a
+    caller can see how many were made.
+    """
+    body = json.dumps(payload).encode()
+    headers = {"X-Signature": sign(json.dumps(payload))}
+    delivery_id = new_delivery_id()
+    attempts: list[Attempt] = []
+
+    for attempt_number in range(1, MAX_ATTEMPTS + 1):
+        logger.info(
+            "delivering %s to %s (attempt %d/%d)", delivery_id, url, attempt_number, MAX_ATTEMPTS
+        )
+        try:
+            status = _post(url, body, headers)
+        except urllib.error.HTTPError as exc:
+            attempts.append(Attempt(status=exc.code, error=str(exc)))
+            if exc.code < 500:
+                raise DeliveryError(
+                    f"delivery {delivery_id} failed with non-retryable status {exc.code}", attempts
+                ) from exc
+        except (urllib.error.URLError, TimeoutError, OSError) as exc:
+            attempts.append(Attempt(status=None, error=str(exc)))
+        else:
+            attempts.append(Attempt(status=status, error=None))
+            return DeliveryResult(status=status, attempts=attempts)
+
+        if attempt_number < MAX_ATTEMPTS:
+            time.sleep(BACKOFF_BASE_SECONDS * 2 ** (attempt_number - 1))
+
+    raise DeliveryError(f"delivery {delivery_id} failed after {MAX_ATTEMPTS} attempts", attempts)
