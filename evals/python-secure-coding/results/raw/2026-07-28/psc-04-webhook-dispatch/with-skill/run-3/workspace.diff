+
+def _send_once(request: urllib.request.Request) -> DeliveryAttempt:
+    try:
+        with urllib.request.urlopen(request, timeout=REQUEST_TIMEOUT_SECONDS) as response:
+            return DeliveryAttempt(status_code=response.status, error=None)
+    except urllib.error.HTTPError as exc:
+        return DeliveryAttempt(status_code=exc.code, error=str(exc))
+    except (urllib.error.URLError, TimeoutError) as exc:
+        return DeliveryAttempt(status_code=None, error=str(exc))
