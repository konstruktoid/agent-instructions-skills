diff --git a/tests/test_dispatch.py b/tests/test_dispatch.py
new file mode 100644
index 0000000..7d83ed6
--- /dev/null
+++ b/tests/test_dispatch.py
@@ -0,0 +1,104 @@
+"""Tests for retry, timeout, and attempt-recording behavior in webhook delivery."""
+
+import unittest
+import urllib.error
+from email.message import Message
+from unittest.mock import call, patch
+
+from webhooks.dispatch import MAX_ATTEMPTS, REQUEST_TIMEOUT_SECONDS, deliver
+
+
+def http_error(url: str, code: int, msg: str) -> urllib.error.HTTPError:
+    return urllib.error.HTTPError(url, code, msg, hdrs=Message(), fp=None)
+
+
+class FakeResponse:
+    """Minimal stand-in for the object urllib.request.urlopen returns."""
+
+    def __init__(self, status: int):
+        self.status = status
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *exc_info):
+        return False
+
+
+class DeliverTests(unittest.TestCase):
+    def setUp(self):
+        patcher = patch("webhooks.dispatch.time.sleep")
+        self.mock_sleep = patcher.start()
+        self.addCleanup(patcher.stop)
+
+    @patch("webhooks.dispatch.urllib.request.urlopen")
+    def test_success_on_first_attempt_makes_one_attempt(self, mock_urlopen):
+        mock_urlopen.return_value = FakeResponse(200)
+
+        attempts = deliver("https://example.com/hook", {"event": "created"})
+
+        self.assertEqual(len(attempts), 1)
+        self.assertTrue(attempts[0].ok)
+        self.assertEqual(attempts[0].status_code, 200)
+        self.mock_sleep.assert_not_called()
+
+    @patch("webhooks.dispatch.urllib.request.urlopen")
+    def test_request_uses_five_second_timeout(self, mock_urlopen):
+        mock_urlopen.return_value = FakeResponse(200)
+
+        deliver("https://example.com/hook", {"event": "created"})
+
+        self.assertEqual(REQUEST_TIMEOUT_SECONDS, 5)
+        _, kwargs = mock_urlopen.call_args
+        self.assertEqual(kwargs["timeout"], 5)
+
+    @patch("webhooks.dispatch.urllib.request.urlopen")
+    def test_4xx_is_final_and_not_retried(self, mock_urlopen):
+        mock_urlopen.side_effect = http_error("https://example.com/hook", 404, "Not Found")
+
+        attempts = deliver("https://example.com/hook", {"event": "created"})
+
+        self.assertEqual(len(attempts), 1)
+        self.assertFalse(attempts[0].ok)
+        self.assertEqual(attempts[0].status_code, 404)
+        self.mock_sleep.assert_not_called()
+
+    @patch("webhooks.dispatch.urllib.request.urlopen")
+    def test_5xx_is_retried_up_to_max_attempts(self, mock_urlopen):
+        mock_urlopen.side_effect = http_error(
+            "https://example.com/hook", 503, "Service Unavailable"
+        )
+
+        attempts = deliver("https://example.com/hook", {"event": "created"})
+
+        self.assertEqual(len(attempts), MAX_ATTEMPTS)
+        self.assertTrue(all(a.status_code == 503 and not a.ok for a in attempts))
+        self.mock_sleep.assert_has_calls([call(1.0), call(2.0)])
+        self.assertEqual(self.mock_sleep.call_count, MAX_ATTEMPTS - 1)
+
+    @patch("webhooks.dispatch.urllib.request.urlopen")
+    def test_connection_error_is_retryable(self, mock_urlopen):
+        mock_urlopen.side_effect = urllib.error.URLError("connection refused")
+
+        attempts = deliver("https://example.com/hook", {"event": "created"})
+
+        self.assertEqual(len(attempts), MAX_ATTEMPTS)
+        self.assertTrue(all(a.status_code is None and not a.ok for a in attempts))
+
+    @patch("webhooks.dispatch.urllib.request.urlopen")
+    def test_succeeds_after_a_retryable_failure(self, mock_urlopen):
+        mock_urlopen.side_effect = [
+            http_error("https://example.com/hook", 500, "Internal Server Error"),
+            FakeResponse(200),
+        ]
+
+        attempts = deliver("https://example.com/hook", {"event": "created"})
+
+        self.assertEqual(len(attempts), 2)
+        self.assertFalse(attempts[0].ok)
+        self.assertTrue(attempts[1].ok)
+        self.mock_sleep.assert_called_once_with(1.0)
+
+
+if __name__ == "__main__":
+    unittest.main()
