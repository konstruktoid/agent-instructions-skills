+def deliver(url: str, payload: dict) -> tuple[int, list[DeliveryAttempt]]:
+    """POST a payload to a subscriber endpoint, retrying retryable failures.
+
+    Each request is bounded by a ``TIMEOUT_SECONDS`` timeout. A response with a 5xx
+    status, or a connection error (timeout, DNS failure, refused connection), is
+    retried up to ``MAX_RETRIES`` times with exponential backoff between attempts. A
+    4xx response is treated as final and raised immediately.
+
+    Returns the final status code and the list of attempts made. Raises
+    DeliveryError, carrying the attempts made, if every attempt fails.
+    """
