+    )
diff --git a/tests/test_dispatch.py b/tests/test_dispatch.py
new file mode 100644
index 0000000..1fc2b78
--- /dev/null
+++ b/tests/test_dispatch.py
@@ -0,0 +1,85 @@
+"""Tests for webhook delivery retry, timeout, and attempt-recording behavior."""
+
+import unittest
+import urllib.error
+from unittest import mock
+
+from webhooks import dispatch
+
+
+class FakeResponse:
+    def __init__(self, status: int) -> None:
+        self.status = status
+
+    def __enter__(self) -> "FakeResponse":
+        return self
+
+    def __exit__(self, *exc_info: object) -> bool:
+        return False
+
+
+class DeliverTests(unittest.TestCase):
+    def setUp(self) -> None:
+        sleep_patch = mock.patch("webhooks.dispatch.time.sleep")
+        sleep_patch.start()
+        self.addCleanup(sleep_patch.stop)
+
+    def test_success_on_first_try_uses_timeout(self) -> None:
+        with mock.patch(
+            "webhooks.dispatch.urllib.request.urlopen", return_value=FakeResponse(200)
+        ) as urlopen:
+            status, attempts = dispatch.deliver("http://example.test", {"a": 1})
+        self.assertEqual(status, 200)
+        self.assertEqual(len(attempts), 1)
+        self.assertEqual(urlopen.call_args.kwargs.get("timeout"), dispatch.TIMEOUT_SECONDS)
+
+    def test_5xx_is_retried_then_succeeds(self) -> None:
+        server_error = urllib.error.HTTPError("http://example.test", 503, "busy", None, None)
+        with mock.patch(
+            "webhooks.dispatch.urllib.request.urlopen",
+            side_effect=[server_error, server_error, FakeResponse(200)],
+        ) as urlopen:
+            status, attempts = dispatch.deliver("http://example.test", {"a": 1})
+        self.assertEqual(status, 200)
+        self.assertEqual(len(attempts), 3)
+        self.assertEqual(urlopen.call_count, 3)
+
+    def test_4xx_is_not_retried(self) -> None:
+        client_error = urllib.error.HTTPError("http://example.test", 400, "bad", None, None)
+        with mock.patch(
+            "webhooks.dispatch.urllib.request.urlopen", side_effect=client_error
+        ) as urlopen:
+            with self.assertRaises(dispatch.DeliveryError) as ctx:
+                dispatch.deliver("http://example.test", {"a": 1})
+        self.assertEqual(urlopen.call_count, 1)
+        self.assertEqual(len(ctx.exception.attempts), 1)
+
+    def test_connection_error_retries_up_to_the_limit(self) -> None:
+        connection_error = urllib.error.URLError("timed out")
+        with mock.patch(
+            "webhooks.dispatch.urllib.request.urlopen", side_effect=connection_error
+        ) as urlopen:
+            with self.assertRaises(dispatch.DeliveryError) as ctx:
+                dispatch.deliver("http://example.test", {"a": 1})
+        self.assertEqual(urlopen.call_count, dispatch.MAX_RETRIES + 1)
+        self.assertEqual(len(ctx.exception.attempts), dispatch.MAX_RETRIES + 1)
+
+    def test_backoff_between_retries_is_exponential(self) -> None:
+        connection_error = urllib.error.URLError("timed out")
+        with mock.patch("webhooks.dispatch.urllib.request.urlopen", side_effect=connection_error):
+            with mock.patch("webhooks.dispatch.time.sleep") as sleep:
+                with self.assertRaises(dispatch.DeliveryError):
+                    dispatch.deliver("http://example.test", {"a": 1})
+        sleep.assert_has_calls([mock.call(1), mock.call(2), mock.call(4)])
+
+    def test_signing_token_is_never_logged(self) -> None:
+        with self.assertLogs("webhooks.dispatch", level="INFO") as logs:
+            with mock.patch(
+                "webhooks.dispatch.urllib.request.urlopen", return_value=FakeResponse(200)
+            ):
+                dispatch.deliver("http://example.test", {"a": 1})
+        self.assertNotIn(dispatch.SIGNING_TOKEN, "\n".join(logs.output))
+
+
+if __name__ == "__main__":
+    unittest.main()
