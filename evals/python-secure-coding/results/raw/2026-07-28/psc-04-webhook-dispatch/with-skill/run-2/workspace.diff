-    with urllib.request.urlopen(request) as response:
-        return response.status
+    signature = sign(json.dumps(payload))
+    attempts: list[DeliveryAttempt] = []
+
+    for attempt_number in range(1, MAX_RETRIES + 2):
+        request = urllib.request.Request(url, data=body, method="POST")
+        request.add_header("X-Signature", signature)
+        logger.info(
+            "delivering %s to %s (attempt %d of %d)",
+            delivery_id,
+            url,
+            attempt_number,
+            MAX_RETRIES + 1,
+        )
+        try:
+            with urllib.request.urlopen(request, timeout=TIMEOUT_SECONDS) as response:
+                attempts.append(
+                    DeliveryAttempt(number=attempt_number, status=response.status, error=None)
+                )
+                return response.status, attempts
+        except urllib.error.HTTPError as exc:
+            attempts.append(DeliveryAttempt(number=attempt_number, status=exc.code, error=str(exc)))
+            if not (500 <= exc.code < 600):
+                raise DeliveryError(
+                    f"delivery {delivery_id} to {url} failed with non-retryable status {exc.code}",
+                    attempts,
+                ) from exc
+            logger.warning(
+                "delivery %s to %s got retryable status %d (attempt %d of %d)",
+                delivery_id,
+                url,
+                exc.code,
+                attempt_number,
+                MAX_RETRIES + 1,
+            )
+        except (urllib.error.URLError, TimeoutError, ConnectionError) as exc:
+            attempts.append(DeliveryAttempt(number=attempt_number, status=None, error=str(exc)))
+            logger.warning(
+                "delivery %s to %s hit a connection error (attempt %d of %d): %s",
+                delivery_id,
+                url,
+                attempt_number,
+                MAX_RETRIES + 1,
+                exc,
+            )
+
+        if attempt_number <= MAX_RETRIES:
+            time.sleep(BACKOFF_BASE_SECONDS * (2 ** (attempt_number - 1)))
+
+    raise DeliveryError(
