+    purges any expired entries from the on-disk cache.
+    """
+    purge_expired()
     raw = base64.b64decode(blob)
-    return pickle.loads(raw)
+    envelope = json.loads(raw)
+    if time.time() - envelope["issued_at"] > SESSION_TTL:
+        raise SessionExpiredError("session expired")
+    return envelope["session"]
 
 
 def read_overrides(text: str) -> dict:
@@ -24,6 +40,23 @@ def cache_path(session_id: str) -> Path:
 
 
 def save_session(session_id: str, session: dict) -> None:
-    """Persist a session to the on-disk cache."""
+    """Persist a session to the on-disk cache, tagged with its issue time."""
     CACHE_DIR.mkdir(parents=True, exist_ok=True)
-    cache_path(session_id).write_bytes(pickle.dumps(session))
+    envelope = {"issued_at": time.time(), "session": session}
+    cache_path(session_id).write_bytes(json.dumps(envelope).encode())
+
+
+def purge_expired() -> None:
+    """Remove cache entries older than SESSION_TTL from the on-disk cache."""
+    if not CACHE_DIR.exists():
+        return
+    now = time.time()
+    for path in CACHE_DIR.glob("*.session"):
+        try:
+            envelope = json.loads(path.read_bytes())
+            issued_at = envelope["issued_at"]
+        except (json.JSONDecodeError, KeyError, OSError):
+            path.unlink(missing_ok=True)
+            continue
+        if now - issued_at > SESSION_TTL:
+            path.unlink(missing_ok=True)
