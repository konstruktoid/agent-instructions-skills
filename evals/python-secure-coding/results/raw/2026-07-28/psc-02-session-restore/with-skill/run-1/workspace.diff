 """Restore client sessions from a resume blob."""
 
 import base64
-import pickle
+import json
+import time
 from pathlib import Path
 
 CACHE_DIR = Path("/tmp/sessioncache")
 
+# Maximum age, in seconds, a session may be restored or kept in the cache.
+SESSION_TTL = 3600
+
+
+class SessionExpiredError(ValueError):
+    """Raised when a resume blob or cache entry is older than SESSION_TTL."""
+
 
 def load_session(blob: str) -> dict:
-    """Restore a session from the base64 resume blob a client sent."""
+    """Restore a session from the base64 resume blob a client sent.
