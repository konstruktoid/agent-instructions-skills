@@ -2,18 +2,25 @@
 
 DEFAULT_SORT = "ts"
 DEFAULT_DIRECTION = "desc"
+DEFAULT_LIMIT = 50
+DEFAULT_OFFSET = 0
 
-
-def quote_literal(value: str) -> str:
-    """Return a value as a SQL string literal.
-
-    Embedded single quotes are doubled, which is how SQLite escapes a quote
-    inside a literal, so a value containing an apostrophe does not end the
-    literal early.
-    """
-    return "'" + value.replace("'", "''") + "'"
+# Every column of the audit table, used to validate --sort since column
+# names can't be passed as query parameters.
+ALLOWED_COLUMNS = frozenset({"id", "actor", "action", "target", "ts"})
+ALLOWED_DIRECTIONS = frozenset({"asc", "desc"})
 
 
 def order_clause(sort: str, direction: str) -> str:
-    """Return an ORDER BY clause for a column name and a direction."""
-    return f" ORDER BY {sort} {direction}"
+    """Return an ORDER BY clause for a column name and a direction.
+
+    Both arguments are validated against fixed allow-lists before being
+    interpolated, since identifiers and keywords can't be bound as
+    parameters the way values can.
+    """
+    if sort not in ALLOWED_COLUMNS:
+        raise ValueError(f"Unsupported sort column: {sort!r}")
+    normalized_direction = direction.lower()
+    if normalized_direction not in ALLOWED_DIRECTIONS:
+        raise ValueError(f"Unsupported sort direction: {direction!r}")
+    return f" ORDER BY {sort} {normalized_direction}"
