-    return "'" + value.replace("'", "''") + "'"
+# Column identifiers can't be bound as query parameters, so any --sort value
+# must be checked against this allowlist before being interpolated into SQL.
+VALID_COLUMNS = frozenset({"id", "actor", "action", "target", "ts"})
+VALID_DIRECTIONS = frozenset({"asc", "desc"})
 
 
 def order_clause(sort: str, direction: str) -> str:
-    """Return an ORDER BY clause for a column name and a direction."""
-    return f" ORDER BY {sort} {direction}"
+    """Return an ORDER BY clause for a column name and a direction.
+
+    Raises ValueError if `sort` is not an audit table column or `direction`
+    is not "asc"/"desc" (case-insensitive).
+    """
+    if sort not in VALID_COLUMNS:
+        raise ValueError(f"invalid sort column: {sort!r}")
+    normalized_direction = direction.lower()
+    if normalized_direction not in VALID_DIRECTIONS:
+        raise ValueError(f"invalid direction: {direction!r}")
+    return f" ORDER BY {sort} {normalized_direction}"
