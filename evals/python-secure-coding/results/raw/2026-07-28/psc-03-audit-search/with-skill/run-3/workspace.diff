diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..32b6d8b
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,79 @@
+"""Tests for auditlog.search."""
+
+import pathlib
+import sys
+import tempfile
+import unittest
+
+sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "src"))
+
+from auditlog import search  # noqa: E402
+
+
+class SearchTests(unittest.TestCase):
+    """Cover pagination, the optional action filter, and --since/--sort/--direction."""
+
+    def setUp(self) -> None:
+        tmp_dir = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp_dir.cleanup)
+        original_db_path = search.DB_PATH
+        search.DB_PATH = str(pathlib.Path(tmp_dir.name) / "audit.db")
+        self.addCleanup(setattr, search, "DB_PATH", original_db_path)
+
+        rows = [
+            ("alice", "login", "server-1", "2026-01-01T00:00:00"),
+            ("alice", "logout", "server-1", "2026-01-02T00:00:00"),
+            ("alice", "login", "server-2", "2026-01-03T00:00:00"),
+            ("bob", "login", "server-1", "2026-01-04T00:00:00"),
+        ]
+        with search.connect() as connection:
+            connection.executemany(
+                "INSERT INTO audit (actor, action, target, ts) VALUES (?, ?, ?, ?)", rows
+            )
+
+    def test_action_optional_matches_all_actions_for_actor(self) -> None:
+        rows = search.search("alice")
+        self.assertEqual(len(rows), 3)
+        self.assertTrue(all(row[1] == "alice" for row in rows))
+
+    def test_action_filter_narrows_results(self) -> None:
+        rows = search.search("alice", action="login")
+        self.assertEqual(len(rows), 2)
+        self.assertTrue(all(row[2] == "login" for row in rows))
+
+    def test_since_filters_by_date(self) -> None:
+        rows = search.search("alice", since="2026-01-02")
+        self.assertEqual(len(rows), 2)
+        self.assertTrue(all(row[4] >= "2026-01-02" for row in rows))
+
+    def test_limit_and_offset_paginate(self) -> None:
+        first_page = search.search("alice", sort="ts", direction="asc", limit=2, offset=0)
+        second_page = search.search("alice", sort="ts", direction="asc", limit=2, offset=2)
+        self.assertEqual(
+            [row[4] for row in first_page], ["2026-01-01T00:00:00", "2026-01-02T00:00:00"]
+        )
+        self.assertEqual([row[4] for row in second_page], ["2026-01-03T00:00:00"])
+
+    def test_sort_by_arbitrary_column(self) -> None:
+        rows = search.search("alice", sort="target", direction="desc")
+        self.assertEqual([row[3] for row in rows], ["server-2", "server-1", "server-1"])
+
+    def test_invalid_sort_column_rejected(self) -> None:
+        with self.assertRaises(ValueError):
+            search.search("alice", sort="actor; DROP TABLE audit")
+
+    def test_invalid_direction_rejected(self) -> None:
+        with self.assertRaises(ValueError):
+            search.search("alice", direction="asc; DROP TABLE audit")
+
+    def test_negative_limit_rejected(self) -> None:
+        with self.assertRaises(ValueError):
+            search.search("alice", limit=-1)
+
+    def test_negative_offset_rejected(self) -> None:
+        with self.assertRaises(ValueError):
+            search.search("alice", offset=-1)
+
+
+if __name__ == "__main__":
+    unittest.main()
