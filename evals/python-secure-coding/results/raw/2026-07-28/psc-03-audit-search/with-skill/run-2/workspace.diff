@@ -2,18 +2,26 @@
 
 DEFAULT_SORT = "ts"
 DEFAULT_DIRECTION = "desc"
+DEFAULT_LIMIT = 100
+MAX_LIMIT = 1000
 
-
-def quote_literal(value: str) -> str:
-    """Return a value as a SQL string literal.
-
-    Embedded single quotes are doubled, which is how SQLite escapes a quote
-    inside a literal, so a value containing an apostrophe does not end the
-    literal early.
-    """
-    return "'" + value.replace("'", "''") + "'"
+# The audit table's columns. ORDER BY cannot be parameterized, so a column
+# name and direction are only ever accepted from this allowlist.
+SORTABLE_COLUMNS = frozenset({"id", "actor", "action", "target", "ts"})
+SORT_DIRECTIONS = frozenset({"asc", "desc"})
 
 
 def order_clause(sort: str, direction: str) -> str:
-    """Return an ORDER BY clause for a column name and a direction."""
-    return f" ORDER BY {sort} {direction}"
+    """Return an ORDER BY clause for a column name and a direction.
+
+    Both arguments are validated against a fixed allowlist rather than
+    interpolated as-is, since identifiers cannot be passed as query
+    parameters.
+    """
+    sort_key = sort.lower()
+    direction_key = direction.lower()
+    if sort_key not in SORTABLE_COLUMNS:
+        raise ValueError(f"Unsupported sort column: {sort!r}")
+    if direction_key not in SORT_DIRECTIONS:
+        raise ValueError(f"Unsupported sort direction: {direction!r}")
+    return f" ORDER BY {sort_key} {direction_key}"
