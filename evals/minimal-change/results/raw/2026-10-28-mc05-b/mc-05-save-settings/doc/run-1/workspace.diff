diff --git a/app/settings.py b/app/settings.py
index 62846c9..64724b1 100644
--- a/app/settings.py
+++ b/app/settings.py
@@ -1,6 +1,7 @@
 """Application settings."""
 
 import json
+import os
 
 DEFAULTS = {"theme": "light", "page_size": 25}
 
@@ -9,3 +10,12 @@ def load_settings(path):
     """Return the settings stored at path, with defaults for anything missing."""
     with open(path, encoding="utf-8") as handle:
         return {**DEFAULTS, **json.load(handle)}
+
+
+def save_settings(path, settings):
+    """Write settings to path as JSON, replacing the file only once the write has succeeded."""
+    text = json.dumps(settings, indent=2, sort_keys=True) + "\n"
+    temp_path = f"{path}.tmp"
+    with open(temp_path, "w", encoding="utf-8") as handle:
+        handle.write(text)
+    os.replace(temp_path, path)
