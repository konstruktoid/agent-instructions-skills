diff --git a/app/settings.py b/app/settings.py
index 62846c9..e4f2608 100644
--- a/app/settings.py
+++ b/app/settings.py
@@ -1,6 +1,7 @@
 """Application settings."""
 
 import json
+import os
 
 DEFAULTS = {"theme": "light", "page_size": 25}
 
@@ -9,3 +10,13 @@ def load_settings(path):
     """Return the settings stored at path, with defaults for anything missing."""
     with open(path, encoding="utf-8") as handle:
         return {**DEFAULTS, **json.load(handle)}
+
+
+def save_settings(path, settings):
+    """Write settings to path as indented, key-sorted JSON ending in a newline."""
+    # Write to a sibling file first so a failed write cannot truncate existing settings.
+    temp_path = f"{path}.tmp"
+    with open(temp_path, "w", encoding="utf-8") as handle:
+        json.dump(settings, handle, indent=2, sort_keys=True)
+        handle.write("\n")
+    os.replace(temp_path, path)
