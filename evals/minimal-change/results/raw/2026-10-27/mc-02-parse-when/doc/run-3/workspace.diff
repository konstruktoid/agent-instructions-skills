diff --git a/planner/when.py b/planner/when.py
index 489beeb..49ba522 100644
--- a/planner/when.py
+++ b/planner/when.py
@@ -6,3 +6,15 @@ from datetime import datetime, timezone
 def now_utc():
     """Return the current time as an aware UTC datetime."""
     return datetime.now(timezone.utc)
+
+
+def parse_when(text):
+    """Parse ISO 8601 text into an aware UTC datetime.
+
+    A date alone is midnight UTC. Text with no offset is read as UTC.
+    Raises ValueError when text is not an ISO 8601 date or datetime.
+    """
+    when = datetime.fromisoformat(text)
+    if when.tzinfo is None:
+        when = when.replace(tzinfo=timezone.utc)
+    return when.astimezone(timezone.utc)
