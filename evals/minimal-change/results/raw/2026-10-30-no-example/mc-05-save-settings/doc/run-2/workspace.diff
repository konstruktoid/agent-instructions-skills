+
+
+class SaveTest(unittest.TestCase):
+    def test_writes_sorted_indented_json_with_newline(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = os.path.join(directory, "s.json")
+            save_settings(path, {"b": 1, "a": 2})
+            with open(path, encoding="utf-8") as handle:
+                self.assertEqual(handle.read(), '{\n  "a": 2,\n  "b": 1\n}\n')
+            self.assertEqual(os.listdir(directory), ["s.json"])
