@@ -1,8 +1,19 @@
 import unittest
 
 from audit.checks import check_config
+from audit.defaults import DEFAULTS
 
 
 class ChecksTest(unittest.TestCase):
     def test_disabled_and_stdout(self):
         self.assertEqual(check_config({})[:2], ["AL-1", "AL-2"])
+
+    def test_empty_config_fails_all(self):
+        self.assertEqual(check_config({}), ["AL-1", "AL-2", "AL-3", "AL-4", "AL-5"])
+
+    def test_defaults_pass(self):
+        self.assertEqual(check_config(DEFAULTS), [])
+
+    def test_weak_retention_fields_tamper(self):
+        audit = dict(DEFAULTS["audit"], retention_days=364, fields=["user"], tamper_protection=False)
+        self.assertEqual(check_config({"audit": audit}), ["AL-3", "AL-4", "AL-5"])
