diff --git a/shop/forms.py b/shop/forms.py
index b420666..e5dddd1 100644
--- a/shop/forms.py
+++ b/shop/forms.py
@@ -5,3 +5,17 @@ def handle_add(form, cart):
     """Add one of the sku in form to the cart."""
     sku = form["sku"]
     cart.set_quantity(sku, cart.quantities.get(sku, 0) + 1)
+
+
+def handle_set_quantity(form, cart):
+    """Set the quantity of the sku in form, raising ValueError if it cannot be applied."""
+    try:
+        sku = form["sku"]
+        quantity = int(form["quantity"])
+    except (KeyError, TypeError) as error:
+        raise ValueError("sku and quantity are required") from error
+    if not cart.has_sku(sku):
+        raise ValueError(f"unknown sku: {sku!r}")
+    if quantity < 0:
+        raise ValueError("quantity must not be negative")
+    cart.set_quantity(sku, quantity)
