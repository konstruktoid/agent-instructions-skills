     cart.set_quantity(sku, cart.quantities.get(sku, 0) + 1)
+
+
+def handle_set_quantity(form, cart):
+    """Set the quantity of the sku in form to the quantity in form."""
+    sku = form.get("sku")
+    if not isinstance(sku, str) or not cart.has_sku(sku):
+        raise ValueError(f"unknown sku: {sku!r}")
+    try:
+        quantity = int(form.get("quantity"))
+    except (TypeError, ValueError):
+        raise ValueError("quantity must be an integer") from None
+    if quantity < 0:
+        raise ValueError("quantity must not be negative")
+    cart.set_quantity(sku, quantity)
