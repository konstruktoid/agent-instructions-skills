+
+
+def handle_set_quantity(form, cart):
+    """Set the quantity of the sku in form; raise ValueError if it can't be applied."""
+    sku = form.get("sku")
+    if sku is None or not cart.has_sku(sku):
+        raise ValueError(f"unknown sku: {sku!r}")
+    try:
+        quantity = int(form.get("quantity"))
+    except (TypeError, ValueError):
+        raise ValueError(f"invalid quantity: {form.get('quantity')!r}") from None
+    if quantity < 0:
+        raise ValueError(f"invalid quantity: {quantity}")
+    cart.set_quantity(sku, quantity)
