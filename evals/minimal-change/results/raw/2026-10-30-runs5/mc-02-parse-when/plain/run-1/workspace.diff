@@ -6,3 +6,17 @@ from datetime import datetime, timezone
 def now_utc():
     """Return the current time as an aware UTC datetime."""
     return datetime.now(timezone.utc)
+
+
+def parse_when(text):
+    """Parse ISO 8601 text into an aware UTC datetime.
+
+    A date alone or a datetime without an offset is taken as UTC.
+    Raises ValueError if text is not an ISO 8601 date or datetime.
+    """
+    if text.endswith(("Z", "z")):
+        text = text[:-1] + "+00:00"
+    parsed = datetime.fromisoformat(text)
+    if parsed.tzinfo is None:
+        return parsed.replace(tzinfo=timezone.utc)
+    return parsed.astimezone(timezone.utc)
