diff --git a/planner/when.py b/planner/when.py
index 489beeb..72ef4ee 100644
--- a/planner/when.py
+++ b/planner/when.py
@@ -6,3 +6,15 @@ from datetime import datetime, timezone
 def now_utc():
     """Return the current time as an aware UTC datetime."""
     return datetime.now(timezone.utc)
+
+
+def parse_when(text):
+    """Parse ISO 8601 text into an aware UTC datetime.
+
+    A date alone, or a datetime with no offset, is taken as UTC.
+    Raise ValueError if the text is not an ISO 8601 date or datetime.
+    """
+    parsed = datetime.fromisoformat(text)
+    if parsed.tzinfo is None:
+        return parsed.replace(tzinfo=timezone.utc)
+    return parsed.astimezone(timezone.utc)
