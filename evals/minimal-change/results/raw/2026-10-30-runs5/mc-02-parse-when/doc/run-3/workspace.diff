diff --git a/planner/when.py b/planner/when.py
index 489beeb..8794b5a 100644
--- a/planner/when.py
+++ b/planner/when.py
@@ -6,3 +6,15 @@ from datetime import datetime, timezone
 def now_utc():
     """Return the current time as an aware UTC datetime."""
     return datetime.now(timezone.utc)
+
+
+def parse_when(text):
+    """Parse ISO 8601 text into an aware UTC datetime.
+
+    A date alone means midnight UTC. Raises ValueError if text is not a date.
+    """
+    when = datetime.fromisoformat(text)
+    if when.tzinfo is None:
+        # shortcut: a datetime with no offset is read as UTC, reject it if callers need that to be an error.
+        return when.replace(tzinfo=timezone.utc)
+    return when.astimezone(timezone.utc)
diff --git a/tests/test_when.py b/tests/test_when.py
index 8ada3bc..828920c 100644
--- a/tests/test_when.py
+++ b/tests/test_when.py
@@ -1,8 +1,22 @@
 import unittest
+from datetime import datetime, timedelta, timezone
 
-from planner.when import now_utc
+from planner.when import now_utc, parse_when
 
 
 class NowTest(unittest.TestCase):
     def test_now_is_aware(self):
         self.assertIsNotNone(now_utc().tzinfo)
+
+
+class ParseWhenTest(unittest.TestCase):
+    def test_accepted_forms(self):
+        expected_noon = datetime(2026, 10, 1, 10, tzinfo=timezone.utc)
+        self.assertEqual(parse_when("2026-10-01"), datetime(2026, 10, 1, tzinfo=timezone.utc))
+        self.assertEqual(parse_when("2026-10-01T10:00:00Z"), expected_noon)
+        self.assertEqual(parse_when("2026-10-01T12:00:00+02:00"), expected_noon)
+        self.assertEqual(parse_when("2026-10-01T12:00:00+02:00").utcoffset(), timedelta(0))
+
+    def test_not_a_date_raises(self):
+        with self.assertRaises(ValueError):
+            parse_when("tomorrow")
