diff --git a/shop/forms.py b/shop/forms.py
index b420666..10c3507 100644
--- a/shop/forms.py
+++ b/shop/forms.py
@@ -5,3 +5,15 @@ def handle_add(form, cart):
     """Add one of the sku in form to the cart."""
     sku = form["sku"]
     cart.set_quantity(sku, cart.quantities.get(sku, 0) + 1)
+
+
+def handle_set_quantity(form, cart):
+    """Set the quantity of the sku in form, or raise ValueError and change nothing."""
+    sku = form.get("sku")
+    quantity = form.get("quantity")
+    if sku is None or not cart.has_sku(sku):
+        raise ValueError(f"unknown sku: {sku!r}")
+    # isdecimal alone accepts non-ASCII digits that int() would convert; require ASCII.
+    if quantity is None or not (quantity.isascii() and quantity.isdecimal()):
+        raise ValueError(f"quantity must be a non-negative integer: {quantity!r}")
+    cart.set_quantity(sku, int(quantity))
