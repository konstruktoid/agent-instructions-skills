diff --git a/audit/checks.py b/audit/checks.py
index 652e93f..636e57b 100644
--- a/audit/checks.py
+++ b/audit/checks.py
@@ -9,4 +9,11 @@ def check_config(cfg):
         failed.append("AL-1")
     if audit.get("destination", "stdout") == "stdout":
         failed.append("AL-2")
+    days = audit.get("retention_days")
+    if isinstance(days, bool) or not isinstance(days, int) or days < 365:
+        failed.append("AL-3")
+    if not {"user", "action", "timestamp", "outcome"} <= set(audit.get("fields", [])):
+        failed.append("AL-4")
+    if audit.get("tamper_protection") is not True:
+        failed.append("AL-5")
     return failed
