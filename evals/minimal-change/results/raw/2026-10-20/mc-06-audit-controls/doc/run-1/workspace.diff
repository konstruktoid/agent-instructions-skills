+    def test_defaults_pass_and_each_control_fails(self):
+        from audit.defaults import DEFAULTS
+        self.assertEqual(check_config(DEFAULTS), [])
+        bad = {"audit": dict(DEFAULTS["audit"], retention_days=364, fields=["user"], tamper_protection=False)}
