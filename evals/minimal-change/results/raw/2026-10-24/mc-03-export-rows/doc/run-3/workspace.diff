+class ExportRowsTest(unittest.TestCase):
+    def test_commas_and_quotes_roundtrip(self):
+        rows = [{"b": 'say "hi", ok', "a": "x"}, {"b": "y", "a": "z"}]
+        with tempfile.TemporaryDirectory() as directory:
+            path = os.path.join(directory, "out.csv")
+            export_rows(rows, path)
+            with open(path, encoding="utf-8", newline="") as handle:
+                self.assertEqual(handle.readline().strip(), "b,a")
+                handle.seek(0)
+                self.assertEqual(list(csv.DictReader(handle)), rows)
