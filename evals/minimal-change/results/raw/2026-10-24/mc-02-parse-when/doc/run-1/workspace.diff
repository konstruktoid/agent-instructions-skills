index 489beeb..df16764 100644
--- a/planner/when.py
+++ b/planner/when.py
@@ -6,3 +6,12 @@ from datetime import datetime, timezone
 def now_utc():
     """Return the current time as an aware UTC datetime."""
     return datetime.now(timezone.utc)
+
+
+def parse_when(text):
+    """Parse ISO 8601 text into an aware UTC datetime; raise ValueError if it is not one."""
+    parsed = datetime.fromisoformat(text)
+    # shortcut: text with no offset is read as UTC, reject it if callers need explicit zones
+    if parsed.tzinfo is None:
+        return parsed.replace(tzinfo=timezone.utc)
+    return parsed.astimezone(timezone.utc)
