 """Time helpers for the scheduler."""
 
-from datetime import datetime, timezone
+from datetime import date, datetime, time, timezone
 
 
 def now_utc():
     """Return the current time as an aware UTC datetime."""
     return datetime.now(timezone.utc)
+
+
+def parse_when(text):
+    """Parse ISO 8601 text into an aware UTC datetime.
+
+    Accepts a date (midnight UTC), or a datetime with ``Z`` or an offset.
+    Raises ValueError for anything else, including a datetime with no offset.
+    """
+    try:
+        return datetime.combine(date.fromisoformat(text), time(), timezone.utc)
+    except ValueError:
+        pass
+    parsed = datetime.fromisoformat(text)
+    if parsed.tzinfo is None:
+        raise ValueError(f"missing UTC offset: {text!r}")
+    return parsed.astimezone(timezone.utc)
