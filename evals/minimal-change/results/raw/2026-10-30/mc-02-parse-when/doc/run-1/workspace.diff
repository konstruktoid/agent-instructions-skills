 import unittest
+from datetime import datetime, timedelta, timezone
 
-from planner.when import now_utc
+from planner.when import now_utc, parse_when
 
 
 class NowTest(unittest.TestCase):
     def test_now_is_aware(self):
         self.assertIsNotNone(now_utc().tzinfo)
+
+
+class ParseWhenTest(unittest.TestCase):
+    def test_accepted_forms(self):
+        expected = datetime(2026, 10, 1, 10, tzinfo=timezone.utc)
+        self.assertEqual(parse_when("2026-10-01"), datetime(2026, 10, 1, tzinfo=timezone.utc))
+        self.assertEqual(parse_when("2026-10-01T10:00:00Z"), expected)
+        self.assertEqual(parse_when("2026-10-01T12:00:00+02:00"), expected)
+        self.assertEqual(parse_when("2026-10-01T12:00:00+02:00").utcoffset(), timedelta(0))
+
+    def test_rejects_non_dates(self):
+        for text in ("tomorrow", "", "2026-10-01T12:00:00"):
+            with self.assertRaises(ValueError):
+                parse_when(text)
