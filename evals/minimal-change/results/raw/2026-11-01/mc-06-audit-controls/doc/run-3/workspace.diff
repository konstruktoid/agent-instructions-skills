diff --git a/audit/checks.py b/audit/checks.py
index 652e93f..da575ae 100644
--- a/audit/checks.py
+++ b/audit/checks.py
@@ -9,4 +9,14 @@ def check_config(cfg):
         failed.append("AL-1")
     if audit.get("destination", "stdout") == "stdout":
         failed.append("AL-2")
+    days = audit.get("retention_days")
+    if isinstance(days, bool) or not isinstance(days, int) or days < 365:
+        failed.append("AL-3")
+    fields = audit.get("fields")
+    if not isinstance(fields, (list, tuple, set)) or not {
+        "user", "action", "timestamp", "outcome"
+    } <= set(fields):
+        failed.append("AL-4")
+    if audit.get("tamper_protection") is not True:
+        failed.append("AL-5")
     return failed
