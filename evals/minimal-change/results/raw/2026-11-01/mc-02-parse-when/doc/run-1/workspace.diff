@@ -1,8 +1,22 @@
 import unittest
+from datetime import datetime, timedelta, timezone
 
-from planner.when import now_utc
+from planner.when import now_utc, parse_when
 
 
 class NowTest(unittest.TestCase):
     def test_now_is_aware(self):
         self.assertIsNotNone(now_utc().tzinfo)
+
+
+class ParseWhenTest(unittest.TestCase):
+    def test_forms_normalise_to_utc(self):
+        expected = datetime(2026, 10, 1, tzinfo=timezone.utc)
+        self.assertEqual(parse_when("2026-10-01"), expected)
+        self.assertEqual(parse_when("2026-10-01T00:00:00Z"), expected)
+        self.assertEqual(parse_when("2026-10-01T02:00:00+02:00"), expected)
+        self.assertEqual(parse_when("2026-10-01").utcoffset(), timedelta(0))
+
+    def test_bad_text_raises(self):
+        with self.assertRaises(ValueError):
+            parse_when("not a date")
