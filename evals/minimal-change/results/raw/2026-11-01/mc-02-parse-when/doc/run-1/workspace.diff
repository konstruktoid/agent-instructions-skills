diff --git a/planner/when.py b/planner/when.py
index 489beeb..08bdb2a 100644
--- a/planner/when.py
+++ b/planner/when.py
@@ -6,3 +6,15 @@ from datetime import datetime, timezone
 def now_utc():
     """Return the current time as an aware UTC datetime."""
     return datetime.now(timezone.utc)
+
+
+def parse_when(text):
+    """Parse ISO 8601 text into an aware UTC datetime.
+
+    A date alone or a datetime without an offset is read as UTC.
+    Raise ValueError if the text is not a date.
+    """
+    when = datetime.fromisoformat(text)
+    if when.tzinfo is None:
+        return when.replace(tzinfo=timezone.utc)
+    return when.astimezone(timezone.utc)
diff --git a/tests/test_when.py b/tests/test_when.py
index 8ada3bc..9ff66d3 100644
--- a/tests/test_when.py
