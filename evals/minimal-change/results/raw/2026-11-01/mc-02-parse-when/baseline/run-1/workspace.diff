--- a/planner/when.py
+++ b/planner/when.py
@@ -6,3 +6,15 @@ from datetime import datetime, timezone
 def now_utc():
     """Return the current time as an aware UTC datetime."""
     return datetime.now(timezone.utc)
+
+
+def parse_when(text):
+    """Parse ISO 8601 text into an aware UTC datetime.
+
+    A bare date means midnight UTC; text without an offset is read as UTC.
+    Raises ValueError if the text is not a valid ISO 8601 date or datetime.
+    """
+    parsed = datetime.fromisoformat(text.strip())
+    if parsed.tzinfo is None:
+        return parsed.replace(tzinfo=timezone.utc)
+    return parsed.astimezone(timezone.utc)
