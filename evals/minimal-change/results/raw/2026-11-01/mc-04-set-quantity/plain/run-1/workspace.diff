     cart.set_quantity(sku, cart.quantities.get(sku, 0) + 1)
+
+
+def handle_set_quantity(form, cart):
+    """Set the cart quantity of the sku in form to the given quantity."""
+    try:
+        sku = form["sku"]
+        quantity = int(form["quantity"])
+    except (KeyError, TypeError, ValueError):
+        raise ValueError("invalid sku or quantity")
+    if not cart.has_sku(sku) or quantity < 0:
+        raise ValueError("invalid sku or quantity")
+    cart.set_quantity(sku, quantity)
