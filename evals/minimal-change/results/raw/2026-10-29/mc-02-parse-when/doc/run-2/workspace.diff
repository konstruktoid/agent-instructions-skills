 import unittest
+from datetime import datetime, timezone
 
-from planner.when import now_utc
+from planner.when import now_utc, parse_when
 
 
 class NowTest(unittest.TestCase):
     def test_now_is_aware(self):
         self.assertIsNotNone(now_utc().tzinfo)
+
+
+class ParseWhenTest(unittest.TestCase):
+    def test_accepted_forms(self):
+        utc = timezone.utc
+        self.assertEqual(parse_when("2026-10-01"), datetime(2026, 10, 1, tzinfo=utc))
+        self.assertEqual(parse_when("2026-10-01T12:00:00Z"), datetime(2026, 10, 1, 12, tzinfo=utc))
+        got = parse_when("2026-10-01T12:00:00+02:00")
+        self.assertEqual(got, datetime(2026, 10, 1, 10, tzinfo=utc))
+        self.assertEqual(got.utcoffset().total_seconds(), 0)
+
+    def test_not_a_date(self):
+        with self.assertRaises(ValueError):
+            parse_when("tomorrow")
