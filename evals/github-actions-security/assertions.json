        "source": "task prompt: keeps the GitHub Actions used by the workflows up to date"
      },
      {
        "id": "dependabot-weekly",
        "kind": "workspace_command",
        "command": "grep -q 'weekly' .github/dependabot.y*ml",
        "source": "task prompt: on a weekly schedule"
      },
      {
        "id": "dependabot-grouped",
        "kind": "workspace_command",
        "command": "grep -q 'groups:' .github/dependabot.y*ml",
        "source": "task prompt: grouping the updates into a single pull request"
      },
      {
        "id": "docs-updated",
        "kind": "workspace_command",
        "command": "git diff --name-only \"$EVAL_BASE_SHA\" -- README.md | grep -q README.md",
        "source": "task prompt: explain in the README how action updates are handled"
      }
    ],
