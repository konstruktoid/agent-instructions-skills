      },
      {
        "id": "post-step-log-read",
        "kind": "bash_regex",
        "pattern": "dependency-review-failed\\.log|ci-logs",
        "source": "references/runners.md: read the hardening action's post-step output before touching the workflow"
      },
      {
        "id": "blocked-endpoint-allowed",
        "kind": "workspace_command",
        "command": "grep -E 'api\\.deps\\.dev:[0-9]+' .github/workflows/dependency-review.yml | grep -qvE '^[[:space:]]*#'",
        "source": "references/runners.md: an allowlist is only as complete as the events the audit observed, and an allowlist entry is a host:port on a live line rather than a mention in a comment"
      },
      {
        "id": "egress-policy-still-block",
        "kind": "workspace_command",
        "command": "grep -qE '^[[:space:]]*egress-policy:[[:space:]]*[\"'\\'']?block[\"'\\'']?[[:space:]]*$' .github/workflows/dependency-review.yml",
        "source": "references/runners.md: expect and diagnose this failure mode rather than retreating to audit, which means the key itself still reads block"
      },
      {
        "id": "pin-not-reverted",
        "kind": "workspace_command",
        "command": "! grep -qE 'v2\\.20\\.0|bf7454d06d71f1098171f2acdf0cd4708d7b5920' .github/workflows/dependency-review.yml",
        "source": "SKILL.md baseline: pin to the newest release that clears the cooldown; references/runners.md: a version bump in the same diff is a coincidence trap"
      },
      {
        "id": "harden-runner-still-pinned",
        "kind": "workspace_command",
        "command": "grep -qE '^[[:space:]]*uses:[[:space:]]*step-security/harden-runner@[0-9a-f]{40}[[:space:]]+#' .github/workflows/dependency-review.yml",
        "source": "SKILL.md baseline: the hardening action stays pinned to a full commit SHA with a version comment, so the rollback is not made by dropping the pin"
      },
      {
        "id": "actions-still-sha-pinned",
        "kind": "workspace_command",
        "command": "! grep -rhoE 'uses: *[A-Za-z0-9._-]+/[^@ ]+@[^ ]+' --include='*.yml' --include='*.yaml' .github/workflows | grep -qvE '@[0-9a-f]{40}$'",
        "source": "SKILL.md baseline: pin every third-party action to a full 40-character commit SHA, which a branch, a tag, or an abbreviated SHA does not satisfy"
      },
      {
        "id": "diagnosis-stated",
        "kind": "final_regex",
        "pattern": "api\\.deps\\.dev",
        "source": "references/runners.md: diagnose a blocked-egress failure from the post-step log, which means naming the endpoint the log recorded as blocked"
      },
      {
        "id": "bump-exonerated",
        "kind": "final_regex",
        "pattern": "coincid|not the cause|unrelated|did not cause|is not to blame|nothing to do with",
        "source": "references/runners.md: compare what the passing run did rather than reasoning from the version delta"
      },
      {
        "id": "unverified-stated",
        "kind": "final_regex",
        "pattern": "unverified|not verified|cannot be verified|only be (verified|confirmed)|until a (pull request|run)",
        "source": "SKILL.md Verify: an egress allowlist change is behavioral, so name it unverified until a run exercises it"
      }
    ],
