diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 02a6377..0c87ac1 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -5,15 +5,82 @@ on:
   push:
     branches:
       - main
+    tags:
+      - "v*"
   pull_request:
 
+permissions: {}
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: ${{ github.ref_type != 'tag' }}
+
 jobs:
   build:
+    name: Build
     runs-on: ubuntu-latest
+    timeout-minutes: 10
+    permissions:
+      contents: read
     steps:
-      - uses: actions/checkout@v4
-      - uses: actions/setup-node@v4
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
         with:
           node-version: 20
+          package-manager-cache: false
       - run: npm ci
       - run: npm test
+
+  publish:
+    name: Publish to npm
+    # Only for version tags, and only once the build job has passed.
+    if: github.ref_type == 'tag' && startsWith(github.ref_name, 'v')
+    needs: build
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    permissions:
+      contents: read
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
+        with:
+          node-version: 20
+          package-manager-cache: false
+          registry-url: https://registry.npmjs.org
+      - name: Check the tag matches package.json
+        env:
+          TAG: ${{ github.ref_name }}
+        run: |
+          version="$(node -p "require('./package.json').version")"
+          if [ "$TAG" != "v$version" ]; then
+            echo "Tag $TAG does not match package.json version $version" >&2
+            exit 1
+          fi
+      - run: npm ci
+      - run: npm run build
+      - name: Publish to npm
+        env:
+          NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}
+        # NPM_TOKEN is the requested mechanism; npm trusted publishing would avoid a stored token.
+        run: npm publish
+
+  github-release:
+    name: GitHub release
+    # Separate job so the write-scoped token is never present while the
+    # package is built, and NPM_TOKEN is never present in this job.
+    needs: publish
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    permissions:
+      contents: write # create the GitHub release for the tag
+    steps:
+      - name: Create GitHub release
+        env:
+          GH_TOKEN: ${{ github.token }}
+          GH_REPO: ${{ github.repository }}
+          TAG: ${{ github.ref_name }}
+        run: gh release create "$TAG" --verify-tag --title "$TAG" --generate-notes
diff --git a/README.md b/README.md
index f9aacaf..0f2e4c9 100644
--- a/README.md
+++ b/README.md
@@ -4,5 +4,25 @@ A small Node package.
 
 ## Releasing
 
-Releases are cut by hand: bump the version in `package.json`, tag, and publish from a
-workstation.
+Releases are cut by pushing a version tag; CI does the rest.
+
+1. Bump `version` in `package.json` and merge the change to `main`.
+2. Tag the merge commit and push the tag. The tag must be `v` plus the
+   `package.json` version, for example `v1.5.0`:
+
+   ```sh
+   git tag v1.5.0
+   git push origin v1.5.0
+   ```
+
+3. The `ci` workflow runs on the tag. The `build` job installs and tests the
+   package. Once it passes, the `publish` job checks the tag matches
+   `package.json`, builds the package, and runs `npm publish` using the
+   `NPM_TOKEN` repository secret. After that, the `github-release` job creates
+   a GitHub release for the tag with generated notes.
+
+If `build` or `publish` fails, nothing is released to GitHub. Fix the problem
+and tag a new version; a version already published to npm cannot be reused.
+
+`NPM_TOKEN` must be an npm automation token with publish rights, stored as an
+Actions secret on the repository.
