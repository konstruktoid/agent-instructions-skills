diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 02a6377..424bc1b 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -5,15 +5,71 @@ on:
   push:
     branches:
       - main
+    tags:
+      - "v*"
   pull_request:
 
+permissions: {}
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: ${{ github.ref_type != 'tag' }}
+
 jobs:
   build:
+    name: build
     runs-on: ubuntu-latest
+    timeout-minutes: 10
+    permissions:
+      contents: read
     steps:
-      - uses: actions/checkout@v4
-      - uses: actions/setup-node@v4
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
         with:
           node-version: 20
+          package-manager-cache: false
       - run: npm ci
       - run: npm test
+
+  release:
+    name: release
+    # Runs only for a pushed v* tag, and only once the build job has passed.
+    if: github.ref_type == 'tag' && startsWith(github.ref_name, 'v')
+    needs: build
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    permissions:
+      contents: write # create the GitHub release
+      id-token: write # npm provenance attestation
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+      # No dependency cache: a poisoned cache must not reach a published artifact.
+      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
+        with:
+          node-version: 20
+          package-manager-cache: false
+          registry-url: https://registry.npmjs.org
+      - name: Check the tag matches package.json
+        env:
+          TAG: ${{ github.ref_name }}
+        run: |
+          version="$(node -p "require('./package.json').version")"
+          if [ "$TAG" != "v$version" ]; then
+            echo "Tag $TAG does not match package.json version $version" >&2
+            exit 1
+          fi
+      - run: npm ci
+      - run: npm run build
+      - name: Publish to npm
+        env:
+          NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}
+        run: npm publish --provenance
+      - name: Create GitHub release
+        env:
+          GH_TOKEN: ${{ github.token }}
+          TAG: ${{ github.ref_name }}
+        run: gh release create "$TAG" --verify-tag --generate-notes --title "$TAG"
diff --git a/README.md b/README.md
index f9aacaf..f24dd76 100644
--- a/README.md
+++ b/README.md
@@ -4,5 +4,21 @@ A small Node package.
 
 ## Releasing
 
-Releases are cut by hand: bump the version in `package.json`, tag, and publish from a
-workstation.
+Releases are published by the `release` job in `.github/workflows/ci.yml` when a version tag
+is pushed.
+
+1. Bump `version` in `package.json` and merge the change to `main`.
+2. Tag the merge commit with the same version, prefixed with `v`, and push the tag:
+
+   ```sh
+   git tag v1.5.0
+   git push origin v1.5.0
+   ```
+
+3. The `build` job runs first. Only if it passes does the `release` job run. It checks that the
+   tag matches `package.json`, runs `npm run build`, publishes to npm with provenance, and
+   creates a GitHub release with generated notes.
+
+The job needs an `NPM_TOKEN` repository secret holding an npm automation token that can publish
+`widget`. If a release fails after the npm publish, do not re-push the tag: npm versions cannot
+be republished, so create the GitHub release by hand with `gh release create`.
