diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 02a6377..7295bb8 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -5,15 +5,59 @@ on:
   push:
     branches:
       - main
+    tags:
+      - "v*"
   pull_request:
 
+permissions:
+  contents: read
+
 jobs:
   build:
     runs-on: ubuntu-latest
     steps:
       - uses: actions/checkout@v4
+        with:
+          persist-credentials: false
       - uses: actions/setup-node@v4
         with:
           node-version: 20
       - run: npm ci
       - run: npm test
+
+  release:
+    if: github.event_name == 'push' && startsWith(github.ref, 'refs/tags/v')
+    needs: build
+    runs-on: ubuntu-latest
+    permissions:
+      contents: write # create the GitHub release
+      id-token: write # npm provenance
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          persist-credentials: false
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 20
+          registry-url: https://registry.npmjs.org
+      - name: Check tag matches package.json version
+        env:
+          TAG: ${{ github.ref_name }}
+        run: |
+          version="$(node -p "require('./package.json').version")"
+          if [ "$TAG" != "v$version" ]; then
+            echo "Tag $TAG does not match package.json version $version" >&2
+            exit 1
+          fi
+      - run: npm ci
+      - run: npm run build
+      - name: Publish to npm
+        run: npm publish --provenance --access public
+        env:
+          NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}
+      - name: Create GitHub release
+        run: gh release create "$TAG" --title "$TAG" --generate-notes --verify-tag
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          GH_REPO: ${{ github.repository }}
+          TAG: ${{ github.ref_name }}
diff --git a/README.md b/README.md
index f9aacaf..fc05694 100644
--- a/README.md
+++ b/README.md
@@ -4,5 +4,21 @@ A small Node package.
 
 ## Releasing
 
-Releases are cut by hand: bump the version in `package.json`, tag, and publish from a
-workstation.
+Releases are cut by pushing a version tag; CI does the rest.
+
+1. Bump `version` in `package.json` and merge it to `main`.
+2. Tag the merge commit with the same version, prefixed with `v`, and push the tag:
+
+   ```sh
+   git tag v1.5.0
+   git push origin v1.5.0
+   ```
+
+3. The `release` job in `.github/workflows/` runs for any `v*` tag, after the `build` job
+   (install and tests) has passed. It checks that the tag matches the `package.json`
+   version, builds the package, publishes it to npm, and creates a GitHub release with
+   generated notes.
+
+The workflow needs an `NPM_TOKEN` repository secret (an npm automation token with publish
+rights). If the release fails after the tag is pushed, fix the problem and re-run the
+failed workflow; npm will reject a version that was already published.
