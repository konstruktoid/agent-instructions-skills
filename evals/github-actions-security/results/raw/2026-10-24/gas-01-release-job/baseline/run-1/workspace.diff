+      - "v*"
   pull_request:
 
+permissions:
+  contents: read
+
 jobs:
   build:
     runs-on: ubuntu-latest
@@ -17,3 +22,28 @@ jobs:
           node-version: 20
       - run: npm ci
       - run: npm test
+
+  release:
+    needs: build
+    if: github.event_name == 'push' && startsWith(github.ref, 'refs/tags/v')
+    runs-on: ubuntu-latest
+    permissions:
+      contents: write
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          persist-credentials: false
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 20
+          registry-url: https://registry.npmjs.org
+      - run: npm ci
+      - run: npm run build
+      - run: npm publish
+        env:
+          NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}
+      - run: gh release create "$TAG" --title "$TAG" --generate-notes --verify-tag
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          GH_REPO: ${{ github.repository }}
+          TAG: ${{ github.ref_name }}
diff --git a/README.md b/README.md
index f9aacaf..5fbdee3 100644
--- a/README.md
+++ b/README.md
@@ -4,5 +4,21 @@ A small Node package.
 
 ## Releasing
 
-Releases are cut by hand: bump the version in `package.json`, tag, and publish from a
-workstation.
+Releases are published by the `release` job in `.github/workflows/ci.yml`.
+
+1. Bump the version in `package.json` and merge the change to `main`.
+2. Tag the merge commit with a matching version tag and push it:
+
+   ```sh
+   git tag v1.5.0
+   git push origin v1.5.0
+   ```
+
+3. Pushing a tag that matches `v*` runs the `build` job (install and test). Only if it
+   passes, the `release` job builds the package, publishes it to npm, and creates a
+   GitHub release for the tag with generated notes.
+
+The job authenticates to npm with the `NPM_TOKEN` repository secret, which must be set
+under Settings → Secrets and variables → Actions. The GitHub release uses the
+workflow's built-in `GITHUB_TOKEN`. The `build` job continues to run on pushes to
+`main` and on pull requests; the `release` job never runs for those.
