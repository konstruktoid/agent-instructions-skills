diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 02a6377..02d52e0 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -5,8 +5,13 @@ on:
   push:
     branches:
       - main
+    tags:
+      - "v*"
   pull_request:
 
+permissions:
+  contents: read
+
 jobs:
   build:
     runs-on: ubuntu-latest
@@ -17,3 +22,27 @@ jobs:
           node-version: 20
       - run: npm ci
       - run: npm test
+
+  release:
+    needs: build
+    if: github.event_name == 'push' && startsWith(github.ref, 'refs/tags/v')
+    runs-on: ubuntu-latest
+    permissions:
+      contents: write # create the GitHub release
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 20
+          registry-url: https://registry.npmjs.org
+      - run: npm ci
+      - run: npm run build
+      - name: Publish to npm
+        run: npm publish
+        env:
+          NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}
+      - name: Create GitHub release
+        run: gh release create "$TAG" --title "$TAG" --generate-notes --verify-tag
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          TAG: ${{ github.ref_name }}
diff --git a/README.md b/README.md
index f9aacaf..9c10697 100644
--- a/README.md
+++ b/README.md
@@ -4,5 +4,25 @@ A small Node package.
 
 ## Releasing
 
-Releases are cut by hand: bump the version in `package.json`, tag, and publish from a
-workstation.
+Releases are published automatically by the `release` job in
+`.github/workflows/ci.yml` when a version tag is pushed.
+
+1. Bump the version in `package.json` and merge the change to `main`.
+2. Tag the merge commit with a matching `v*` tag and push it:
+
+   ```sh
+   git tag v1.5.0
+   git push origin v1.5.0
+   ```
+
+3. CI runs the `build` job (install and tests). Only if it passes, the `release` job
+   builds the package, publishes it to npm, and creates a GitHub release for the tag
+   with generated notes.
+
+Requirements:
+
+- The repository needs an `NPM_TOKEN` secret containing an npm automation token with
+  publish rights. It is only exposed to the npm publish step.
+- The tag should match the `version` in `package.json`; npm publishes the version in
+  `package.json`, not the tag name.
+- Pull requests and pushes to `main` run only the `build` job.
