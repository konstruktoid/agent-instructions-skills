diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 02a6377..27eefce 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -5,15 +5,82 @@ on:
   push:
     branches:
       - main
+    tags:
+      - "v*"
   pull_request:
 
+permissions: {}
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: ${{ github.ref_type != 'tag' }}
+
 jobs:
   build:
+    name: Build
     runs-on: ubuntu-latest
+    timeout-minutes: 10
+    permissions:
+      contents: read
     steps:
-      - uses: actions/checkout@v4
-      - uses: actions/setup-node@v4
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
         with:
           node-version: 20
+          package-manager-cache: false  # this workflow also builds release tags
       - run: npm ci
       - run: npm test
+
+  # Publishes to npm. Holds only contents: read; the write token lives in
+  # github-release so package build scripts never run beside it.
+  release:
+    name: Publish to npm
+    if: github.ref_type == 'tag' && startsWith(github.ref_name, 'v')
+    needs: build
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    permissions:
+      contents: read
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+      # No dependency cache: a poisoned cache must not reach a published artifact.
+      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
+        with:
+          node-version: 20
+          registry-url: https://registry.npmjs.org
+          package-manager-cache: false
+      - name: Check tag matches package.json version
+        env:
+          TAG_NAME: ${{ github.ref_name }}
+        run: |
+          version="$(node -p "require('./package.json').version")"
+          if [ "$TAG_NAME" != "v$version" ]; then
+            echo "Tag $TAG_NAME does not match package.json version $version" >&2
+            exit 1
+          fi
+      - run: npm ci
+      - run: npm run build
+      - name: Publish to npm
+        env:
+          NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}
+        run: npm publish
+
+  github-release:
+    name: Create GitHub release
+    if: github.ref_type == 'tag' && startsWith(github.ref_name, 'v')
+    needs: release
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    permissions:
+      contents: write # create the GitHub release for the tag
+    steps:
+      - name: Create GitHub release
+        env:
+          GH_TOKEN: ${{ github.token }}
+          TAG_NAME: ${{ github.ref_name }}
+          REPO: ${{ github.repository }}
+        run: gh release create "$TAG_NAME" --repo "$REPO" --title "$TAG_NAME" --generate-notes --verify-tag
diff --git a/README.md b/README.md
index f9aacaf..b2c98d9 100644
--- a/README.md
+++ b/README.md
@@ -4,5 +4,15 @@ A small Node package.
 
 ## Releasing
 
-Releases are cut by hand: bump the version in `package.json`, tag, and publish from a
-workstation.
+Releases are published by the `release` and `github-release` jobs in
+`.github/workflows/ci.yml` when a version tag is pushed.
+
+1. Bump `version` in `package.json` and merge the change to `main`.
+2. Tag the merge commit and push the tag, for example `git tag v1.5.0 && git push origin v1.5.0`.
+   The tag must be `v` plus the exact `package.json` version, or the release fails.
+3. The `build` job runs first. Only if it passes does `release` build the package and run
+   `npm publish` using the `NPM_TOKEN` repository secret. `github-release` then creates the
+   GitHub release for the tag with generated notes.
+
+`NPM_TOKEN` must be an npm automation or granular publish token stored as an Actions secret.
+A failed publish can be re-run from the Actions tab; npm will reject a version that already exists.
