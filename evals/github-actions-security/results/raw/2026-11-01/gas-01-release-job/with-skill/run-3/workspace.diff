diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 02a6377..5764973 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -5,15 +5,82 @@ on:
   push:
     branches:
       - main
+    tags:
+      - "v*"
   pull_request:
 
+permissions: {}
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  # Never cancel a release in flight; cancel superseded branch and PR runs only.
+  cancel-in-progress: ${{ github.ref_type != 'tag' }}
+
 jobs:
   build:
+    name: Build
     runs-on: ubuntu-latest
+    timeout-minutes: 10
+    permissions:
+      contents: read
     steps:
-      - uses: actions/checkout@v4
-      - uses: actions/setup-node@v4
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
         with:
           node-version: 20
+          package-manager-cache: false
       - run: npm ci
       - run: npm test
+
+  # Publishes to npm. Holds the npm secret but only contents: read on GITHUB_TOKEN.
+  publish:
+    name: Publish to npm
+    if: github.ref_type == 'tag' && startsWith(github.ref, 'refs/tags/v')
+    needs: build
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    permissions:
+      contents: read
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+      # No dependency cache in a publishing job (cache poisoning).
+      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
+        with:
+          node-version: 20
+          registry-url: https://registry.npmjs.org
+          package-manager-cache: false
+      - name: Check the tag matches package.json
+        env:
+          TAG_NAME: ${{ github.ref_name }}
+        run: |
+          version="$(node -p "require('./package.json').version")"
+          if [ "$TAG_NAME" != "v$version" ]; then
+            echo "Tag $TAG_NAME does not match package.json version $version" >&2
+            exit 1
+          fi
+      - run: npm ci
+      - run: npm run build
+      - name: Publish to npm
+        env:
+          NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}
+        run: npm publish
+
+  # Creates the GitHub release. The only job with contents: write; it runs no repository code.
+  github-release:
+    name: GitHub release
+    needs: publish
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    permissions:
+      contents: write # create the release for the tag
+    steps:
+      - name: Create GitHub release
+        env:
+          GH_TOKEN: ${{ github.token }}
+          GH_REPO: ${{ github.repository }}
+          TAG_NAME: ${{ github.ref_name }}
+        run: gh release create "$TAG_NAME" --verify-tag --generate-notes --title "$TAG_NAME"
diff --git a/README.md b/README.md
index f9aacaf..7000488 100644
--- a/README.md
+++ b/README.md
@@ -4,5 +4,21 @@ A small Node package.
 
 ## Releasing
 
-Releases are cut by hand: bump the version in `package.json`, tag, and publish from a
-workstation.
+Releases are published by the `ci` workflow when a version tag is pushed.
+
+1. Bump `version` in `package.json` and merge the change to `main`.
+2. Tag the merge commit with the same version, prefixed with `v`, and push the tag:
+
+   ```sh
+   git tag v1.4.1
+   git push origin v1.4.1
+   ```
+
+3. The workflow runs the `build` job (install and test). Only if it passes does the `publish`
+   job run: it checks the tag matches `package.json`, builds, and runs `npm publish` using the
+   `NPM_TOKEN` repository secret. Finally the `github-release` job creates a GitHub release for the
+   tag with generated notes.
+
+`build` still runs on pushes to `main` and on pull requests; the release jobs run only for tags
+matching `v*`. `NPM_TOKEN` must be an npm automation token with publish rights, stored in the
+repository's Actions secrets. A failed publish can be retried by re-running the workflow run.
