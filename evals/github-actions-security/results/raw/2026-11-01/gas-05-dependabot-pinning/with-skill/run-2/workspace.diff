diff --git a/.github/dependabot.yml b/.github/dependabot.yml
new file mode 100644
index 0000000..aae6071
--- /dev/null
+++ b/.github/dependabot.yml
@@ -0,0 +1,15 @@
+version: 2
+updates:
+  - package-ecosystem: github-actions
+    directory: /
+    schedule:
+      interval: weekly
+    # Wait a week after a release is published before proposing it, so a
+    # malicious release has time to be found and yanked.
+    cooldown:
+      default-days: 7
+    # One pull request per week covering every action update.
+    groups:
+      github-actions:
+        patterns:
+          - "*"
