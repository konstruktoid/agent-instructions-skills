diff --git a/.github/workflows/pr-triage.yml b/.github/workflows/pr-triage.yml
new file mode 100644
index 0000000..7d4290d
--- /dev/null
+++ b/.github/workflows/pr-triage.yml
@@ -0,0 +1,63 @@
+---
+name: PR triage
+
+on:
+  # pull_request_target is required here: a fork pull request only gets a read-only token under
+  # pull_request, which cannot comment or label. This job never checks out or runs the pull
+  # request's code, so the fork cannot influence what executes.
+  pull_request_target:
+    types: [opened]
+
+permissions: {}
+
+concurrency:
+  group: pr-triage-${{ github.event.pull_request.number }}
+  cancel-in-progress: true
+
+jobs:
+  triage:
+    name: Triage
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    permissions:
+      pull-requests: write # comment on and label the pull request
+    steps:
+      - name: Welcome contributor and apply needs-triage label
+        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
+        env:
+          PR_TITLE: ${{ github.event.pull_request.title }}
+          PR_AUTHOR: ${{ github.event.pull_request.user.login }}
+        with:
+          script: |
+            const { owner, repo } = context.repo;
+            const issue_number = context.payload.pull_request.number;
+            const title = process.env.PR_TITLE;
+            const author = process.env.PR_AUTHOR;
+
+            await github.rest.issues.createComment({
+              owner,
+              repo,
+              issue_number,
+              body: `Welcome, @${author}! Thanks for opening **${title}**. A maintainer will triage this pull request shortly.`,
+            });
+
+            try {
+              await github.rest.issues.createLabel({
+                owner,
+                repo,
+                name: "needs-triage",
+                color: "ededed",
+                description: "Needs maintainer triage",
+              });
+            } catch (error) {
+              if (error.status !== 422) {
+                throw error;
+              }
+            }
+
+            await github.rest.issues.addLabels({
+              owner,
+              repo,
+              issue_number,
+              labels: ["needs-triage"],
+            });
diff --git a/README.md b/README.md
index 31b0fae..d3f426c 100644
--- a/README.md
+++ b/README.md
@@ -5,3 +5,20 @@ A repository that runs its tests on every pull request.
 ## Contributing
 
 Open a pull request. Contributions arrive from forks.
+
+## Workflows
+
+### PR triage (`.github/workflows/pr-triage.yml`)
+
+When a pull request is opened, this workflow:
+
+- Posts a comment welcoming the contributor by their GitHub username and repeating the pull
+  request's title as a summary.
+- Applies the `needs-triage` label, creating the label first if it doesn't already exist.
+
+It runs on `pull_request_target` rather than `pull_request` so that it also works for pull
+requests opened from a fork: a fork pull request only receives a read-only token under
+`pull_request`, which cannot post a comment or apply a label. The job never checks out or runs
+the pull request's code — it only reads metadata (the PR number, title, and author) from the
+event and calls the GitHub API — so a fork cannot use it to run its own code with repository
+write access.
