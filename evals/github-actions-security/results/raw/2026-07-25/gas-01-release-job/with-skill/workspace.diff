diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 02a6377..c9da04a 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -5,15 +5,72 @@ on:
   push:
     branches:
       - main
+    tags:
+      - 'v*'
   pull_request:
 
+permissions: {}
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
 jobs:
   build:
+    name: Build
     runs-on: ubuntu-latest
+    timeout-minutes: 10
+    permissions:
+      contents: read # checkout the repository
     steps:
-      - uses: actions/checkout@v4
-      - uses: actions/setup-node@v4
+      - name: Checkout repository
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+
+      - name: Set up Node.js
+        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
         with:
           node-version: 20
+          package-manager-cache: false # no lockfile cache key to scope caching to; avoid cache poisoning across branches
+
       - run: npm ci
       - run: npm test
+
+  release:
+    name: Release
+    needs: build
+    if: startsWith(github.ref, 'refs/tags/v')
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    permissions:
+      contents: write # create the GitHub release for the tag
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+
+      - name: Set up Node.js
+        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
+        with:
+          node-version: 20
+          registry-url: 'https://registry.npmjs.org'
+          package-manager-cache: false # no lockfile cache key to scope caching to; avoid cache poisoning across branches
+
+      - run: npm ci
+      - run: npm run build
+
+      - name: Publish to npm
+        # Publishing with a long-lived NPM_TOKEN secret rather than OIDC trusted
+        # publishing, since this package's npm configuration is not yet set up
+        # for trusted publishing.
+        run: npm publish
+        env:
+          NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}
+
+      - name: Create GitHub release
+        env:
+          GH_TOKEN: ${{ github.token }}
+          TAG: ${{ github.ref_name }}
+        run: gh release create "$TAG" --generate-notes
diff --git a/README.md b/README.md
index f9aacaf..1c551fe 100644
--- a/README.md
+++ b/README.md
@@ -4,5 +4,13 @@ A small Node package.
 
 ## Releasing
 
-Releases are cut by hand: bump the version in `package.json`, tag, and publish from a
-workstation.
+Releases are automated via CI. To cut a release:
+
+1. Bump the version in `package.json` and commit the change.
+2. Tag the commit with a `v`-prefixed version, e.g. `git tag v1.5.0`, and push the tag:
+   `git push origin v1.5.0`.
+
+Pushing a tag matching `v*` triggers the `release` job in the `ci` workflow. That job only
+runs after the `build` job (tests) has passed for the same push, and then it builds the
+package, publishes it to npm using the `NPM_TOKEN` repository secret, and creates a GitHub
+release for the tag.
