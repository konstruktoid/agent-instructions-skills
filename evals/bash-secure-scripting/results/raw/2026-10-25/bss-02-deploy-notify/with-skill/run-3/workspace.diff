 #!/bin/bash
 # Restart a service on the deploy host and announce the release.
+#
+# Usage: notify-deploy.sh [--dry-run] SERVICE VERSION [NOTE]
 
-set -e
+set -Eeuo pipefail
+shopt -s inherit_errexit
 
-SERVICE=$1
-VERSION=$2
+PATH='/usr/local/bin:/usr/bin:/bin'
+export PATH
+export LC_ALL=C
 
-REMOTE_HOST=deploy@deploy.example.internal
-SLACK_URL=$SLACK_WEBHOOK_URL
+readonly PROGNAME="${0##*/}"
+SCRIPT_DIR="$(cd -- "${BASH_SOURCE[0]%/*}" && pwd -P)"
+readonly SCRIPT_DIR
+readonly REMOTE_HOST='deploy@deploy.example.internal'
+readonly SERVICE_PATTERN='^[a-z][a-z0-9_]{0,63}$'
+readonly VERSION_PATTERN='^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$'
+readonly NOTE_MAX=500
 
-. etc/services.conf
+err() {
+  printf '%s: %s\n' "${PROGNAME}" "$*" >&2
+}
 
-# Per-service override, for example CONFIG_web=/etc/web/deploy.conf
-eval "CONFIG=\$CONFIG_$SERVICE"
+die() {
+  local status="$1"
+  shift
+  err "$*"
+  exit "${status}"
+}
 
-echo "deploying $SERVICE $VERSION with $CONFIG"
+usage() {
+  printf 'usage: %s [--dry-run] SERVICE VERSION [NOTE]\n' "${PROGNAME}" >&2
+}
 
-ssh $REMOTE_HOST "sudo systemctl restart $SERVICE && /usr/local/bin/deploy $SERVICE $VERSION"
+# Builds the Slack payload from validated pieces; jq does the JSON escaping.
+# Arguments: service, version, deployer, note (may be empty)
+build_payload() {
+  jq -n -c --arg service "$1" --arg version "$2" --arg user "$3" --arg note "$4" \
+    '{text: ("Deployed " + $service + " " + $version + " by " + $user
+             + (if $note == "" then "" else "\n" + $note end))}'
+}
 
-curl -s -X POST -H 'Content-type: application/json' \
-  -d "{\"text\": \"Deployed $SERVICE $VERSION by $USER\"}" $SLACK_URL
+main() {
+  local dry_run=false
+  local -a args=()
+  local arg
+  for arg in "$@"; do
+    case ${arg} in
+      --dry-run) dry_run=true ;;
+      -h | --help)
+        usage
+        return 0
+        ;;
+      *) args+=("${arg}") ;;
+    esac
+  done
+
+  if ((${#args[@]} < 2 || ${#args[@]} > 3)); then
+    usage
+    return 64
+  fi
+
+  local service="${args[0]}"
+  local version="${args[1]}"
+  local note="${args[2]:-}"
+  local user="${USER:-unknown}"
+
+  [[ ${service} =~ ${SERVICE_PATTERN} ]] || die 65 "invalid service name: ${service}"
+  [[ ${version} =~ ${VERSION_PATTERN} ]] || die 65 "invalid version: ${version}"
+  if ((${#note} > NOTE_MAX)); then
+    die 65 "release note is longer than ${NOTE_MAX} characters"
+  fi
+  if [[ ${note} =~ [[:cntrl:]] ]]; then
+    die 65 "release note contains control characters"
+  fi
+  [[ ${user} =~ ^[A-Za-z0-9._-]+$ ]] || user='unknown'
+
+  # shellcheck source=etc/services.conf
+  . "${SCRIPT_DIR}/../etc/services.conf"
+
+  # Per-service override, for example CONFIG_web=/etc/web/deploy.conf
+  local config_var="CONFIG_${service}"
+  local config="${!config_var:-}"
+
+  local remote_cmd="sudo systemctl restart ${service} && /usr/local/bin/deploy ${service} ${version}"
+  local payload
+  payload="$(build_payload "${service}" "${version}" "${user}" "${note}")"
+
+  echo "deploying ${service} ${version} with ${config:-<no config>}"
+
+  if [[ ${dry_run} == true ]]; then
+    printf 'dry run: nothing will be restarted or posted\n'
+    printf 'would run: ssh -- %s %s\n' "${REMOTE_HOST}" "${remote_cmd}"
+    local webhook_state='SLACK_WEBHOOK_URL is NOT set'
+    if [[ -n ${SLACK_WEBHOOK_URL:-} ]]; then
+      webhook_state='SLACK_WEBHOOK_URL is set'
+    fi
+    printf 'would post to Slack (%s): %s\n' "${webhook_state}" "${payload}"
+    return 0
+  fi
+
+  [[ -n ${SLACK_WEBHOOK_URL:-} ]] || die 78 "SLACK_WEBHOOK_URL is not set"
+
+  ssh -- "${REMOTE_HOST}" "${remote_cmd}"
+
+  # The webhook URL is a credential: give it to curl on stdin, not in argv.
+  printf 'url = "%s"\n' "${SLACK_WEBHOOK_URL}" |
+    curl --silent --show-error --fail --config - \
+      --request POST --header 'Content-type: application/json' --data "${payload}"
+  echo
+}
+
+main "$@"
