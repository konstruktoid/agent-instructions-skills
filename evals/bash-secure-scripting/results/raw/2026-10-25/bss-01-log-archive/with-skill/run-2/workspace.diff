diff --git a/bin/archive-logs.sh b/bin/archive-logs.sh
index d6e0cf6..1759e51 100755
--- a/bin/archive-logs.sh
+++ b/bin/archive-logs.sh
@@ -1,16 +1,164 @@
 #!/bin/bash
-# Archive the logs of one service into the retention directory.
+# Archive the logs of one or more services into the retention directory and
+# optionally prune archives older than a number of days.
+#
+# Usage: archive-logs.sh [--keep-days N] SERVICE [SERVICE...]
+#
+# Requires Bash 4.4 or later (inherit_errexit) and GNU find/date.
 
-LOG_ROOT=logs
-RETENTION_DIR=archives
-SERVICE=$1
+set -Eeuo pipefail
+shopt -s inherit_errexit
 
-TMP=/tmp/archive-logs.$$
-mkdir $TMP
+# Runs from cron: do not trust the caller's environment.
+PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
+export PATH
+export LC_ALL=C
+umask 077
 
-tar czf $TMP/$SERVICE.tar.gz $LOG_ROOT/$SERVICE
-mv $TMP/$SERVICE.tar.gz $RETENTION_DIR/$SERVICE-`date +%Y%m%d`.tar.gz
+readonly PROGNAME="${0##*/}"
+readonly LOG_ROOT=logs
+readonly RETENTION_DIR=archives
+readonly SERVICE_PATTERN='^[a-z0-9][a-z0-9_-]{0,63}$'
+readonly DAYS_PATTERN='^[0-9]{1,5}$'
 
-rm -rf $TMP/*
+# Script scope, not local to main: the EXIT trap runs after main has returned.
+workdir=''
 
-echo "archived $SERVICE"
+err() {
+  printf '%s: %s\n' "${PROGNAME}" "$*" >&2
+}
+
+cleanup() {
+  if [[ -n ${workdir} && -d ${workdir} ]]; then
+    rm -rf -- "${workdir}"
+  fi
+  return 0
+}
+
+# Clean up, then die of the signal so the caller sees 128+n.
+on_signal() {
+  local sig="$1"
+  cleanup
+  trap - EXIT "${sig}"
+  kill -s "${sig}" -- "$$"
+}
+
+usage() {
+  err "usage: ${PROGNAME} [--keep-days N] SERVICE [SERVICE...]"
+}
+
+# Archives the logs of one service into the retention directory.
+# Globals: LOG_ROOT, RETENTION_DIR, workdir
+# Arguments: a validated service name, the date stamp (YYYYMMDD)
+archive_service() {
+  local service="$1"
+  local stamp="$2"
+
+  tar --create --gzip --file "${workdir}/${service}.tar.gz" \
+    -- "${LOG_ROOT}/${service}"
+  mv -f -- "${workdir}/${service}.tar.gz" \
+    "${RETENTION_DIR}/${service}-${stamp}.tar.gz"
+}
+
+# Removes dated archives older than the given number of days.
+# Only regular files directly inside RETENTION_DIR named SERVICE-YYYYMMDD.tar.gz
+# are considered.
+# Globals: RETENTION_DIR
+# Arguments: number of days
+# Stdout: the number of archives removed
+prune_archives() {
+  local days="$1"
+  local file
+  local removed=0
+
+  while IFS= read -r -d '' file; do
+    rm -f -- "${file}"
+    removed=$((removed + 1))
+  done < <(find "${RETENTION_DIR}" -xdev -mindepth 1 -maxdepth 1 -type f \
+    -regextype posix-extended \
+    -regex '.*/[a-z0-9][a-z0-9_-]*-[0-9]{8}\.tar\.gz' \
+    -mtime "+${days}" -print0)
+
+  printf '%s\n' "${removed}"
+}
+
+main() {
+  local keep_days=''
+  local service stamp removed
+  local -a services=()
+
+  while (($# > 0)); do
+    case "$1" in
+      --keep-days)
+        if (($# < 2)); then
+          err "--keep-days needs a value"
+          usage
+          return 64
+        fi
+        keep_days="$2"
+        shift 2
+        ;;
+      --keep-days=*)
+        keep_days="${1#--keep-days=}"
+        shift
+        ;;
+      -h | --help)
+        usage
+        return 0
+        ;;
+      --)
+        shift
+        break
+        ;;
+      -*)
+        err "unknown option: $1"
+        usage
+        return 64
+        ;;
+      *)
+        break
+        ;;
+    esac
+  done
+  services=("$@")
+
+  if ((${#services[@]} == 0)); then
+    usage
+    return 64
+  fi
+  if [[ -n ${keep_days} && ! ${keep_days} =~ ${DAYS_PATTERN} ]]; then
+    err "--keep-days must be a whole number of days: ${keep_days}"
+    return 65
+  fi
+  # Validate every name before touching anything.
+  for service in "${services[@]}"; do
+    if [[ ! ${service} =~ ${SERVICE_PATTERN} ]]; then
+      err "invalid service name: ${service}"
+      return 65
+    fi
+  done
+
+  # Trap first, so a signal between mktemp and the trap cannot leak the directory.
+  trap cleanup EXIT
+  trap 'on_signal INT' INT
+  trap 'on_signal TERM' TERM
+  # Inside RETENTION_DIR so the final mv is an atomic rename.
+  workdir="$(mktemp -d -- "${RETENTION_DIR}/.archive-logs.XXXXXX")"
+
+  stamp="$(date -u +%Y%m%d)"
+  for service in "${services[@]}"; do
+    archive_service "${service}" "${stamp}"
+  done
+
+  # Reached only if every archive succeeded (errexit), so old archives are never
+  # removed when the new ones are not in place.
+  if [[ -n ${keep_days} ]]; then
+    removed="$(prune_archives "${keep_days}")"
+    printf 'archived %d service(s): %s; pruned %d archive(s) older than %d day(s)\n' \
+      "${#services[@]}" "${services[*]}" "${removed}" "$((10#${keep_days}))"
+  else
+    printf 'archived %d service(s): %s\n' "${#services[@]}" "${services[*]}"
+  fi
+}
+
+main "$@"
