diff --git a/bin/archive-logs.sh b/bin/archive-logs.sh
index d6e0cf6..079f71c 100755
--- a/bin/archive-logs.sh
+++ b/bin/archive-logs.sh
@@ -1,16 +1,182 @@
 #!/bin/bash
-# Archive the logs of one service into the retention directory.
+# Archive the logs of one or more services into the retention directory, and
+# optionally prune archives older than a given number of days.
+#
+# Requires Bash 4.4 or later (inherit_errexit) and GNU find and tar.
 
-LOG_ROOT=logs
-RETENTION_DIR=archives
-SERVICE=$1
+set -Eeuo pipefail
+shopt -s inherit_errexit
 
-TMP=/tmp/archive-logs.$$
-mkdir $TMP
+# Runs from cron: do not trust the caller's environment.
+PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
+export PATH
+export LC_ALL=C
+umask 027
 
-tar czf $TMP/$SERVICE.tar.gz $LOG_ROOT/$SERVICE
-mv $TMP/$SERVICE.tar.gz $RETENTION_DIR/$SERVICE-`date +%Y%m%d`.tar.gz
+readonly PROGNAME="${0##*/}"
+# Relative to the working directory, as before: cron starts the job in the
+# repository directory.
+readonly LOG_ROOT=logs
+readonly RETENTION_DIR=archives
+readonly SERVICE_PATTERN='^[a-z0-9][a-z0-9_-]{0,63}$'
+readonly DAYS_PATTERN='^[1-9][0-9]{0,4}$'
 
-rm -rf $TMP/*
+# Script scope, not local to main: the EXIT trap runs after main has returned.
+workdir=''
 
-echo "archived $SERVICE"
+err() {
+  printf '%s: %s\n' "${PROGNAME}" "$*" >&2
+}
+
+usage() {
+  printf 'usage: %s [--keep-days N] SERVICE [SERVICE...]\n' "${PROGNAME}" >&2
+}
+
+cleanup() {
+  if [[ -n ${workdir} && -d ${workdir} ]]; then
+    rm -rf -- "${workdir}"
+  fi
+  return 0
+}
+
+# Clean up, then die of the signal so the caller sees 128+n.
+on_signal() {
+  local sig="$1"
+  cleanup
+  trap - EXIT "${sig}"
+  kill -s "${sig}" -- "$$"
+}
+
+# Archives logs/SERVICE as archives/SERVICE-YYYYMMDD.tar.gz. The tarball is
+# built in the work directory, inside the retention directory, and moved into
+# place so a reader never sees a partial archive.
+# Globals: LOG_ROOT, RETENTION_DIR, workdir
+# Arguments: a service name already validated against SERVICE_PATTERN
+# Returns: 0 on success, 1 if the log directory is missing or tar fails
+archive_service() {
+  local service="$1"
+  local stamp
+
+  if [[ ! -d ${LOG_ROOT}/${service} ]]; then
+    err "no log directory for ${service}"
+    return 1
+  fi
+
+  stamp="$(date -u +%Y%m%d)"
+  tar --create --gzip --file "${workdir}/${service}.tar.gz" \
+    -- "${LOG_ROOT}/${service}" || return 1
+  mv -- "${workdir}/${service}.tar.gz" \
+    "${RETENTION_DIR}/${service}-${stamp}.tar.gz"
+}
+
+# Removes archives this script produced (SERVICE-YYYYMMDD.tar.gz, regular files
+# directly in the retention directory) whose mtime is more than N days old.
+# Globals: RETENTION_DIR
+# Arguments: N, already validated against DAYS_PATTERN
+# Output: the number of archives removed, on stdout
+prune_archives() {
+  local days="$1"
+  local count=0
+  local file
+
+  while IFS= read -r -d '' file; do
+    rm -f -- "${file}"
+    count=$((count + 1))
+  done < <(find "${RETENTION_DIR}" -maxdepth 1 -type f \
+    -name '*-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9].tar.gz' \
+    -mtime "+${days}" -print0)
+
+  printf '%d\n' "${count}"
+}
+
+main() {
+  local keep_days=''
+  local service
+  local pruned
+  local -A seen=()
+  local -a services=()
+  local -a done_services=()
+  local -a failed=()
+
+  while (($# > 0)); do
+    case $1 in
+      --keep-days)
+        if (($# < 2)); then
+          err "--keep-days needs a value"
+          usage
+          return 64
+        fi
+        keep_days="$2"
+        shift 2
+        ;;
+      -h | --help)
+        usage
+        return 0
+        ;;
+      --)
+        shift
+        break
+        ;;
+      -*)
+        err "unknown option: $1"
+        usage
+        return 64
+        ;;
+      *) break ;;
+    esac
+  done
+
+  if (($# == 0)); then
+    err "at least one SERVICE is required"
+    usage
+    return 64
+  fi
+
+  if [[ -n ${keep_days} && ! ${keep_days} =~ ${DAYS_PATTERN} ]]; then
+    err "--keep-days must be a positive integer: ${keep_days}"
+    return 65
+  fi
+
+  # Validate every name before touching anything, and drop duplicates.
+  for service in "$@"; do
+    if [[ ! ${service} =~ ${SERVICE_PATTERN} ]]; then
+      err "invalid service name: ${service}"
+      return 65
+    fi
+    if [[ -z ${seen[${service}]:-} ]]; then
+      seen[${service}]=1
+      services+=("${service}")
+    fi
+  done
+
+  # Traps first: cleanup tolerates the empty workdir until mktemp assigns it.
+  trap cleanup EXIT
+  trap 'on_signal INT' INT
+  trap 'on_signal TERM' TERM
+  workdir="$(mktemp -d -- "${RETENTION_DIR}/.archive-logs.XXXXXXXX")"
+
+  for service in "${services[@]}"; do
+    if archive_service "${service}"; then
+      done_services+=("${service}")
+    else
+      failed+=("${service}")
+    fi
+  done
+
+  # Fail closed: never delete old archives when a new one is missing.
+  if ((${#failed[@]} > 0)); then
+    err "failed to archive: ${failed[*]}; nothing was pruned"
+    return 1
+  fi
+
+  if [[ -n ${keep_days} ]]; then
+    pruned="$(prune_archives "${keep_days}")"
+    printf 'archived %d service(s): %s; pruned %d archive(s) older than %d day(s)\n' \
+      "${#done_services[@]}" "${done_services[*]}" "${pruned}" "${keep_days}"
+  else
+    printf 'archived %d service(s): %s\n' \
+      "${#done_services[@]}" "${done_services[*]}"
+  fi
+}
+
+main "$@"
