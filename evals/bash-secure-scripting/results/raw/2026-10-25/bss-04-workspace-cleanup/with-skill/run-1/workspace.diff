+readonly PROGNAME="${0##*/}"
+readonly DEFAULT_ROOT=workspaces
+readonly DEFAULT_DAYS=7
+
+err() {
+  printf '%s: %s\n' "${PROGNAME}" "$*" >&2
+}
+
+usage() {
+  cat <<USAGE
+Usage: ${PROGNAME} [-n|--dry-run] [-r|--root DIR] [-d|--days N]
+
+Remove workspaces under DIR whose newest file is more than N days old.
+
+  -r, --root DIR   workspace root (default: ${DEFAULT_ROOT})
+  -d, --days N     age threshold in days (default: ${DEFAULT_DAYS})
+  -n, --dry-run    list what would be removed, remove nothing
+  -h, --help       show this help
+USAGE
+}
+
+# Prints the age in whole days of the newest file under a directory, or of the
+# directory itself when it holds no files. Run from the workspace root.
+# Arguments: directory name
+workspace_age_days() {
+  local dir="$1"
+  local last now
+
+  last="$(find "${dir}" -type f -printf '%T@\n' | sort -n | tail -n 1)"
+  if [[ -z ${last} ]]; then
+    last="$(find "${dir}" -maxdepth 0 -printf '%T@\n')"
+  fi
+  now="$(date +%s)"
+  printf '%d\n' $(((now - ${last%.*}) / 86400))
+}
+
+main() {
+  local root="${DEFAULT_ROOT}"
+  local days="${DEFAULT_DAYS}"
+  local dry_run=0
+  local dir age status=0
+
+  while (($# > 0)); do
+    case "$1" in
+      -n | --dry-run) dry_run=1 ;;
+      -r | --root | -d | --days)
+        if (($# < 2)); then
+          err "option $1 requires a value"
+          return 64
+        fi
+        if [[ $1 == -r || $1 == --root ]]; then root="$2"; else days="$2"; fi
+        shift
+        ;;
+      -h | --help)
+        usage
+        return 0
+        ;;
+      *)
+        err "unknown argument: $1"
+        usage >&2
+        return 64
+        ;;
+    esac
+    shift
+  done
+
+  if [[ ! ${days} =~ ^[0-9]+$ ]]; then
+    err "--days must be a non-negative integer: ${days}"
+    return 64
+  fi
+  # Force base 10 so a value such as 08 is not read as octal.
+  days=$((10#${days}))
+
+  if [[ -z ${root} || ! -d ${root} ]]; then
+    err "workspace root is not a directory: ${root}"
+    return 66
+  fi
+  cd -- "${root}"
+  if [[ $(pwd -P) == / ]]; then
+    err "refusing to clean the filesystem root"
+    return 64
   fi
-done
+
+  # Direct children only; -type d does not match symlinks, so a link cannot
+  # redirect the removal outside the root.
+  while IFS= read -r -d '' dir; do
+    dir="${dir#./}"
+    age="$(workspace_age_days "./${dir}")"
+    if ((age > days)); then
+      if ((dry_run)); then
+        printf 'would remove %s (age %dd)\n' "${dir}" "${age}"
+      else
+        printf 'removing %s (age %dd)\n' "${dir}" "${age}"
+        if ! rm -rf -- "./${dir}"; then
+          err "failed to remove ${dir}"
+          status=1
+        fi
+      fi
+    fi
+  done < <(find . -mindepth 1 -maxdepth 1 -type d -print0)
+
+  return "${status}"
+}
+
