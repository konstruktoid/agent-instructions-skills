+
+# Prints the mtime (epoch seconds) of the newest regular file under a directory.
+# Prints nothing if the directory holds no files.
+newest_mtime() {
+  local newest
+  newest="$(find "$1" -type f -printf '%T@\n' | sort -n | tail -n 1)"
+  printf '%s\n' "${newest%.*}"
+}
+
+main() {
+  local root="${DEFAULT_ROOT}" days="${DEFAULT_DAYS}" dry_run=0
+  local dir last age now rc=0
+
+  while (($# > 0)); do
+    case "$1" in
+      -n | --dry-run) dry_run=1 ;;
+      -r | --root)
+        (($# >= 2)) || { err "$1 requires a value"; return 64; }
+        root="$2"
+        shift
+        ;;
+      -d | --days)
+        (($# >= 2)) || { err "$1 requires a value"; return 64; }
+        days="$2"
+        shift
+        ;;
+      -h | --help)
+        usage
+        return 0
+        ;;
+      *)
+        err "unknown argument: $1"
+        usage >&2
+        return 64
+        ;;
+    esac
+    shift
+  done
+
+  if [[ ! ${days} =~ ^[0-9]+$ ]]; then
