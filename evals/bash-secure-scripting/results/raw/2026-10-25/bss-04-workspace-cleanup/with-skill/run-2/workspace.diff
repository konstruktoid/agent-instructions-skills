+    return 64
   fi
-done
+  # Force base 10 so a leading zero is not read as octal.
+  days=$((10#${days}))
+
+  if [[ -z ${root} ]]; then
+    err "--root must not be empty"
+    return 64
+  fi
+  root="$(realpath -e -- "${root}")" || { err "cannot resolve root"; return 66; }
+  if [[ ! -d ${root} ]]; then
+    err "not a directory: ${root}"
+    return 66
+  fi
+  if [[ ${root} == / ]]; then
+    err "refusing to use / as the workspace root"
+    return 64
+  fi
+
+  now="$(date +%s)"
+
+  # Only real directories directly under the root; symlinks are never followed.
+  while IFS= read -r -d '' dir; do
+    last="$(newest_mtime "${dir}")"
+    if [[ -z ${last} ]]; then
+      err "skipping ${dir}: no files to take an age from"
+      continue
+    fi
+    age=$(((now - last) / 86400))
+    if ((age > days)); then
+      if ((dry_run)); then
+        printf 'would remove %s (age %dd)\n' "${dir}" "${age}"
+      else
+        printf 'removing %s (age %dd)\n' "${dir}" "${age}"
+        if ! rm -rf -- "${dir}"; then
+          err "failed to remove ${dir}"
+          rc=1
+        fi
+      fi
+    fi
+  done < <(find "${root}" -mindepth 1 -maxdepth 1 -type d -print0)
+
+  return "${rc}"
+}
+
+main "$@"
