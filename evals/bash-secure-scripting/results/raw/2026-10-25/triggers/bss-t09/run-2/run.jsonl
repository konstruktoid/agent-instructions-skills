n in order and stop at the first failure, so the upload only happens after the tests pass. Ideally, pin both actions to full commit SHAs rather than `@v4`.\n\nIf you tell me your build and test commands and the output path, or let me edit files, I'll write the full workflow with both fixes included."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":290,"cache_read_input_tokens":12387,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":290},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"25b42164-3340-4fab-afbc-00c8c0678c78","uuid":"849217a5-603d-4ad9-ab30-9f3061de269a","timestamp":"2026-10-25T18:04:33.095Z","request_id":"req_011CgPPzE9bxFY1wQ6y79EAT"}
