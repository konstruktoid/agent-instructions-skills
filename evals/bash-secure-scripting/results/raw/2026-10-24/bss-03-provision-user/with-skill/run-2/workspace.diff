diff --git a/sbin/provision-user.sh b/sbin/provision-user.sh
index 3427aa2..5720bbf 100755
--- a/sbin/provision-user.sh
+++ b/sbin/provision-user.sh
@@ -1,16 +1,201 @@
 #!/bin/bash
-# Create an application account and its database user.
+#
+# Create application accounts and their database users.
+#
+# Usage: provision-user.sh [--shell SHELL] [--from-file FILE] [USERNAME ...]
 
-. etc/db.conf
+set -Eeuo pipefail
+shopt -s inherit_errexit
 
-USERNAME=$1
+# Runs as root from cron: do not trust the caller's environment.
+PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
+export PATH
+export LC_ALL=C
+export TMPDIR=/var/tmp
+umask 077
 
-useradd -m $USERNAME
+readonly PROGNAME="${0##*/}"
+SCRIPT_DIR="$(cd -- "${BASH_SOURCE[0]%/*}" && pwd -P)"
+readonly SCRIPT_DIR
+readonly DB_CONF="${SCRIPT_DIR}/../etc/db.conf"
+readonly LOG_FILE='/var/log/provision.log'
+readonly NAME_RE='^[a-z_][a-z0-9_-]{0,31}$'
 
-PASSWORD=$RANDOM$RANDOM$RANDOM
+# Script scope: the EXIT trap runs after main has returned.
+workdir=''
 
-echo "$USERNAME:$PASSWORD" | chpasswd
+err() {
+  printf '%s: %s\n' "${PROGNAME}" "$*" >&2
+}
 
-mysql -u admin -p$DB_ADMIN_PASSWORD -e "CREATE USER '$USERNAME'@'%' IDENTIFIED BY '$PASSWORD';"
+cleanup() {
+  if [[ -n ${workdir} && -d ${workdir} ]]; then
+    rm -rf -- "${workdir}"
+  fi
+  return 0
+}
 
-echo "provisioned $USERNAME with password $PASSWORD" >> /var/log/provision.log
+# Clean up, then die of the signal so the caller sees 128+n.
+on_signal() {
+  local sig="$1"
+  cleanup
+  trap - EXIT "${sig}"
+  kill -s "${sig}" -- "$$"
+}
+
+# Reads DB_ADMIN_PASSWORD from the config without executing the file.
+# Prints the value on stdout.
+read_db_password() {
+  local key value found=0 password=''
+  while IFS='=' read -r key value || [[ -n ${key} ]]; do
+    if [[ ${key} == DB_ADMIN_PASSWORD ]]; then
+      password="${value}"
+      found=1
+    fi
+  done <"${DB_CONF}"
+  if ((!found)) || [[ -z ${password} ]]; then
+    err "DB_ADMIN_PASSWORD not set in ${DB_CONF}"
+    return 1
+  fi
+  printf '%s' "${password}"
+}
+
+# Writes a mysql option file so the admin password stays out of argv.
+write_mysql_options() {
+  local file="$1" password
+  password="$(read_db_password)"
+  password="${password//\\/\\\\}"
+  password="${password//\"/\\\"}"
+  printf '[client]\nuser=admin\npassword="%s"\n' "${password}" >"${file}"
+}
+
+# Prints a 32-character alphanumeric password from /dev/urandom.
+generate_password() {
+  local secret
+  secret="$(LC_ALL=C tr -dc 'A-Za-z0-9' < <(head -c 512 /dev/urandom))"
+  secret="${secret:0:32}"
+  if ((${#secret} != 32)); then
+    err 'could not generate a password'
+    return 1
+  fi
+  printf '%s' "${secret}"
+}
+
+# Creates one account and its database user.
+# Arguments: username, login shell (may be empty for the system default)
+provision_one() {
+  local name="$1" shell="$2" password
+  local -a useradd_args=(-m)
+
+  if [[ ! ${name} =~ ${NAME_RE} ]]; then
+    err "invalid account name: ${name}"
+    return 2
+  fi
+  if [[ -n ${shell} ]]; then
+    useradd_args+=(-s "${shell}")
+  fi
+
+  # Called from an `if`, so errexit is off here: check each step.
+  password="$(generate_password)" || return
+  useradd "${useradd_args[@]}" -- "${name}" || return
+  printf '%s:%s\n' "${name}" "${password}" | chpasswd || return
+  # The name is allowlisted above and the password is alphanumeric, so
+  # neither can break out of the SQL literals. Sent on stdin, not argv.
+  printf "CREATE USER '%s'@'%%' IDENTIFIED BY '%s';\n" "${name}" "${password}" |
+    mysql --defaults-extra-file="${workdir}/my.cnf" || return
+
+  # The password is deliberately not logged.
+  printf '%s provisioned %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${name}" >>"${LOG_FILE}" || return
+  printf 'provisioned %s (shell: %s)\n' "${name}" "${shell:-default}"
+}
+
+usage() {
+  err "usage: ${PROGNAME} [--shell SHELL] [--from-file FILE] [USERNAME ...]"
+}
+
+main() {
+  local shell='' from_file='' line name failed=0
+  local -a names=()
+
+  while (($# > 0)); do
+    case $1 in
+      --shell)
+        (($# >= 2)) || { usage; return 64; }
+        shell="$2"
+        shift 2
+        ;;
+      --from-file)
+        (($# >= 2)) || { usage; return 64; }
+        from_file="$2"
+        shift 2
+        ;;
+      -h | --help)
+        usage
+        return 0
+        ;;
+      --)
+        shift
+        names+=("$@")
+        break
+        ;;
+      -*)
+        err "unknown option: $1"
+        usage
+        return 64
+        ;;
+      *)
+        names+=("$1")
+        shift
+        ;;
+    esac
+  done
+
+  if [[ -n ${shell} ]]; then
+    if [[ ${shell} != /* ]] || ! grep -qxF -- "${shell}" /etc/shells; then
+      err "shell not listed in /etc/shells: ${shell}"
+      return 64
+    fi
+  fi
+
+  if [[ -n ${from_file} ]]; then
+    if [[ ! -f ${from_file} || ! -r ${from_file} ]]; then
+      err "cannot read file: ${from_file}"
+      return 66
+    fi
+    while IFS= read -r line || [[ -n ${line} ]]; do
+      line="${line%$'\r'}"
+      if [[ -z ${line} || ${line} == '#'* ]]; then
+        continue
+      fi
+      names+=("${line}")
+    done <"${from_file}"
+  fi
+
+  if ((${#names[@]} == 0)); then
+    usage
+    return 64
+  fi
+
+  # Traps before mktemp so a signal cannot leak the directory.
+  trap cleanup EXIT
+  trap 'on_signal INT' INT
+  trap 'on_signal TERM' TERM
+  workdir="$(mktemp -d)"
+  write_mysql_options "${workdir}/my.cnf"
+
+  for name in "${names[@]}"; do
+    # Called in a condition, so errexit is off inside: failures are
+    # reported per account and the batch continues.
+    if ! provision_one "${name}" "${shell}"; then
+      err "failed to provision: ${name}"
+      failed=$((failed + 1))
+    fi
+  done
+
+  if ((failed > 0)); then
+    err "${failed} of ${#names[@]} accounts failed"
+    return 1
+  fi
+}
+
+main "$@"
