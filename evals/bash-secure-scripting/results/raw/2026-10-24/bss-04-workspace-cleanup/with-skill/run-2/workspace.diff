 #!/bin/bash
+#
 # Remove stale CI workspaces.
 
-WORKSPACE_ROOT=workspaces
-DAYS=7
+set -Eeuo pipefail
+shopt -s inherit_errexit
 
-cd $WORKSPACE_ROOT
+PATH='/usr/local/bin:/usr/bin:/bin'
+export PATH
+export LC_ALL=C
 
-for dir in $(ls); do
-  if [ -d $dir ]; then
-    LAST=`find $dir -type f -printf '%T@\n' | sort -n | tail -1`
-    AGE=$(( ( $(date +%s) - ${LAST%.*} ) / 86400 ))
-    if [ $AGE -gt $DAYS ]; then
-      echo "removing $dir (age ${AGE}d)"
-      rm -rf $dir/*
-      rmdir $dir
-    fi
+readonly PROGNAME="${0##*/}"
+readonly DEFAULT_ROOT=workspaces
+readonly DEFAULT_DAYS=7
+
+err() {
+  printf '%s: %s\n' "${PROGNAME}" "$*" >&2
+}
+
+usage() {
+  cat <<USAGE
+Usage: ${PROGNAME} [-n] [-r ROOT] [-d DAYS]
+
+Remove workspaces under ROOT whose newest file is more than DAYS days old.
+
+  -r, --root ROOT   directory holding the workspaces (default: ${DEFAULT_ROOT})
+  -d, --days DAYS   age threshold in whole days (default: ${DEFAULT_DAYS})
+  -n, --dry-run     list what would be removed; remove nothing
+  -h, --help        show this help
+USAGE
+}
+
+# Prints the mtime (epoch seconds) of the newest file in a directory, or of the
+# directory itself when it holds no files.
+# Arguments: directory path
+newest_mtime() {
+  local dir="$1" last
+  last="$(find "${dir}" -type f -printf '%T@\n' | sort -n | tail -n 1)"
+  if [[ -z ${last} ]]; then
+    stat -c '%Y' -- "${dir}"
+  else
+    printf '%s\n' "${last%.*}"
   fi
-done
+}
+
+main() {
+  local root="${DEFAULT_ROOT}" days="${DEFAULT_DAYS}" dry_run=0
+  local dir last age now status=0
+
+  while (($# > 0)); do
+    case "$1" in
+      -r | --root)
+        (($# >= 2)) || { err "$1 needs a value"; return 64; }
+        root="$2"
+        shift 2
+        ;;
+      -d | --days)
+        (($# >= 2)) || { err "$1 needs a value"; return 64; }
+        days="$2"
+        shift 2
+        ;;
+      -n | --dry-run)
+        dry_run=1
+        shift
+        ;;
+      -h | --help)
+        usage
+        return 0
+        ;;
+      *)
+        err "unknown argument: $1"
+        usage >&2
+        return 64
+        ;;
+    esac
+  done
+
+  if [[ ! ${days} =~ ^[0-9]{1,6}$ ]]; then
+    err "invalid days (want a non-negative integer): ${days}"
+    return 64
+  fi
+  days=$((10#${days}))
+
+  if [[ -z ${root} || ! -d ${root} ]]; then
+    err "workspace root is not a directory: ${root}"
+    return 66
+  fi
+  cd -- "${root}" || { err "cannot enter ${root}"; return 66; }
+
+  now="$(date +%s)"
+
+  # Real directories only (no symlinks), one level deep; ./ keeps names that
+  # start with a hyphen from being read as options.
+  while IFS= read -r -d '' dir; do
+    last="$(newest_mtime "${dir}")"
+    age=$(((now - last) / 86400))
+    if ((age > days)); then
+      if ((dry_run)); then
+        printf 'would remove %s (age %dd)\n' "${dir#./}" "${age}"
+      else
+        printf 'removing %s (age %dd)\n' "${dir#./}" "${age}"
+        rm -rf -- "${dir}" || status=1
+      fi
+    fi
+  done < <(find . -mindepth 1 -maxdepth 1 -type d -print0)
+
+  return "${status}"
+}
+
+main "$@"
