 #!/bin/bash
 # Remove stale CI workspaces.
+#
+# A workspace is a directory directly under the workspace root. It is stale when
+# its newest file is more than DAYS days old.
 
-WORKSPACE_ROOT=workspaces
-DAYS=7
+set -Eeuo pipefail
+shopt -s inherit_errexit
 
-cd $WORKSPACE_ROOT
+readonly PROGNAME="${0##*/}"
+readonly DEFAULT_ROOT=workspaces
+readonly DEFAULT_DAYS=7
 
-for dir in $(ls); do
-  if [ -d $dir ]; then
-    LAST=`find $dir -type f -printf '%T@\n' | sort -n | tail -1`
-    AGE=$(( ( $(date +%s) - ${LAST%.*} ) / 86400 ))
-    if [ $AGE -gt $DAYS ]; then
-      echo "removing $dir (age ${AGE}d)"
-      rm -rf $dir/*
-      rmdir $dir
-    fi
+err() {
+  printf '%s: %s\n' "${PROGNAME}" "$*" >&2
+}
+
+usage() {
+  cat <<EOF
+Usage: ${PROGNAME} [-n] [-r ROOT] [-d DAYS]
+
+Remove workspaces under ROOT whose newest file is more than DAYS days old.
+
+  -r, --root ROOT   workspace root (default: ${DEFAULT_ROOT})
+  -d, --days DAYS   age threshold in days (default: ${DEFAULT_DAYS})
+  -n, --dry-run     list what would be removed; remove nothing
+  -h, --help        show this help
+EOF
+}
+
+# Prints the mtime (epoch seconds) of the newest file under a directory, or the
+# directory's own mtime when it holds no files.
+# Arguments: directory
+newest_mtime() {
+  local dir="$1"
+  local newest
+
+  newest="$(find "${dir}" -type f -printf '%T@\n' | sort -n | tail -n 1)"
+  if [[ -z ${newest} ]]; then
+    newest="$(stat -c '%Y' -- "${dir}")"
+  fi
+  printf '%s\n' "${newest%.*}"
+}
+
+main() {
+  local root="${DEFAULT_ROOT}"
+  local days="${DEFAULT_DAYS}"
+  local dry_run=0
+
+  while (($# > 0)); do
+    case "$1" in
+      -r | --root)
+        if (($# < 2)); then
+          err "$1 needs a value"
+          return 64
+        fi
+        root="$2"
+        shift 2
+        ;;
+      -d | --days)
+        if (($# < 2)); then
+          err "$1 needs a value"
+          return 64
+        fi
+        days="$2"
+        shift 2
+        ;;
+      -n | --dry-run)
+        dry_run=1
+        shift
+        ;;
+      -h | --help)
+        usage
+        return 0
+        ;;
+      *)
+        err "unknown argument: $1"
+        usage >&2
+        return 64
+        ;;
+    esac
+  done
+
+  if [[ ! ${days} =~ ^[0-9]+$ ]]; then
+    err "invalid --days (want a non-negative integer): ${days}"
+    return 64
+  fi
+  # Force base 10 so a leading zero is not read as octal.
+  days=$((10#${days}))
+
+  if [[ -z ${root} || ! -d ${root} ]]; then
+    err "workspace root is not a directory: ${root}"
+    return 66
   fi
-done
+  root="$(realpath -- "${root}")"
+  if [[ ${root} == / ]]; then
+    err "refusing to clean the filesystem root"
+    return 64
+  fi
+
+  local now dir last age name
+  local failed=0
+  now="$(date +%s)"
+
+  for dir in "${root}"/*/; do
+    dir="${dir%/}"
+    name="${dir##*/}"
+    # An unmatched glob stays literal; a symlink could point outside the root.
+    if [[ -L ${dir} || ! -d ${dir} ]]; then
+      continue
+    fi
+
+    if ! last="$(newest_mtime "${dir}")"; then
+      err "cannot determine age of ${name}, skipping"
+      failed=1
+      continue
+    fi
+    age=$(((now - last) / 86400))
+    if ((age <= days)); then
+      continue
+    fi
+
+    if ((dry_run)); then
+      printf 'would remove %s (age %sd)\n' "${name}" "${age}"
+    else
+      printf 'removing %s (age %sd)\n' "${name}" "${age}"
+      if ! rm -rf -- "${dir}"; then
+        err "failed to remove ${name}"
+        failed=1
+      fi
+    fi
+  done
+
+  return "${failed}"
+}
+
+main "$@"
