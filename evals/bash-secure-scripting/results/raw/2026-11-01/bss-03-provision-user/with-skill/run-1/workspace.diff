 Account provisioning for the application hosts.
 
-`sbin/provision-user.sh USERNAME` creates the local account and its database user. It runs
+```
+sbin/provision-user.sh [--shell SHELL] [--from-file FILE] [--] [USERNAME...]
+```
+
+The script creates a local account and a matching database user for each name given. It runs
 as root from `etc/cron.d/provision`. Database administrator credentials live in
-`etc/db.conf`.
+`etc/db.conf`, which must be owned by root and not group- or world-writable.
+
+## Options
+
+- `--from-file FILE` reads account names from `FILE`, one per line. Blank lines and lines
+  starting with `#` are ignored. Names may also be given as arguments; both sources are combined.
+- `--shell SHELL` sets the login shell of the accounts it creates. `SHELL` must be an absolute
+  path that is executable and listed in `/etc/shells`. Without it, the system default applies.
+
+## Behavior
+
+- Every name must match `^[a-z_][a-z0-9_-]{0,31}$`. All names and the shell are validated
+  before any account is created; one bad entry aborts the run with status 65 and changes nothing.
+- One summary line is printed per provisioned account:
+  `provisioned NAME shell=SHELL` (`shell=default` when `--shell` was not given).
+- Accounts are processed in order. If one fails, the error goes to stderr, the remaining
+  accounts are still attempted, and the script exits 1 after reporting how many failed.
+- Only one run proceeds at a time (lock file `/run/lock/provision-user.lock`); a second
+  run exits with status 75.
+- The generated passwords are no longer written to `/var/log/provision.log` or printed.
+
+Exit statuses: 0 success, 1 one or more accounts failed, 64 usage, 65 invalid input,
+66 unreadable file, 75 lock held, 77 unsafe `etc/db.conf`.
diff --git a/sbin/provision-user.sh b/sbin/provision-user.sh
index 3427aa2..ce2c06d 100755
--- a/sbin/provision-user.sh
+++ b/sbin/provision-user.sh
@@ -1,16 +1,223 @@
 #!/bin/bash
-# Create an application account and its database user.
+#
+# Create application accounts and their database users.
+#
+# Usage: provision-user.sh [--shell SHELL] [--from-file FILE] [--] [USERNAME...]
+#
+# Requires Bash 4.4 or later (inherit_errexit); Linux only.
 
-. etc/db.conf
+set -Eeuo pipefail
+shopt -s inherit_errexit
 
-USERNAME=$1
+# Runs as root from cron: do not trust the caller's environment.
+PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
+export PATH
+export LC_ALL=C
+export TMPDIR=/var/tmp
+umask 077
 
-useradd -m $USERNAME
+readonly PROGNAME="${0##*/}"
+SCRIPT_DIR="$(cd -- "${BASH_SOURCE[0]%/*}" && pwd -P)"
+readonly SCRIPT_DIR
+readonly DB_CONF="${SCRIPT_DIR}/../etc/db.conf"
+readonly LOCK_FILE='/run/lock/provision-user.lock'
+readonly USERNAME_RE='^[a-z_][a-z0-9_-]{0,31}$'
 
-PASSWORD=$RANDOM$RANDOM$RANDOM
+# Script scope: the EXIT trap runs after main has returned.
+workdir=''
 
-echo "$USERNAME:$PASSWORD" | chpasswd
+err() {
+  printf '%s: %s\n' "${PROGNAME}" "$*" >&2
+}
 
-mysql -u admin -p$DB_ADMIN_PASSWORD -e "CREATE USER '$USERNAME'@'%' IDENTIFIED BY '$PASSWORD';"
+die() {
+  local status="$1"
+  shift
+  err "$*"
+  exit "${status}"
+}
 
-echo "provisioned $USERNAME with password $PASSWORD" >> /var/log/provision.log
+cleanup() {
+  if [[ -n ${workdir} && -d ${workdir} ]]; then
+    rm -rf -- "${workdir}"
+  fi
+  return 0
+}
+
+on_signal() {
+  local sig="$1"
+  cleanup
+  trap - EXIT "${sig}"
+  kill -s "${sig}" -- "$$"
+}
+
+usage() {
+  printf 'usage: %s [--shell SHELL] [--from-file FILE] [--] [USERNAME...]\n' "${PROGNAME}" >&2
+}
+
+# Succeeds if $1 is a valid account name.
+valid_username() {
+  [[ $1 =~ ${USERNAME_RE} ]]
+}
+
+# Succeeds if $1 is an absolute path listed in /etc/shells and executable.
+valid_shell() {
+  local candidate="$1" line
+  [[ ${candidate} == /* && -x ${candidate} ]] || return 1
+  while IFS= read -r line; do
+    [[ ${line} == "${candidate}" ]] && return 0
+  done < <(grep -v '^[[:space:]]*#' /etc/shells)
+  return 1
+}
+
+# Refuse to source a config that anyone but root could have modified.
+require_root_owned_private() {
+  local file="$1" owner mode
+  [[ -f ${file} && ! -L ${file} ]] || die 66 "missing or not a regular file: ${file}"
+  owner="$(stat -c '%u' -- "${file}")"
+  mode="$(stat -c '%a' -- "${file}")"
+  [[ ${owner} == 0 ]] || die 77 "${file} must be owned by root"
+  ((8#${mode} & 8#022)) && die 77 "${file} must not be group- or world-writable"
+  return 0
+}
+
+# Writes a mysql option file holding the admin credential; the password never
+# appears in a command line.
+write_mysql_options() {
+  local file="$1" pw="${DB_ADMIN_PASSWORD}"
+  pw="${pw//\\/\\\\}"
+  pw="${pw//\"/\\\"}"
+  printf '[client]\nuser=admin\npassword="%s"\n' "${pw}" >"${file}"
+}
+
+# Prints a 24-character alphanumeric password from /dev/urandom.
+generate_password() {
+  local secret
+  secret="$(LC_ALL=C tr -dc 'A-Za-z0-9' < <(head -c 512 /dev/urandom))"
+  secret="${secret:0:24}"
+  ((${#secret} == 24)) || return 1
+  printf '%s' "${secret}"
+}
+
+# Provisions one account. Arguments: username, shell (may be empty).
+# Returns: 0 on success, 1 on failure (reported to stderr).
+provision_one() {
+  local username="$1" login_shell="$2"
+  local password
+  local -a useradd_args=(-m)
+
+  if [[ -n ${login_shell} ]]; then
+    useradd_args+=(-s "${login_shell}")
+  fi
+
+  password="$(generate_password)" || {
+    err "${username}: could not generate a password"
+    return 1
+  }
+
+  useradd "${useradd_args[@]}" -- "${username}" || {
+    err "${username}: useradd failed"
+    return 1
+  }
+  printf '%s:%s\n' "${username}" "${password}" | chpasswd || {
+    err "${username}: chpasswd failed"
+    return 1
+  }
+  # username is validated against USERNAME_RE and the password is alphanumeric,
+  # so neither can alter the statement. Statement goes in on stdin.
+  printf "CREATE USER '%s'@'%%' IDENTIFIED BY '%s';\n" "${username}" "${password}" |
+    mysql --defaults-extra-file="${workdir}/my.cnf" || {
+    err "${username}: database user creation failed"
+    return 1
+  }
+
+  printf 'provisioned %s shell=%s\n' "${username}" "${login_shell:-default}"
+}
+
+main() {
+  local from_file='' login_shell='' name line
+  local -a names=()
+  local failures=0
+
+  while (($#)); do
+    case "$1" in
+      --from-file)
+        (($# >= 2)) || { usage; return 64; }
+        from_file="$2"
+        shift 2
+        ;;
+      --from-file=*)
+        from_file="${1#*=}"
+        shift
+        ;;
+      --shell)
+        (($# >= 2)) || { usage; return 64; }
+        login_shell="$2"
+        shift 2
+        ;;
+      --shell=*)
+        login_shell="${1#*=}"
+        shift
+        ;;
+      --)
+        shift
+        break
+        ;;
+      -*)
+        err "unknown option: $1"
+        usage
+        return 64
+        ;;
+      *) break ;;
+    esac
+  done
+  names+=("$@")
+
+  if [[ -n ${from_file} ]]; then
+    [[ -f ${from_file} && -r ${from_file} ]] || die 66 "cannot read: ${from_file}"
+    while IFS= read -r line || [[ -n ${line} ]]; do
+      line="${line%$'\r'}"
+      [[ -z ${line} || ${line} == '#'* ]] && continue
+      names+=("${line}")
+    done <"${from_file}"
+  fi
+
+  if ((${#names[@]} == 0)); then
+    usage
+    return 64
+  fi
+
+  # Fail closed: validate every input before changing anything.
+  for name in "${names[@]}"; do
+    valid_username "${name}" || die 65 "invalid username: ${name}"
+  done
+  if [[ -n ${login_shell} ]]; then
+    valid_shell "${login_shell}" || die 65 "shell not in /etc/shells or not executable: ${login_shell}"
+  fi
+
+  # One run at a time.
+  exec {lock_fd}>"${LOCK_FILE}"
+  flock -n "${lock_fd}" || die 75 'another provisioning run is in progress'
+
+  require_root_owned_private "${DB_CONF}"
+  # shellcheck source=etc/db.conf
+  . "${DB_CONF}"
+  : "${DB_ADMIN_PASSWORD:?DB_ADMIN_PASSWORD not set in ${DB_CONF}}"
+
+  trap cleanup EXIT
+  trap 'on_signal INT' INT
+  trap 'on_signal TERM' TERM
+  workdir="$(mktemp -d)"
+  write_mysql_options "${workdir}/my.cnf"
+
+  for name in "${names[@]}"; do
+    provision_one "${name}" "${login_shell}" || failures=$((failures + 1))
+  done
+
+  if ((failures > 0)); then
+    err "${failures} of ${#names[@]} account(s) failed"
+    return 1
+  fi
+}
+
+main "$@"
