 Account provisioning for the application hosts.
 
-`sbin/provision-user.sh USERNAME` creates the local account and its database user. It runs
-as root from `etc/cron.d/provision`. Database administrator credentials live in
-`etc/db.conf`.
+`sbin/provision-user.sh` creates local accounts and their database users. It runs as root from
+`etc/cron.d/provision`. Database administrator credentials live in `etc/db.conf`, which the
+script reads relative to its own location and refuses to use unless root owns it and it is not
+group- or world-writable.
+
+## Usage
+
+    sbin/provision-user.sh [--shell SHELL] [--from-file FILE] [USERNAME...]
+
+- `USERNAME...`: one or more accounts to provision (a single name works as before).
+- `--from-file FILE`: read account names from `FILE`, one per line. Blank lines and lines
+  starting with `#` are ignored. Can be combined with names on the command line.
+- `--shell SHELL`: login shell for the accounts created. Must be an absolute path listed in
+  `/etc/shells`. Without it, `useradd`'s default applies.
+
+Names must match `^[a-z_][a-z0-9_-]{0,31}$`. All names and the shell are validated before any
+account is created; an invalid one aborts the run with exit status 64 and changes nothing.
+
+For each account the script prints one line to stdout:
+
+    provisioned alice shell=/bin/bash
+    FAILED bob (exit 1)
+
+A failure on one account does not stop the rest; the script exits 1 if any account failed.
+
+## Notes
+
+- Each account gets a random 32-character password. The password is no longer written to
+  `/var/log/provision.log`; the log records only the time and account name.
+- The database admin password is passed to `mysql` through a temporary mode-0600 option file
+  rather than the command line.
diff --git a/sbin/provision-user.sh b/sbin/provision-user.sh
index 3427aa2..7853b1f 100755
--- a/sbin/provision-user.sh
+++ b/sbin/provision-user.sh
@@ -1,16 +1,215 @@
 #!/bin/bash
-# Create an application account and its database user.
+#
+# Create application accounts and their database users.
+#
+# Usage: provision-user.sh [--shell SHELL] [--from-file FILE] [USERNAME...]
 
-. etc/db.conf
+set -Eeuo pipefail
+shopt -s inherit_errexit
 
-USERNAME=$1
+# Runs as root from cron: do not trust the caller's environment.
+PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
+export PATH
+export LC_ALL=C
+umask 077
 
-useradd -m $USERNAME
+readonly PROGNAME="${0##*/}"
+readonly USERNAME_RE='^[a-z_][a-z0-9_-]{0,31}$'
+readonly LOG_FILE='/var/log/provision.log'
 
-PASSWORD=$RANDOM$RANDOM$RANDOM
+# Script scope: the EXIT trap runs after main has returned.
+workdir=''
 
-echo "$USERNAME:$PASSWORD" | chpasswd
+err() {
+  printf '%s: %s\n' "${PROGNAME}" "$*" >&2
+}
 
-mysql -u admin -p$DB_ADMIN_PASSWORD -e "CREATE USER '$USERNAME'@'%' IDENTIFIED BY '$PASSWORD';"
+usage() {
+  err 'usage: provision-user.sh [--shell SHELL] [--from-file FILE] [USERNAME...]'
+}
 
-echo "provisioned $USERNAME with password $PASSWORD" >> /var/log/provision.log
+cleanup() {
+  if [[ -n ${workdir} && -d ${workdir} ]]; then
+    rm -rf -- "${workdir}"
+  fi
+  return 0
+}
+
+# Clean up, then die of the signal so the caller sees 128+n.
+on_signal() {
+  local sig="$1"
+  cleanup
+  trap - EXIT "${sig}"
+  kill -s "${sig}" -- "$$"
+}
+
+# Source etc/db.conf (relative to this script, not the cwd) only if root owns it
+# and nobody else can write it: it is executed as root.
+load_db_conf() {
+  local conf="$1"
+  local meta
+  if [[ ! -f ${conf} || -L ${conf} ]]; then
+    err "missing or unsafe config: ${conf}"
+    return 1
+  fi
+  meta="$(stat -c '%u %a' -- "${conf}")"
+  if [[ ${meta%% *} != 0 ]] || (((8#${meta##* } & 8#022) != 0)); then
+    err "config must be owned by root and not group/world writable: ${conf}"
+    return 1
+  fi
+  # shellcheck source=/dev/null
+  . "${conf}"
+  if [[ -z ${DB_ADMIN_PASSWORD:-} ]]; then
+    err 'DB_ADMIN_PASSWORD is not set'
+    return 1
+  fi
+}
+
+# Write a mysql option file so the admin password stays off the command line.
+write_mysql_defaults() {
+  local file="$1"
+  local pw="${DB_ADMIN_PASSWORD//\\/\\\\}"
+  pw="${pw//\"/\\\"}"
+  printf '[client]\nuser=admin\npassword="%s"\n' "${pw}" >"${file}"
+}
+
+# Prints a 32-character alphanumeric password from /dev/urandom.
+generate_password() {
+  local secret
+  secret="$(LC_ALL=C tr -dc 'A-Za-z0-9' < <(head -c 512 /dev/urandom))"
+  secret="${secret:0:32}"
+  if ((${#secret} != 32)); then
+    err 'could not generate a password'
+    return 1
+  fi
+  printf '%s' "${secret}"
+}
+
+# Arguments: username, shell ('' for the system default), mysql defaults file
+provision_one() {
+  local name="$1"
+  local login_shell="$2"
+  local defaults="$3"
+  local password
+  local -a useradd_cmd=(useradd -m)
+
+  if [[ -n ${login_shell} ]]; then
+    useradd_cmd+=(-s "${login_shell}")
+  fi
+  useradd_cmd+=(-- "${name}")
+
+  # errexit is suppressed here because the caller tests this function in an
+  # `if`, so every step is checked explicitly.
+  password="$(generate_password)" || return 1
+  "${useradd_cmd[@]}" || return 1
+  printf '%s:%s\n' "${name}" "${password}" | chpasswd || return 1
+  # name and password are validated/alphanumeric; SQL goes via stdin, not argv.
+  mysql --defaults-extra-file="${defaults}" \
+    <<<"CREATE USER '${name}'@'%' IDENTIFIED BY '${password}';" || return 1
+
+  # The password is deliberately not logged.
+  printf '%s provisioned %s\n' "$(date -u +%FT%TZ)" "${name}" >>"${LOG_FILE}" || return 1
+}
+
+main() {
+  local login_shell='' from_file='' line name defaults status=0 failed=0
+  local -a names=()
+
+  while (($# > 0)); do
+    case $1 in
+      --shell)
+        (($# >= 2)) || { err '--shell needs a value'; usage; return 64; }
+        login_shell="$2"
+        shift 2
+        ;;
+      --shell=*)
+        login_shell="${1#--shell=}"
+        shift
+        ;;
+      --from-file)
+        (($# >= 2)) || { err '--from-file needs a value'; usage; return 64; }
+        from_file="$2"
+        shift 2
+        ;;
+      --from-file=*)
+        from_file="${1#--from-file=}"
+        shift
+        ;;
+      --)
+        shift
+        names+=("$@")
+        break
+        ;;
+      -*)
+        err "unknown option: $1"
+        usage
+        return 64
+        ;;
+      *)
+        names+=("$1")
+        shift
+        ;;
+    esac
+  done
+
+  if [[ -n ${from_file} ]]; then
+    if [[ ! -f ${from_file} || ! -r ${from_file} ]]; then
+      err "cannot read file: ${from_file}"
+      return 66
+    fi
+    # Blank lines and #-comment lines are skipped; the last line may lack a newline.
+    while IFS= read -r line || [[ -n ${line} ]]; do
+      line="${line%$'\r'}"
+      [[ -z ${line} || ${line} == '#'* ]] && continue
+      names+=("${line}")
+    done <"${from_file}"
+  fi
+
+  if ((${#names[@]} == 0)); then
+    err 'no accounts given'
+    usage
+    return 64
+  fi
+
+  if [[ -n ${login_shell} ]]; then
+    if [[ ${login_shell} != /* ]] || ! grep -qxF -- "${login_shell}" /etc/shells; then
+      err "shell not listed in /etc/shells: ${login_shell}"
+      return 64
+    fi
+  fi
+
+  # Validate everything before changing anything.
+  for name in "${names[@]}"; do
+    if [[ ! ${name} =~ ${USERNAME_RE} ]]; then
+      err "invalid username: ${name}"
+      return 64
+    fi
+  done
+
+  load_db_conf "${BASH_SOURCE[0]%/*}/../etc/db.conf"
+
+  trap cleanup EXIT
+  trap 'on_signal INT' INT
+  trap 'on_signal TERM' TERM
+  workdir="$(mktemp -d)"
+  defaults="${workdir}/my.cnf"
+  write_mysql_defaults "${defaults}"
+
+  for name in "${names[@]}"; do
+    # Called in an if so one failure does not abort the remaining accounts.
+    if provision_one "${name}" "${login_shell}" "${defaults}"; then
+      printf 'provisioned %s shell=%s\n' "${name}" "${login_shell:-default}"
+    else
+      status=$?
+      failed=$((failed + 1))
+      printf 'FAILED %s (exit %d)\n' "${name}" "${status}"
+    fi
+  done
+
+  if ((failed > 0)); then
+    err "${failed} account(s) failed"
+    return 1
+  fi
+}
+
+main "$@"
