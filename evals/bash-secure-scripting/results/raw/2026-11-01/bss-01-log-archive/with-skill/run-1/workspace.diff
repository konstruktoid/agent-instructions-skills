diff --git a/bin/archive-logs.sh b/bin/archive-logs.sh
index d6e0cf6..18dcdee 100755
--- a/bin/archive-logs.sh
+++ b/bin/archive-logs.sh
@@ -1,16 +1,162 @@
 #!/bin/bash
-# Archive the logs of one service into the retention directory.
+#
+# Archive the logs of one or more services into the retention directory,
+# optionally pruning archives older than N days afterwards.
+#
+# Usage: archive-logs.sh [--keep-days N] SERVICE [SERVICE...]
+#
+# Requires GNU find (-mindepth, -maxdepth, -mtime, -delete) and Bash 4.4+.
 
-LOG_ROOT=logs
-RETENTION_DIR=archives
-SERVICE=$1
+set -Eeuo pipefail
+shopt -s inherit_errexit
 
-TMP=/tmp/archive-logs.$$
-mkdir $TMP
+# Runs from cron: do not trust the caller's environment.
+PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
+export PATH
+export LC_ALL=C
+umask 077
 
-tar czf $TMP/$SERVICE.tar.gz $LOG_ROOT/$SERVICE
-mv $TMP/$SERVICE.tar.gz $RETENTION_DIR/$SERVICE-`date +%Y%m%d`.tar.gz
+readonly PROGNAME="${0##*/}"
+# Paths are relative to the repository root (the parent of bin/), so the job
+# does not depend on the directory cron starts in.
+ROOT_DIR="$(cd -- "${BASH_SOURCE[0]%/*}/.." && pwd -P)"
+readonly ROOT_DIR
+readonly LOG_ROOT="${ROOT_DIR}/logs"
+readonly RETENTION_DIR="${ROOT_DIR}/archives"
 
-rm -rf $TMP/*
+# Script scope: the EXIT trap runs after main has returned.
+workdir=''
 
-echo "archived $SERVICE"
+err() {
+  printf '%s: %s\n' "${PROGNAME}" "$*" >&2
+}
+
+cleanup() {
+  if [[ -n ${workdir} && -d ${workdir} ]]; then
+    rm -rf -- "${workdir}"
+  fi
+  return 0
+}
+
+# Clean up, then die of the signal so the caller sees 128+n.
+on_signal() {
+  local sig="$1"
+  cleanup
+  trap - EXIT "${sig}"
+  kill -s "${sig}" -- "$$"
+}
+
+# Archives the logs of one service.
+# Globals: LOG_ROOT, RETENTION_DIR, workdir
+# Arguments: service name (already validated)
+# Returns: 0 on success, 1 if the service has no log directory
+archive_service() {
+  local service="$1"
+  local stamp
+  stamp="$(date -u +%Y%m%d)"
+
+  if [[ ! -d ${LOG_ROOT}/${service} ]]; then
+    err "no logs for service: ${service}"
+    return 1
+  fi
+
+  # -C keeps the member names relative ("SERVICE/...") rather than embedding
+  # the absolute path of the log root.
+  tar --create --gzip --file "${workdir}/${service}.tar.gz" \
+    -C "${LOG_ROOT}" -- "${service}"
+  mv -- "${workdir}/${service}.tar.gz" \
+    "${RETENTION_DIR}/${service}-${stamp}.tar.gz"
+}
+
+# Removes dated archives older than the given number of days.
+# Globals: RETENTION_DIR
+# Arguments: days
+# Stdout: number of archives removed
+prune_archives() {
+  local days="$1"
+  local count=0
+  local path
+
+  # Only regular files named SERVICE-YYYYMMDD.tar.gz directly in the
+  # retention directory; the process substitution keeps the count in this shell.
+  while IFS= read -r -d '' path; do
+    rm -f -- "${path}"
+    count=$((count + 1))
+  done < <(find "${RETENTION_DIR}" -mindepth 1 -maxdepth 1 -type f \
+    -name '*-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9].tar.gz' \
+    -mtime "+${days}" -print0)
+
+  printf '%s\n' "${count}"
+}
+
+main() {
+  local keep_days=''
+  local -a services=()
+  local service pruned summary
+
+  while (($# > 0)); do
+    case "$1" in
+      --keep-days)
+        if (($# < 2)); then
+          err "--keep-days requires a value"
+          return 64
+        fi
+        keep_days="$2"
+        shift 2
+        ;;
+      --keep-days=*)
+        keep_days="${1#--keep-days=}"
+        shift
+        ;;
+      --)
+        shift
+        services+=("$@")
+        break
+        ;;
+      -*)
+        err "unknown option: $1"
+        return 64
+        ;;
+      *)
+        services+=("$1")
+        shift
+        ;;
+    esac
+  done
+
+  if ((${#services[@]} == 0)); then
+    err "usage: ${PROGNAME} [--keep-days N] SERVICE [SERVICE...]"
+    return 64
+  fi
+  if [[ -n ${keep_days} && ! ${keep_days} =~ ^[0-9]+$ ]]; then
+    err "--keep-days must be a non-negative integer: ${keep_days}"
+    return 64
+  fi
+  # Validate every name before touching anything: names become path parts.
+  for service in "${services[@]}"; do
+    if [[ ! ${service} =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
+      err "invalid service name: ${service}"
+      return 64
+    fi
+  done
+
+  # Traps first, then mktemp. Same filesystem as the target so mv is atomic.
+  trap cleanup EXIT
+  trap 'on_signal INT' INT
+  trap 'on_signal TERM' TERM
+  workdir="$(mktemp -d -- "${RETENTION_DIR}/.tmp.XXXXXXXX")"
+
+  for service in "${services[@]}"; do
+    archive_service "${service}"
+  done
+
+  summary="archived ${#services[@]} service(s): ${services[*]}"
+  if [[ -n ${keep_days} ]]; then
+    # Only reached when every new archive is in place (errexit stops us above).
+    pruned="$(prune_archives "${keep_days}")"
+    summary+="; pruned ${pruned} archive(s) older than ${keep_days} day(s)"
+  fi
+  printf '%s\n' "${summary}"
+}
+
+main "$@"
