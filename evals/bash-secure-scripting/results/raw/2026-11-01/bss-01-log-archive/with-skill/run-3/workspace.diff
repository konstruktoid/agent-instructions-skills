 #!/bin/bash
-# Archive the logs of one service into the retention directory.
+#
+# Archive the logs of one or more services into the retention directory,
+# optionally pruning archives older than N days afterwards.
+#
+# Usage: archive-logs.sh [--keep-days N] SERVICE [SERVICE...]
 
-LOG_ROOT=logs
-RETENTION_DIR=archives
-SERVICE=$1
+set -Eeuo pipefail
+shopt -s inherit_errexit
 
-TMP=/tmp/archive-logs.$$
-mkdir $TMP
+# Runs from cron: do not trust the caller's environment.
+PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
+export PATH
+export LC_ALL=C
+umask 077
 
-tar czf $TMP/$SERVICE.tar.gz $LOG_ROOT/$SERVICE
-mv $TMP/$SERVICE.tar.gz $RETENTION_DIR/$SERVICE-`date +%Y%m%d`.tar.gz
+readonly PROGNAME="${0##*/}"
+readonly LOG_ROOT=logs
+readonly RETENTION_DIR=archives
 
-rm -rf $TMP/*
+# Script scope: the EXIT trap runs after main has returned.
+workdir=''
 
-echo "archived $SERVICE"
+err() {
+  printf '%s: %s\n' "${PROGNAME}" "$*" >&2
+}
+
+usage() {
+  err "usage: ${PROGNAME} [--keep-days N] SERVICE [SERVICE...]"
+}
+
+cleanup() {
+  if [[ -n ${workdir} && -d ${workdir} ]]; then
+    rm -rf -- "${workdir}"
+  fi
+  return 0
+}
+
+# Clean up, then die of the signal so callers see the 128+n status.
+on_signal() {
+  local sig="$1"
+  cleanup
+  trap - EXIT "${sig}"
+  kill -s "${sig}" -- "$$"
+}
+
+# Archives one service's log directory into the retention directory.
+# Arguments: validated service name
+archive_service() {
+  local service="$1"
+  local stamp
+  stamp="$(date +%Y%m%d)"
+
+  if [[ ! -d ${LOG_ROOT}/${service} ]]; then
+    err "no log directory for service: ${service}"
+    return 1
+  fi
+
+  tar --create --gzip --file "${workdir}/${service}.tar.gz" \
+    -- "${LOG_ROOT}/${service}"
+  mv -- "${workdir}/${service}.tar.gz" \
+    "${RETENTION_DIR}/${service}-${stamp}.tar.gz"
+}
+
+# Prints the number of archives removed.
+# Arguments: age in days
+prune_archives() {
+  local days="$1"
+  local file
+  local count=0
+
+  while IFS= read -r -d '' file; do
+    rm -f -- "${file}"
+    count=$((count + 1))
+  done < <(find "${RETENTION_DIR}" -maxdepth 1 -type f -name '*.tar.gz' \
+    -mtime "+${days}" -print0)
+  printf '%s\n' "${count}"
+}
+
+main() {
+  local keep_days=''
+  local -a services=()
+  local service pruned
+
+  while (($# > 0)); do
+    case $1 in
+      --keep-days)
+        if (($# < 2)); then
+          err "--keep-days requires a value"
+          usage
+          return 64
+        fi
+        keep_days="$2"
+        shift 2
+        ;;
+      --keep-days=*)
+        keep_days="${1#--keep-days=}"
+        shift
+        ;;
+      --)
+        shift
+        services+=("$@")
+        break
+        ;;
+      -*)
+        err "unknown option: $1"
+        usage
+        return 64
+        ;;
+      *)
+        services+=("$1")
+        shift
+        ;;
+    esac
+  done
+
+  if ((${#services[@]} == 0)); then
+    usage
+    return 64
+  fi
+  if [[ -n ${keep_days} && ! ${keep_days} =~ ^[0-9]{1,6}$ ]]; then
+    err "--keep-days needs a non-negative integer, got: ${keep_days}"
+    return 64
+  fi
+  # Validate every name before touching anything.
+  for service in "${services[@]}"; do
+    if [[ ! ${service} =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]]; then
+      err "invalid service name: ${service}"
+      return 64
+    fi
+  done
+  if [[ ! -d ${RETENTION_DIR} ]]; then
+    err "retention directory not found: ${RETENTION_DIR}"
+    return 1
+  fi
+
+  # Traps before mktemp; temp dir sits in the retention dir so mv is atomic.
+  trap cleanup EXIT
+  trap 'on_signal INT' INT
+  trap 'on_signal TERM' TERM
+  workdir="$(mktemp -d -- "${RETENTION_DIR}/.archive-logs.XXXXXX")"
+
+  for service in "${services[@]}"; do
+    archive_service "${service}"
+  done
+
+  if [[ -n ${keep_days} ]]; then
+    pruned="$(prune_archives "${keep_days}")"
+    printf 'archived %d service(s): %s; pruned %d archive(s) older than %d day(s)\n' \
+      "${#services[@]}" "${services[*]}" "${pruned}" "${keep_days}"
+  else
+    printf 'archived %d service(s): %s\n' \
+      "${#services[@]}" "${services[*]}"
+  fi
+}
+
+main "$@"
