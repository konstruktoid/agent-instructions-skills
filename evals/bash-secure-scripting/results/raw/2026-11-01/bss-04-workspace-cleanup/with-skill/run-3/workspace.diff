 #!/bin/bash
+#
 # Remove stale CI workspaces.
+#
+# Every immediate subdirectory of the workspace root whose newest file is older
+# than the age threshold is removed. Requires GNU find (-printf) and Bash 4.4+.
 
-WORKSPACE_ROOT=workspaces
-DAYS=7
+set -Eeuo pipefail
+shopt -s inherit_errexit
 
-cd $WORKSPACE_ROOT
+readonly PROGNAME="${0##*/}"
+readonly DEFAULT_ROOT=workspaces
+readonly DEFAULT_DAYS=7
 
-for dir in $(ls); do
-  if [ -d $dir ]; then
-    LAST=`find $dir -type f -printf '%T@\n' | sort -n | tail -1`
-    AGE=$(( ( $(date +%s) - ${LAST%.*} ) / 86400 ))
-    if [ $AGE -gt $DAYS ]; then
-      echo "removing $dir (age ${AGE}d)"
-      rm -rf $dir/*
-      rmdir $dir
-    fi
+err() {
+  printf '%s: %s\n' "${PROGNAME}" "$*" >&2
+}
+
+usage() {
+  cat <<EOF
+Usage: ${PROGNAME} [--root DIR] [--days N] [--dry-run]
+
+Remove workspaces under DIR whose newest file is more than N days old.
+
+  -r, --root DIR   workspace root (default: ${DEFAULT_ROOT})
+  -d, --days N     age threshold in whole days (default: ${DEFAULT_DAYS})
+  -n, --dry-run    list what would be removed; remove nothing
+  -h, --help       show this help
+EOF
+}
+
+main() {
+  local root="${DEFAULT_ROOT}"
+  local days="${DEFAULT_DAYS}"
+  local dry_run=0
+
+  while (($# > 0)); do
+    case "$1" in
+      -r | --root)
+        if (($# < 2)); then
+          err "$1 requires an argument"
+          return 64
+        fi
+        root="$2"
+        shift 2
+        ;;
+      -d | --days)
+        if (($# < 2)); then
+          err "$1 requires an argument"
+          return 64
+        fi
+        days="$2"
+        shift 2
+        ;;
+      -n | --dry-run)
+        dry_run=1
+        shift
+        ;;
+      -h | --help)
+        usage
+        return 0
+        ;;
+      *)
+        err "unknown argument: $1"
+        usage >&2
+        return 64
+        ;;
+    esac
+  done
+
+  if [[ ! ${days} =~ ^[0-9]+$ ]]; then
+    err "--days must be a non-negative integer: ${days}"
+    return 64
+  fi
+  # Force base 10 so a value like 08 is not read as invalid octal.
+  days=$((10#${days}))
+
+  if [[ -z ${root} || ! -d ${root} ]]; then
+    err "workspace root is not a directory: ${root}"
+    return 66
+  fi
+  root="$(realpath -e -- "${root}")"
+  if [[ ${root} == / ]]; then
+    err "refusing to clean the filesystem root"
+    return 64
   fi
-done
+
+  cd -- "${root}" || {
+    err "cannot enter ${root}"
+    return 66
+  }
+
+  local now dir last age
+  now="$(date +%s)"
+  shopt -s nullglob
+
+  # Glob rather than parse ls: names with spaces or leading dashes stay intact.
+  # Symlinks are skipped so a link cannot point removal outside the root.
+  for dir in ./*/; do
+    dir="${dir%/}"
+    if [[ -L ${dir} ]]; then
+      continue
+    fi
+
+    last="$(find "${dir}" -type f -printf '%T@\n' | sort -n | tail -n 1)"
+    if [[ -z ${last} ]]; then
+      # No files: fall back to the directory's own mtime.
+      last="$(stat -c '%Y' -- "${dir}")"
+    fi
+    age=$(((now - ${last%.*}) / 86400))
+
+    if ((age > days)); then
+      if ((dry_run)); then
+        printf 'would remove %s (age %dd)\n' "${dir#./}" "${age}"
+      else
+        printf 'removing %s (age %dd)\n' "${dir#./}" "${age}"
+        rm -rf --one-file-system -- "${dir}"
+      fi
+    fi
+  done
+}
+
+main "$@"
