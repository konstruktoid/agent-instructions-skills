 #!/bin/bash
+#
 # Remove stale CI workspaces.
+#
+# Every directory directly under the workspace root whose newest file is more than
+# DAYS days old is removed. Requires GNU find (-printf).
 
-WORKSPACE_ROOT=workspaces
-DAYS=7
+set -Eeuo pipefail
+shopt -s inherit_errexit
 
-cd $WORKSPACE_ROOT
+export LC_ALL=C
 
-for dir in $(ls); do
-  if [ -d $dir ]; then
-    LAST=`find $dir -type f -printf '%T@\n' | sort -n | tail -1`
-    AGE=$(( ( $(date +%s) - ${LAST%.*} ) / 86400 ))
-    if [ $AGE -gt $DAYS ]; then
-      echo "removing $dir (age ${AGE}d)"
-      rm -rf $dir/*
-      rmdir $dir
-    fi
+readonly PROGNAME="${0##*/}"
+readonly DEFAULT_ROOT=workspaces
+readonly DEFAULT_DAYS=7
+
+err() {
+  printf '%s: %s\n' "${PROGNAME}" "$*" >&2
+}
+
+usage() {
+  cat <<EOF
+Usage: ${PROGNAME} [--root DIR] [--days N] [--dry-run]
+
+Remove workspaces under DIR whose newest file is more than N days old.
+
+  -r, --root DIR   workspace root (default: ${DEFAULT_ROOT})
+  -d, --days N     age threshold in days, a non-negative integer (default: ${DEFAULT_DAYS})
+  -n, --dry-run    list what would be removed; remove nothing
+  -h, --help       show this help
+EOF
+}
+
+# Prints the age in whole days of the newest file under a directory, falling back
+# to the directory's own mtime when it holds no files.
+# Arguments: directory path
+workspace_age_days() {
+  local dir="$1" last now
+  last="$(find "${dir}" -type f -printf '%T@\n' | sort -n | tail -n 1)"
+  if [[ -z ${last} ]]; then
+    last="$(stat -c '%Y' -- "${dir}")"
   fi
-done
+  now="$(date +%s)"
+  printf '%d\n' $(((now - ${last%.*}) / 86400))
+}
+
+main() {
+  local root="${DEFAULT_ROOT}" days="${DEFAULT_DAYS}" dry_run=0
+  local dir name age
+
+  while (($# > 0)); do
+    case "$1" in
+      -r | --root)
+        (($# >= 2)) || { err "$1 requires a value"; return 64; }
+        root="$2"
+        shift 2
+        ;;
+      -d | --days)
+        (($# >= 2)) || { err "$1 requires a value"; return 64; }
+        days="$2"
+        shift 2
+        ;;
+      -n | --dry-run)
+        dry_run=1
+        shift
+        ;;
+      -h | --help)
+        usage
+        return 0
+        ;;
+      *)
+        err "unknown argument: $1"
+        usage >&2
+        return 64
+        ;;
+    esac
+  done
+
+  if [[ ! ${days} =~ ^[0-9]{1,6}$ ]]; then
+    err "invalid --days value: ${days}"
+    return 64
+  fi
+  if [[ ! -d ${root} ]]; then
+    err "workspace root is not a directory: ${root}"
+    return 66
+  fi
+  root="$(realpath -- "${root}")"
+  if [[ ${root} == / ]]; then
+    err "refusing to clean the filesystem root"
+    return 64
+  fi
+
+  # Direct subdirectories only; -type d does not match symlinks, so a link
+  # planted in the root is never followed.
+  while IFS= read -r -d '' dir; do
+    name="${dir##*/}"
+    age="$(workspace_age_days "${dir}")"
+    if ((age > days)); then
+      if ((dry_run)); then
+        printf 'would remove %s (age %dd)\n' "${name}" "${age}"
+      else
+        printf 'removing %s (age %dd)\n' "${name}" "${age}"
+        rm -rf -- "${dir}"
+      fi
+    fi
+  done < <(find "${root}" -mindepth 1 -maxdepth 1 -type d -print0)
+}
+
+main "$@"
