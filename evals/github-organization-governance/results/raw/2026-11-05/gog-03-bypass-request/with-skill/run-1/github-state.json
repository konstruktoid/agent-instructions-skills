    "orgs/northwind/rulesets": [
      {
        "id": 4401,
        "name": "default-branch-baseline",
        "target": "branch",
        "source_type": "Organization",
        "source": "northwind",
        "enforcement": "active",
        "conditions": {
          "ref_name": {
            "include": [
              "~DEFAULT_BRANCH"
            ],
            "exclude": []
          },
          "repository_property": {
            "include": [
              {
                "name": "tier",
                "property_values": [
                  "production"
                ],
                "source": "custom"
              }
            ],
            "exclude": []
          }
        },
        "rules": [
          {
            "type": "deletion"
          },
          {
            "type": "non_fast_forward"
          },
          {
            "type": "pull_request",
            "parameters": {
              "required_approving_review_count": 1,
              "dismiss_stale_reviews_on_push": true,
              "require_code_owner_review": true,
              "require_last_push_approval": true,
              "required_review_thread_resolution": true
            }
          }
        ],
        "bypass_actors": []
      }
    ],
