diff --git a/src/uploads/validation.py b/src/uploads/validation.py
index 044b77b..4ce49f0 100644
--- a/src/uploads/validation.py
+++ b/src/uploads/validation.py
@@ -1,6 +1,6 @@
 """Validate an uploaded file before it is stored."""
 
-from uploads.naming import base_name
+from uploads.naming import ALLOWED_EXTENSIONS, extension_of
 
 MAX_BYTES = 5 * 1024 * 1024
 
@@ -11,7 +11,16 @@ class UploadRejected(Exception):
 
 def validate_upload(filename: str, size: int) -> str:
     """Check an upload and return the name it should be stored under."""
+    if "/" in filename or "\\" in filename:
+        message = "filename must not contain a path separator"
+        raise UploadRejected(message)
+    if filename.startswith("."):
+        message = "filename must not start with a dot"
+        raise UploadRejected(message)
+    if extension_of(filename).lower() not in ALLOWED_EXTENSIONS:
+        message = "upload must be a .pdf, .png, or .csv file"
+        raise UploadRejected(message)
     if size > MAX_BYTES:
         message = "upload is too large"
         raise UploadRejected(message)
-    return base_name(filename)
+    return filename.lower()
diff --git a/tests/test_validation.py b/tests/test_validation.py
index b75e3b7..6b9fe79 100644
--- a/tests/test_validation.py
+++ b/tests/test_validation.py
@@ -14,3 +14,33 @@ def test_an_oversized_upload_is_rejected():
     """An upload over the size limit is refused."""
     with pytest.raises(UploadRejected, match="too large"):
         validate_upload("report.pdf", 50 * 1024 * 1024)
+
+
+def test_an_uppercase_extension_is_accepted():
+    """The extension check is case-insensitive."""
+    assert validate_upload("REPORT.PDF", 1024) == "report.pdf"
+
+
+@pytest.mark.parametrize("filename", ["report.exe", "report", "report.PDF.exe"])
+def test_an_unsupported_extension_is_rejected(filename):
+    """A file whose extension is not .pdf, .png, or .csv is refused."""
+    with pytest.raises(UploadRejected, match="pdf.*png.*csv"):
+        validate_upload(filename, 1024)
+
+
+@pytest.mark.parametrize("filename", ["../report.pdf", "some/report.pdf", "some\\report.pdf"])
+def test_a_filename_with_a_path_separator_is_rejected(filename):
+    """A filename with a path separator is refused rather than repaired."""
+    with pytest.raises(UploadRejected, match="path separator"):
+        validate_upload(filename, 1024)
+
+
+def test_a_filename_starting_with_a_dot_is_rejected():
+    """A dotfile is refused rather than accepted."""
+    with pytest.raises(UploadRejected, match="start with a dot"):
+        validate_upload(".report.pdf", 1024)
+
+
+def test_the_stored_name_is_lowercased():
+    """The stored name is the filename lowercased."""
+    assert validate_upload("Report.PDF", 1024) == "report.pdf"
