+
+
+def test_business_days_between_excludes_weekends_and_holidays():
+    """Monday to Saturday skips the Wednesday holiday and the weekend."""
+    assert business_days_between(MONDAY, SATURDAY) == 4
+
+
+def test_business_days_between_counts_start_when_it_qualifies():
+    """A single qualifying day counts once."""
+    assert business_days_between(MONDAY, datetime.date(2026, 7, 21)) == 1
+
+
+def test_business_days_between_excludes_end():
+    """The end date itself is never counted."""
+    assert business_days_between(MONDAY, MONDAY) == 0
+
+
+def test_business_days_between_returns_zero_when_end_before_start():
+    """An end date before start yields zero business days."""
+    assert business_days_between(MONDAY, datetime.date(2026, 7, 19)) == 0
+
+
+def test_business_days_between_skips_a_weekend_span():
+    """A span covering only weekend days has no business days."""
+    assert business_days_between(SATURDAY, datetime.date(2026, 7, 27)) == 0
