+def test_page_slice_includes_the_last_item_on_the_final_page(letters):
+    """The last item of the sequence must be reachable through paging."""
+    last_page = page_slice(letters, 3, 2)
+    assert "f" in last_page
+
+
+def test_page_slice_past_the_end_returns_an_empty_list(letters):
+    """A page beyond the final page has no items, not an error."""
+    assert page_slice(letters, 4, 2) == []
