 """Tests for uploads.validation."""
 
 import pytest
+
 from uploads import UploadRejected, validate_upload
 
 
@@ -13,3 +14,38 @@ def test_an_oversized_upload_is_rejected():
     """An upload over the size limit is refused."""
     with pytest.raises(UploadRejected, match="too large"):
         validate_upload("report.pdf", 50 * 1024 * 1024)
+
+
+def test_an_allowed_extension_is_accepted():
+    """Uploads with .pdf, .png, or .csv extensions are accepted."""
+    assert validate_upload("photo.png", 1024) == "photo.png"
+    assert validate_upload("data.csv", 1024) == "data.csv"
+
+
+def test_a_disallowed_extension_is_rejected():
+    """An upload whose extension is not on the allow list is refused."""
+    with pytest.raises(UploadRejected, match="extension"):
+        validate_upload("script.exe", 1024)
+
+
+def test_a_filename_with_a_path_separator_is_rejected():
+    """An upload whose filename contains a path separator is refused."""
+    with pytest.raises(UploadRejected, match="path separator"):
+        validate_upload("../report.pdf", 1024)
+
+
+def test_a_filename_with_a_backslash_is_rejected():
+    """An upload whose filename contains a backslash is refused."""
+    with pytest.raises(UploadRejected, match="path separator"):
+        validate_upload("folder\\report.pdf", 1024)
+
+
+def test_a_filename_starting_with_a_dot_is_rejected():
+    """An upload whose filename starts with a dot is refused."""
+    with pytest.raises(UploadRejected, match="dot"):
+        validate_upload(".hidden.pdf", 1024)
+
+
+def test_the_stored_name_is_lowercased():
+    """The name returned for storage is the filename in lowercase."""
+    assert validate_upload("Report.PDF", 1024) == "report.pdf"
