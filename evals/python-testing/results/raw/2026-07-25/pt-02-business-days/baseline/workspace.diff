         day += datetime.timedelta(days=1)
     return day
+
+
+def business_days_between(start: datetime.date, end: datetime.date) -> int:
+    """Return the number of weekdays from start up to but not including end."""
+    if end <= start:
+        return 0
+    count = 0
+    day = start
+    while day < end:
+        if not is_weekend(day):
+            count += 1
+        day += datetime.timedelta(days=1)
+    return count
