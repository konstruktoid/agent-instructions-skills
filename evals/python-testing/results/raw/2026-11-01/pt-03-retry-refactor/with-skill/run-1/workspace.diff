-        """Fetch a path, retrying on transport failure."""
+    def _with_retries(self, method: str, path: str) -> str:
+        """Call the transport, retrying on failure up to MAX_ATTEMPTS times."""
         last_error = None
         for _ in range(MAX_ATTEMPTS):
             self.attempts += 1
             try:
