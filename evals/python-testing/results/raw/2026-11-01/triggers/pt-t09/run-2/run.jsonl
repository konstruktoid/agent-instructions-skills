e and what record it should become, I can write tests for that behaviour instead."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":198,"cache_read_input_tokens":12678,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":198},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"852773a9-c2eb-4772-92de-9156a32cf506","uuid":"1b5a8250-e5a4-48b9-9a48-9fb50dcd6d83","timestamp":"2026-11-02T07:16:49.546Z","request_id":"req_011Cgdh4tDiJuN9uraMKxGN4"}
