 """Tests for paging.slicing."""
 
 import pytest
+
 from paging import page_count, page_slice
 
 
@@ -17,6 +18,28 @@ def test_page_slice_returns_the_requested_page(letters, page, per_page, expected
     assert page_slice(letters, page, per_page) == expected
 
 
+def test_page_slice_final_page_includes_last_item(letters):
+    """The last item is reachable on the final page."""
+    assert page_slice(letters, 3, 2) == letters[4:]
+    assert letters[-1] in page_slice(letters, page_count(len(letters), 2), 2)
+
+
+def test_page_slice_partial_final_page(letters):
+    """A short final page holds the remaining items."""
+    assert page_slice(letters, 2, 4) == letters[4:]
+
+
+def test_page_slice_covers_every_item_exactly_once(letters):
+    """Concatenating all pages reproduces the sequence."""
+    pages = [page_slice(letters, p, 4) for p in range(1, page_count(len(letters), 4) + 1)]
+    assert [x for page in pages for x in page] == letters
+
+
+def test_page_slice_past_the_end_is_empty(letters):
+    """A page beyond the last returns an empty list."""
+    assert page_slice(letters, 99, 2) == []
+
+
 @pytest.mark.parametrize(
     ("total", "per_page", "expected"),
     [(6, 2, 3), (7, 2, 4), (0, 2, 0)],
