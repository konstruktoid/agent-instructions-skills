 """Tests for paging.slicing."""
 
 import pytest
+
 from paging import page_count, page_slice
 
 
@@ -17,6 +18,27 @@ def test_page_slice_returns_the_requested_page(letters, page, per_page, expected
     assert page_slice(letters, page, per_page) == expected
 
 
+def test_page_slice_includes_the_final_item(letters):
+    """The last page holds the trailing items."""
+    assert page_slice(letters, 3, 2) == letters[4:6]
+    assert page_slice(letters, 2, 4) == letters[4:]
+
+
+@pytest.mark.parametrize("per_page", [1, 2, 4, 10])
+def test_every_item_appears_on_exactly_one_page(letters, per_page):
+    """Concatenating all pages reproduces the sequence."""
+    pages = [
+        page_slice(letters, p, per_page) for p in range(1, page_count(len(letters), per_page) + 1)
+    ]
+    assert [item for page in pages for item in page] == letters
+
+
+def test_page_slice_past_the_end_is_empty(letters):
+    """A page beyond the last returns an empty list."""
+    assert page_slice(letters, 4, 2) == []
+    assert page_slice(letters, 99, 2) == []
+
+
