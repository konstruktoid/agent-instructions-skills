+@pytest.mark.parametrize(
+    ("page", "per_page", "expected"),
+    [
+        (3, 2, ["e", "f"]),
+        (2, 4, ["e", "f"]),
+        (1, 6, ["a", "b", "c", "d", "e", "f"]),
+        (4, 2, []),
+        (9, 4, []),
+    ],
+)
+def test_page_slice_reaches_the_final_item_and_empty_past_the_end(
+    letters, page, per_page, expected
+):
+    """The last page is complete, and a page past the end is empty."""
+    assert page_slice(letters, page, per_page) == expected
+
+
+@pytest.mark.parametrize("per_page", [1, 2, 4, 6, 7])
+def test_page_slice_covers_every_item_exactly_once(letters, per_page):
+    """Concatenating all pages reproduces the sequence."""
+    pages = [
+        page_slice(letters, p, per_page) for p in range(1, page_count(len(letters), per_page) + 1)
+    ]
+    assert [item for page in pages for item in page] == letters
+
