 """Tests for paging.slicing."""
 
 import pytest
+
 from paging import page_count, page_slice
 
 
@@ -31,3 +32,25 @@ def test_page_slice_rejects_a_non_positive_page_size(letters, per_page):
     """A non-positive page size is a caller error."""
     with pytest.raises(ValueError, match="positive"):
         page_slice(letters, 1, per_page)
+
+
+def test_page_slice_includes_the_final_item(letters):
+    """The last, partial page holds the remaining items."""
+    assert page_slice(letters, 3, 2) == ["e", "f"]
+
+
+def test_page_slice_keeps_a_short_final_page(letters):
+    """A final page with fewer than per_page items is returned whole."""
+    assert page_slice(letters, 2, 4) == ["e", "f"]
+
+
+def test_page_slice_puts_every_item_on_exactly_one_page(letters):
+    """Concatenating all pages reproduces the sequence."""
+    pages = [page_slice(letters, n, 4) for n in range(1, page_count(len(letters), 4) + 1)]
+    assert [item for page in pages for item in page] == letters
+
+
+@pytest.mark.parametrize("page", [4, 10])
+def test_page_slice_past_the_end_is_empty(letters, page):
+    """A page beyond the last returns an empty list rather than raising."""
+    assert page_slice(letters, page, 2) == []
