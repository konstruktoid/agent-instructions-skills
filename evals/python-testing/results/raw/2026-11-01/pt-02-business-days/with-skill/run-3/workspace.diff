+
+
+def test_is_holiday_matches_company_holidays():
+    """A listed date is a holiday; an ordinary date is not."""
+    assert is_holiday(datetime.date(2026, 7, 22)) is True
+    assert is_holiday(MONDAY) is False
+
+
+def test_business_days_between_counts_start_and_excludes_end():
+    """Monday up to the next Monday is five weekdays, less the 22 July holiday."""
+    assert business_days_between(MONDAY, datetime.date(2026, 7, 27)) == 4
+    assert business_days_between(datetime.date(2026, 7, 27), datetime.date(2026, 8, 3)) == 5
+
+
+def test_business_days_between_skips_holidays():
+    """Wednesday 22 July is a company holiday, so it is not counted."""
+    assert business_days_between(MONDAY, datetime.date(2026, 7, 24)) == 3
+
+
+def test_business_days_between_holiday_end_is_excluded():
+    """The end date is never counted, holiday or not."""
+    assert business_days_between(MONDAY, datetime.date(2026, 7, 22)) == 2
+
+
+@pytest.mark.parametrize("end", [MONDAY, datetime.date(2026, 7, 19)])
+def test_business_days_between_is_zero_when_end_not_after_start(end):
+    """End on or before start returns 0."""
+    assert business_days_between(MONDAY, end) == 0
+
+
+def test_business_days_between_weekend_only_is_zero():
+    """A span covering only a weekend has no working days."""
