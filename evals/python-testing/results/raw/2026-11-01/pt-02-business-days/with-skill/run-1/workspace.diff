+
+def test_is_holiday_matches_company_holidays():
+    """Dates listed in HOLIDAYS are holidays; other dates are not."""
+    assert is_holiday(datetime.date(2026, 7, 22)) is True
+    assert is_holiday(MONDAY) is False
+
+
+def test_business_days_between_counts_start_not_end():
+    """Monday to Saturday covers Monday to Friday, minus the Wednesday holiday."""
+    assert business_days_between(MONDAY, SATURDAY) == 4
+
+
+def test_business_days_between_skips_weekends():
+    """Monday to the next Monday is five weekdays, minus the Wednesday holiday."""
+    assert business_days_between(MONDAY, datetime.date(2026, 7, 27)) == 4
+
+
+def test_business_days_between_skips_holidays():
+    """Wednesday 22 July is a company holiday, so it is not counted."""
+    assert business_days_between(MONDAY, datetime.date(2026, 7, 24)) == 3
+
+
+def test_business_days_between_start_on_weekend_not_counted():
+    """A weekend start does not qualify."""
+    assert business_days_between(SATURDAY, datetime.date(2026, 7, 28)) == 1
+
+
+@pytest.mark.parametrize("end", [MONDAY, datetime.date(2026, 7, 19)])
+def test_business_days_between_end_on_or_before_start_is_zero(end):
