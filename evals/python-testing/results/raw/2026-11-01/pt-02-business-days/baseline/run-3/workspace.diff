+
+def test_is_holiday_matches_company_holidays():
+    """Listed ISO dates are holidays; other dates are not."""
+    assert is_holiday(datetime.date(2026, 7, 22))
+    assert not is_holiday(MONDAY)
+
+
+def test_business_days_between_skips_weekend_and_counts_start():
+    """Monday up to Saturday is five working days outside holidays."""
+    assert business_days_between(datetime.date(2026, 7, 27), datetime.date(2026, 8, 3)) == 5
+
+
+def test_business_days_between_skips_holidays():
+    """The 22 July holiday is not counted."""
+    assert business_days_between(MONDAY, datetime.date(2026, 7, 27)) == 4
+    assert business_days_between(datetime.date(2026, 7, 21), datetime.date(2026, 7, 24)) == 2
+
+
+def test_business_days_between_empty_ranges():
+    """End on or before start gives zero."""
+    assert business_days_between(MONDAY, MONDAY) == 0
+    assert business_days_between(MONDAY, datetime.date(2026, 7, 1)) == 0
