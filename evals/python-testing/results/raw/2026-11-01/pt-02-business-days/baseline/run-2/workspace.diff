+def test_is_holiday_matches_listed_dates():
+    """Listed company holidays are recognised."""
+    assert is_holiday(datetime.date(2026, 7, 22))
+    assert not is_holiday(MONDAY)
+
+
+def test_business_days_skips_weekend_and_holiday():
+    """Mon 20th to Mon 27th: the 22nd is a holiday, the weekend is skipped."""
+    assert business_days_between(MONDAY, datetime.date(2026, 7, 27)) == 4
+
+
+def test_business_days_counts_start_excludes_end():
+    """A plain week with no holiday counts five days."""
+    assert business_days_between(datetime.date(2026, 8, 3), datetime.date(2026, 8, 10)) == 5
+
+
+def test_business_days_end_on_or_before_start():
+    """Empty or reversed ranges return 0."""
+    assert business_days_between(MONDAY, MONDAY) == 0
+    assert business_days_between(MONDAY, datetime.date(2026, 7, 1)) == 0
