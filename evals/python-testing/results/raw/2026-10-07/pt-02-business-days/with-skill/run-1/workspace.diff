+
+
+def test_is_holiday():
+    """Company holidays are recognised; other days are not."""
+    assert is_holiday(datetime.date(2026, 7, 22)) is True
+    assert is_holiday(MONDAY) is False
+
+
+def test_business_days_between_counts_start_but_not_end():
+    """Monday up to the next Monday is four working days (one holiday)."""
+    assert business_days_between(MONDAY, datetime.date(2026, 7, 27)) == 4
+
+
+def test_business_days_between_skips_weekends():
+    """Monday up to Saturday is four working days; the weekend adds none."""
+    assert business_days_between(MONDAY, SATURDAY) == 4
+    assert business_days_between(SATURDAY, datetime.date(2026, 7, 27)) == 0
+
+
+def test_business_days_between_skips_holidays():
+    """The 22 July holiday is not counted."""
+    assert business_days_between(MONDAY, datetime.date(2026, 7, 24)) == 3
+
+
+@pytest.mark.parametrize("end", [MONDAY, datetime.date(2026, 7, 19)])
+def test_business_days_between_is_zero_when_end_not_after_start(end):
+    """An end on or before start yields zero."""
+    assert business_days_between(MONDAY, end) == 0
