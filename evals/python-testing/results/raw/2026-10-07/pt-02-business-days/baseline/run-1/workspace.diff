+
+
+def test_is_holiday():
+    """Listed company holidays are holidays; other dates are not."""
+    assert is_holiday(datetime.date(2026, 7, 22)) is True
+    assert is_holiday(MONDAY) is False
+
+
+def test_business_days_between_excludes_end_and_weekend():
+    """Monday 27 July up to the next Monday is five working days."""
+    assert business_days_between(datetime.date(2026, 7, 27), datetime.date(2026, 8, 3)) == 5
+
+
+def test_business_days_between_skips_holidays():
+    """The Wednesday 22 July holiday is not counted."""
+    assert business_days_between(MONDAY, datetime.date(2026, 7, 27)) == 4
+    assert business_days_between(MONDAY, datetime.date(2026, 7, 24)) == 3
+
+
+def test_business_days_between_counts_start_only_when_it_qualifies():
+    """A weekend start is not counted."""
+    assert business_days_between(SATURDAY, datetime.date(2026, 7, 28)) == 1
+
+
+@pytest.mark.parametrize("end", [MONDAY, datetime.date(2026, 7, 19)])
+def test_business_days_between_is_zero_when_end_not_after_start(end):
+    """End on or before start yields zero."""
+    assert business_days_between(MONDAY, end) == 0
