+
+
+def test_is_holiday():
+    """Listed company holidays are holidays; other dates are not."""
+    assert is_holiday(datetime.date(2026, 12, 25)) is True
+    assert is_holiday(MONDAY) is False
+
+
+def test_business_days_between_counts_start_but_not_end():
+    """Monday up to the next Monday covers five working days less the holiday."""
+    assert business_days_between(datetime.date(2026, 7, 27), datetime.date(2026, 8, 3)) == 5
+
+
+def test_business_days_between_skips_weekends():
+    """The end day is excluded and weekend starts count nothing."""
+    assert business_days_between(SATURDAY, datetime.date(2026, 7, 27)) == 0
+    assert business_days_between(datetime.date(2026, 7, 24), SUNDAY) == 1
+
+
+def test_business_days_between_skips_holidays():
+    """The 2026-07-22 holiday (a Wednesday) is not counted."""
+    assert business_days_between(MONDAY, datetime.date(2026, 7, 27)) == 4
+    assert business_days_between(datetime.date(2026, 7, 22), datetime.date(2026, 7, 23)) == 0
+
+
+def test_business_days_between_empty_or_reversed_range():
+    """End on or before start gives 0."""
+    assert business_days_between(MONDAY, MONDAY) == 0
+    assert business_days_between(datetime.date(2026, 7, 27), MONDAY) == 0
