diff --git a/src/uploads/naming.py b/src/uploads/naming.py
index 1f9816b..c09264c 100644
--- a/src/uploads/naming.py
+++ b/src/uploads/naming.py
@@ -10,4 +10,5 @@ def base_name(filename: str) -> str:
 
 def extension_of(filename: str) -> str:
     """Return the extension of a filename, without the leading dot."""
-    return filename.rsplit(".", 1)[-1]
+    _, dot, extension = filename.rpartition(".")
+    return extension if dot else ""
diff --git a/src/uploads/validation.py b/src/uploads/validation.py
index 044b77b..a97b106 100644
--- a/src/uploads/validation.py
+++ b/src/uploads/validation.py
@@ -1,6 +1,6 @@
 """Validate an uploaded file before it is stored."""
 
-from uploads.naming import base_name
+from uploads.naming import ALLOWED_EXTENSIONS, extension_of
 
 MAX_BYTES = 5 * 1024 * 1024
 
@@ -14,4 +14,13 @@ def validate_upload(filename: str, size: int) -> str:
     if size > MAX_BYTES:
         message = "upload is too large"
         raise UploadRejected(message)
-    return base_name(filename)
+    if "/" in filename or "\\" in filename:
+        message = "filename must not contain a path separator"
+        raise UploadRejected(message)
+    if filename.startswith("."):
+        message = "filename must not start with a dot"
+        raise UploadRejected(message)
+    if extension_of(filename).lower() not in ALLOWED_EXTENSIONS:
+        message = "file extension is not allowed"
+        raise UploadRejected(message)
+    return filename.lower()
diff --git a/tests/test_validation.py b/tests/test_validation.py
index b75e3b7..3aa92ac 100644
--- a/tests/test_validation.py
+++ b/tests/test_validation.py
@@ -14,3 +14,30 @@ def test_an_oversized_upload_is_rejected():
     """An upload over the size limit is refused."""
     with pytest.raises(UploadRejected, match="too large"):
         validate_upload("report.pdf", 50 * 1024 * 1024)
+
+
+@pytest.mark.parametrize("filename", ["report.pdf", "REPORT.PDF", "image.PnG", "data.Csv"])
+def test_allowed_extensions_are_accepted_in_any_case(filename):
+    """The extension check ignores case."""
+    assert validate_upload(filename, 1024) == filename.lower()
+
+
+@pytest.mark.parametrize("filename", ["report.txt", "report", "pdf", "report.", "report.pdf.exe"])
+def test_a_disallowed_extension_is_rejected(filename):
+    """Anything outside pdf, png and csv is refused, including a missing extension."""
+    with pytest.raises(UploadRejected, match="extension"):
+        validate_upload(filename, 1024)
+
+
+@pytest.mark.parametrize("filename", ["a/report.pdf", "a\\report.pdf", "../report.pdf", "/x.pdf"])
+def test_a_path_separator_is_rejected_not_repaired(filename):
+    """A filename with either kind of separator is refused rather than stripped."""
+    with pytest.raises(UploadRejected, match="path separator"):
+        validate_upload(filename, 1024)
+
+
+@pytest.mark.parametrize("filename", [".hidden.pdf", ".pdf"])
+def test_a_leading_dot_is_rejected(filename):
+    """A filename starting with a dot is refused."""
+    with pytest.raises(UploadRejected, match="start with a dot"):
+        validate_upload(filename, 1024)
