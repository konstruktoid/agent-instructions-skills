+@pytest.mark.parametrize(
+    ("page", "per_page", "expected"),
+    [
+        (3, 2, ["e", "f"]),
+        (2, 4, ["e", "f"]),
+        (4, 2, []),
+        (10, 2, []),
+    ],
+)
+def test_page_slice_reaches_the_end_and_past_it(letters, page, per_page, expected):
+    """The last item is reachable and a page past the end is empty."""
+    assert page_slice(letters, page, per_page) == expected
+
+
+def test_page_slice_puts_every_item_on_exactly_one_page(letters):
+    """Concatenating all pages reproduces the sequence."""
+    pages = [page_slice(letters, n, 4) for n in range(1, page_count(len(letters), 4) + 1)]
+    assert [item for page in pages for item in page] == letters
+
