 import pytest
+
 from paging import page_count, page_slice
 
 
@@ -17,6 +18,22 @@ def test_page_slice_returns_the_requested_page(letters, page, per_page, expected
     assert page_slice(letters, page, per_page) == expected
 
 
+def test_page_slice_includes_the_final_item(letters):
+    """The last page holds the trailing items, including the very last one."""
+    assert page_slice(letters, 3, 2) == ["e", "f"]
+
+
+def test_page_slice_covers_every_item_exactly_once(letters):
+    """Concatenating all pages reproduces the sequence."""
+    pages = [page_slice(letters, n, 4) for n in range(1, page_count(len(letters), 4) + 1)]
+    assert [item for page in pages for item in page] == letters
+
+
+def test_page_slice_past_the_end_is_empty(letters):
+    """A page beyond the last returns an empty list."""
+    assert page_slice(letters, 4, 2) == []
+
+
