@@ -0,0 +1,10 @@
+# Bucket and kms_key_id are supplied with `terraform init -backend-config=backend.hcl`
+# (see backend.hcl.example). Locking uses an S3 lock object, so no DynamoDB table is needed.
+terraform {
+  backend "s3" {
+    key          = "reports/terraform.tfstate"
+    region       = "eu-north-1"
+    encrypt      = true
+    use_lockfile = true
+  }
+}
