diff --git a/bootstrap/variables.tf b/bootstrap/variables.tf
new file mode 100644
index 0000000..ef42072
--- /dev/null
+++ b/bootstrap/variables.tf
@@ -0,0 +1,20 @@
+variable "region" {
+  type        = string
+  default     = "eu-north-1"
+  description = "Region the state bucket and its encryption key are created in."
+}
+
+variable "state_bucket_name" {
+  type        = string
+  description = "Globally unique name of the S3 bucket that holds Terraform state. Choose a name that is not guessable from other public names."
+}
+
+variable "state_access_principal_arns" {
+  type        = list(string)
+  description = "IAM role or user ARNs allowed to read and write state objects and use the encryption key. Only these principals, plus the account root for key administration, can reach state."
+
+  validation {
+    condition     = length(var.state_access_principal_arns) > 0
+    error_message = "At least one principal ARN is required."
+  }
+}
