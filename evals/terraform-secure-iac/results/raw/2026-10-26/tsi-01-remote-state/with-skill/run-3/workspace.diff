diff --git a/bootstrap/variables.tf b/bootstrap/variables.tf
new file mode 100644
index 0000000..3e7fb99
--- /dev/null
+++ b/bootstrap/variables.tf
@@ -0,0 +1,16 @@
+variable "region" {
+  type        = string
+  description = "AWS region the state bucket is created in. The backend block in the parent configuration must use the same region."
+  default     = "eu-north-1"
+}
+
+variable "state_bucket_name" {
+  type        = string
+  description = "Name of the S3 bucket that holds Terraform state. S3 bucket names are global, so choose a name unique to your organization."
+}
+
+variable "noncurrent_version_expiration_days" {
+  type        = number
+  description = "Days a superseded state version is kept before it is deleted. Older versions are the rollback path for a corrupt state file."
+  default     = 90
+}
