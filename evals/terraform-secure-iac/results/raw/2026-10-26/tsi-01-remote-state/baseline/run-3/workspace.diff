new file mode 100644
index 0000000..40cbdd4
--- /dev/null
+++ b/backend.tf
@@ -0,0 +1,10 @@
+# Bucket is created by bootstrap/. Its name is account-specific, so it is supplied at init time:
+#   terraform init -backend-config=backend.hcl
+terraform {
+  backend "s3" {
+    key          = "reports/terraform.tfstate"
+    region       = "eu-north-1"
+    encrypt      = true
+    use_lockfile = true
+  }
+}
