diff --git a/ci_access.tf b/ci_access.tf
new file mode 100644
index 0000000..3b6bbfa
--- /dev/null
+++ b/ci_access.tf
@@ -0,0 +1,248 @@
+locals {
+  ci_repository   = "platform/ingest"
+  state_bucket    = "ingest-terraform-state"
+  state_key       = "ingest/terraform.tfstate"
+  ci_role_arns    = [aws_iam_role.ci_plan.arn, aws_iam_role.ci_apply.arn]
+  ci_oidc_url     = "token.actions.githubusercontent.com"
+  ci_session_secs = 3600
+}
+
+resource "aws_iam_openid_connect_provider" "github" {
+  url            = "https://${local.ci_oidc_url}"
+  client_id_list = ["sts.amazonaws.com"]
+}
+
+# Plan role: assumable only by pull_request runs of the ingest repository.
+data "aws_iam_policy_document" "ci_plan_trust" {
+  statement {
+    actions = ["sts:AssumeRoleWithWebIdentity"]
+
+    principals {
+      type        = "Federated"
+      identifiers = [aws_iam_openid_connect_provider.github.arn]
+    }
+
+    condition {
+      test     = "StringEquals"
+      variable = "${local.ci_oidc_url}:aud"
+      values   = ["sts.amazonaws.com"]
+    }
+
+    condition {
+      test     = "StringEquals"
+      variable = "${local.ci_oidc_url}:sub"
+      values   = ["repo:${local.ci_repository}:pull_request"]
+    }
+  }
+}
+
+# Apply role: assumable only by runs on the main branch of the ingest repository.
+data "aws_iam_policy_document" "ci_apply_trust" {
+  statement {
+    actions = ["sts:AssumeRoleWithWebIdentity"]
+
+    principals {
+      type        = "Federated"
+      identifiers = [aws_iam_openid_connect_provider.github.arn]
+    }
+
+    condition {
+      test     = "StringEquals"
+      variable = "${local.ci_oidc_url}:aud"
+      values   = ["sts.amazonaws.com"]
+    }
+
+    condition {
+      test     = "StringEquals"
+      variable = "${local.ci_oidc_url}:sub"
+      values   = ["repo:${local.ci_repository}:ref:refs/heads/main"]
+    }
+  }
+}
+
+resource "aws_iam_role" "ci_plan" {
+  name                 = "ingest-ci-plan"
+  assume_role_policy   = data.aws_iam_policy_document.ci_plan_trust.json
+  max_session_duration = local.ci_session_secs
+}
+
+resource "aws_iam_role" "ci_apply" {
+  name                 = "ingest-ci-apply"
+  assume_role_policy   = data.aws_iam_policy_document.ci_apply_trust.json
+  max_session_duration = local.ci_session_secs
+}
+
+# Read access to the managed resources, needed by both roles to refresh state.
+data "aws_iam_policy_document" "ci_read" {
+  statement {
+    sid       = "ReadBucket"
+    actions   = ["s3:Get*", "s3:ListBucket"]
+    resources = [aws_s3_bucket.landing.arn]
+  }
+
+  statement {
+    sid = "ReadQueue"
+    actions = [
+      "sqs:GetQueueAttributes",
+      "sqs:GetQueueUrl",
+      "sqs:ListQueueTags",
+    ]
+    resources = [aws_sqs_queue.events.arn]
+  }
+
+  statement {
+    sid = "ReadTable"
+    actions = [
+      "dynamodb:DescribeTable",
+      "dynamodb:DescribeContinuousBackups",
+      "dynamodb:DescribeTimeToLive",
+      "dynamodb:ListTagsOfResource",
+    ]
+    resources = [aws_dynamodb_table.checkpoints.arn]
+  }
+
+  # The CI roles are in this configuration, so refresh must read them. They get
+  # no IAM write: changes to this file are applied by an administrator.
+  statement {
+    sid = "ReadCiIdentity"
+    actions = [
+      "iam:GetRole",
+      "iam:ListRolePolicies",
+      "iam:ListAttachedRolePolicies",
+      "iam:ListInstanceProfilesForRole",
+    ]
+    resources = local.ci_role_arns
+  }
+
+  statement {
+    sid       = "ReadOidcProvider"
+    actions   = ["iam:GetOpenIDConnectProvider"]
+    resources = [aws_iam_openid_connect_provider.github.arn]
+  }
+
+  statement {
+    sid       = "ReadCiRolePolicies"
+    actions   = ["iam:GetRolePolicy"]
+    resources = local.ci_role_arns
+  }
+
+  statement {
+    sid       = "ReadState"
+    actions   = ["s3:GetObject"]
+    resources = ["arn:aws:s3:::${local.state_bucket}/${local.state_key}"]
+  }
+
+  statement {
+    sid       = "ListStateBucket"
+    actions   = ["s3:ListBucket"]
+    resources = ["arn:aws:s3:::${local.state_bucket}"]
+
+    condition {
+      test     = "StringEquals"
+      variable = "s3:prefix"
+      values   = [local.state_key]
+    }
+  }
+}
+
+# Native S3 locking writes and removes a lock object next to the state.
+data "aws_iam_policy_document" "ci_state_lock" {
+  statement {
+    sid       = "StateLock"
+    actions   = ["s3:PutObject", "s3:DeleteObject"]
+    resources = ["arn:aws:s3:::${local.state_bucket}/${local.state_key}.tflock"]
+  }
+}
+
+data "aws_iam_policy_document" "ci_apply_write" {
+  statement {
+    sid = "WriteState"
+    actions = [
+      "s3:PutObject",
+    ]
+    resources = ["arn:aws:s3:::${local.state_bucket}/${local.state_key}"]
+  }
+
+  statement {
+    sid = "ManageBucket"
+    actions = [
+      "s3:CreateBucket",
+      "s3:DeleteBucket",
+      "s3:PutBucketTagging",
+      "s3:PutBucketVersioning",
+      "s3:PutEncryptionConfiguration",
+      "s3:PutBucketPublicAccessBlock",
+      "s3:PutBucketPolicy",
+      "s3:DeleteBucketPolicy",
+      "s3:PutBucketOwnershipControls",
+      "s3:PutLifecycleConfiguration",
+    ]
+    resources = [aws_s3_bucket.landing.arn]
+  }
+
+  statement {
+    sid = "ManageQueue"
+    actions = [
+      "sqs:CreateQueue",
+      "sqs:DeleteQueue",
+      "sqs:SetQueueAttributes",
+      "sqs:TagQueue",
+      "sqs:UntagQueue",
+    ]
+    resources = [aws_sqs_queue.events.arn]
+  }
+
+  statement {
+    sid = "ManageTable"
+    actions = [
+      "dynamodb:CreateTable",
+      "dynamodb:DeleteTable",
+      "dynamodb:UpdateTable",
+      "dynamodb:UpdateContinuousBackups",
+      "dynamodb:UpdateTimeToLive",
+      "dynamodb:TagResource",
+      "dynamodb:UntagResource",
+    ]
+    resources = [aws_dynamodb_table.checkpoints.arn]
+  }
+}
+
+resource "aws_iam_role_policy" "ci_plan_read" {
+  name   = "read"
+  role   = aws_iam_role.ci_plan.id
+  policy = data.aws_iam_policy_document.ci_read.json
+}
+
+resource "aws_iam_role_policy" "ci_plan_state_lock" {
+  name   = "state-lock"
+  role   = aws_iam_role.ci_plan.id
+  policy = data.aws_iam_policy_document.ci_state_lock.json
+}
+
+resource "aws_iam_role_policy" "ci_apply_read" {
+  name   = "read"
+  role   = aws_iam_role.ci_apply.id
+  policy = data.aws_iam_policy_document.ci_read.json
+}
+
+resource "aws_iam_role_policy" "ci_apply_state_lock" {
+  name   = "state-lock"
+  role   = aws_iam_role.ci_apply.id
+  policy = data.aws_iam_policy_document.ci_state_lock.json
+}
+
+resource "aws_iam_role_policy" "ci_apply_write" {
+  name   = "write"
+  role   = aws_iam_role.ci_apply.id
+  policy = data.aws_iam_policy_document.ci_apply_write.json
+}
+
+output "ci_plan_role_arn" {
+  description = "Role the pull_request plan job assumes through GitHub OIDC."
+  value       = aws_iam_role.ci_plan.arn
+}
+
+output "ci_apply_role_arn" {
+  description = "Role the main-branch apply job assumes through GitHub OIDC."
+  value       = aws_iam_role.ci_apply.arn
+}
