diff --git a/ci.tf b/ci.tf
new file mode 100644
index 0000000..a1a52f7
--- /dev/null
+++ b/ci.tf
@@ -0,0 +1,209 @@
+data "aws_caller_identity" "current" {}
+data "aws_partition" "current" {}
+
+locals {
+  github_oidc_url  = "https://token.actions.githubusercontent.com"
+  state_bucket     = "ingest-terraform-state"
+  state_key        = "ingest/terraform.tfstate"
+  state_bucket_arn = "arn:${data.aws_partition.current.partition}:s3:::${local.state_bucket}"
+}
+
+resource "aws_iam_openid_connect_provider" "github" {
+  url            = local.github_oidc_url
+  client_id_list = ["sts.amazonaws.com"]
+}
+
+# Plan role: assumable from pull requests in the repository. Read-only on the managed
+# resources, plus the state lock object, which `use_lockfile` writes during plan.
+data "aws_iam_policy_document" "plan_trust" {
+  statement {
+    actions = ["sts:AssumeRoleWithWebIdentity"]
+
+    principals {
+      type        = "Federated"
+      identifiers = [aws_iam_openid_connect_provider.github.arn]
+    }
+
+    condition {
+      test     = "StringEquals"
+      variable = "token.actions.githubusercontent.com:aud"
+      values   = ["sts.amazonaws.com"]
+    }
+
+    condition {
+      test     = "StringEquals"
+      variable = "token.actions.githubusercontent.com:sub"
+      values   = ["repo:${var.github_repository}:pull_request"]
+    }
+  }
+}
+
+# Apply role: assumable only from workflow runs on the protected branch.
+data "aws_iam_policy_document" "apply_trust" {
+  statement {
+    actions = ["sts:AssumeRoleWithWebIdentity"]
+
+    principals {
+      type        = "Federated"
+      identifiers = [aws_iam_openid_connect_provider.github.arn]
+    }
+
+    condition {
+      test     = "StringEquals"
+      variable = "token.actions.githubusercontent.com:aud"
+      values   = ["sts.amazonaws.com"]
+    }
+
+    condition {
+      test     = "StringEquals"
+      variable = "token.actions.githubusercontent.com:sub"
+      values   = ["repo:${var.github_repository}:ref:refs/heads/${var.github_apply_branch}"]
+    }
+  }
+}
+
+resource "aws_iam_role" "ci_plan" {
+  name                 = "ingest-ci-plan"
+  assume_role_policy   = data.aws_iam_policy_document.plan_trust.json
+  max_session_duration = 3600
+}
+
+resource "aws_iam_role" "ci_apply" {
+  name                 = "ingest-ci-apply"
+  assume_role_policy   = data.aws_iam_policy_document.apply_trust.json
+  max_session_duration = 3600
+}
+
+locals {
+  s3_read_actions = [
+    "s3:GetAccelerateConfiguration",
+    "s3:GetBucketAcl",
+    "s3:GetBucketCORS",
+    "s3:GetBucketLocation",
+    "s3:GetBucketLogging",
+    "s3:GetBucketObjectLockConfiguration",
+    "s3:GetBucketOwnershipControls",
+    "s3:GetBucketPolicy",
+    "s3:GetBucketPublicAccessBlock",
+    "s3:GetBucketRequestPayment",
+    "s3:GetBucketTagging",
+    "s3:GetBucketVersioning",
+    "s3:GetBucketWebsite",
+    "s3:GetEncryptionConfiguration",
+    "s3:GetLifecycleConfiguration",
+    "s3:GetReplicationConfiguration",
+    "s3:ListBucket",
+  ]
+  sqs_read_actions = [
+    "sqs:GetQueueAttributes",
+    "sqs:GetQueueUrl",
+    "sqs:ListQueueTags",
+  ]
+  dynamodb_read_actions = [
+    "dynamodb:DescribeContinuousBackups",
+    "dynamodb:DescribeTable",
+    "dynamodb:DescribeTimeToLive",
+    "dynamodb:ListTagsOfResource",
+  ]
+}
+
+data "aws_iam_policy_document" "ci_state" {
+  statement {
+    sid       = "StateList"
+    actions   = ["s3:ListBucket"]
+    resources = [local.state_bucket_arn]
+  }
+
+  statement {
+    sid       = "StateRead"
+    actions   = ["s3:GetObject"]
+    resources = ["${local.state_bucket_arn}/${local.state_key}"]
+  }
+
+  statement {
+    sid       = "StateLock"
+    actions   = ["s3:PutObject", "s3:DeleteObject", "s3:GetObject"]
+    resources = ["${local.state_bucket_arn}/${local.state_key}.tflock"]
+  }
+}
+
+data "aws_iam_policy_document" "ci_plan" {
+  source_policy_documents = [data.aws_iam_policy_document.ci_state.json]
+
+  statement {
+    sid       = "ReadLanding"
+    actions   = local.s3_read_actions
+    resources = [aws_s3_bucket.landing.arn]
+  }
+
+  statement {
+    sid       = "ReadEvents"
+    actions   = local.sqs_read_actions
+    resources = [aws_sqs_queue.events.arn]
+  }
+
+  statement {
+    sid       = "ReadCheckpoints"
+    actions   = local.dynamodb_read_actions
+    resources = [aws_dynamodb_table.checkpoints.arn]
+  }
+}
+
+data "aws_iam_policy_document" "ci_apply" {
+  source_policy_documents = [data.aws_iam_policy_document.ci_plan.json]
+
+  # State object write, in addition to the read and lock grants inherited above.
+  statement {
+    sid       = "StateWrite"
+    actions   = ["s3:PutObject"]
+    resources = ["${local.state_bucket_arn}/${local.state_key}"]
+  }
+
+  statement {
+    sid = "ManageLanding"
+    actions = [
+      "s3:CreateBucket",
+      "s3:DeleteBucket",
+      "s3:PutBucketTagging",
+    ]
+    resources = [aws_s3_bucket.landing.arn]
+  }
+
+  statement {
+    sid = "ManageEvents"
+    actions = [
+      "sqs:CreateQueue",
+      "sqs:DeleteQueue",
+      "sqs:SetQueueAttributes",
+      "sqs:TagQueue",
+      "sqs:UntagQueue",
+    ]
+    resources = [aws_sqs_queue.events.arn]
+  }
+
+  statement {
+    sid = "ManageCheckpoints"
+    actions = [
+      "dynamodb:CreateTable",
+      "dynamodb:DeleteTable",
+      "dynamodb:TagResource",
+      "dynamodb:UntagResource",
+      "dynamodb:UpdateContinuousBackups",
+      "dynamodb:UpdateTable",
+      "dynamodb:UpdateTimeToLive",
+    ]
+    resources = [aws_dynamodb_table.checkpoints.arn]
+  }
+}
+
+resource "aws_iam_role_policy" "ci_plan" {
+  name   = "terraform-plan"
+  role   = aws_iam_role.ci_plan.id
+  policy = data.aws_iam_policy_document.ci_plan.json
+}
+
+resource "aws_iam_role_policy" "ci_apply" {
+  name   = "terraform-apply"
+  role   = aws_iam_role.ci_apply.id
+  policy = data.aws_iam_policy_document.ci_apply.json
+}
diff --git a/outputs.tf b/outputs.tf
new file mode 100644
