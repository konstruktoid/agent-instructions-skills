--- /dev/null
+++ b/outputs.tf
@@ -0,0 +1,9 @@
+output "ci_plan_role_arn" {
+  description = "ARN of the read-only role the pull-request plan job assumes through GitHub OIDC."
+  value       = aws_iam_role.ci_plan.arn
+}
+
+output "ci_apply_role_arn" {
+  description = "ARN of the role the apply job on the protected branch assumes through GitHub OIDC."
+  value       = aws_iam_role.ci_apply.arn
+}
diff --git a/variables.tf b/variables.tf
new file mode 100644
index 0000000..1713fd1
--- /dev/null
+++ b/variables.tf
@@ -0,0 +1,16 @@
+variable "github_repository" {
+  type        = string
+  description = "GitHub repository, as owner/name, whose workflows may assume the CI roles. Sets the repository in the OIDC subject claim the role trust policies match."
+  default     = "platform/ingest"
+
+  validation {
+    condition     = can(regex("^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", var.github_repository))
+    error_message = "github_repository must be in owner/name form with no wildcards."
+  }
+}
+
+variable "github_apply_branch" {
+  type        = string
+  description = "Branch whose workflow runs may assume the apply role. Sets the ref in the OIDC subject claim the apply role trust policy matches."
+  default     = "main"
+}
