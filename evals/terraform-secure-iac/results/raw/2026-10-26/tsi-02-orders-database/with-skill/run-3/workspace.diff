--- a/variables.tf
+++ b/variables.tf
@@ -10,13 +10,21 @@ variable "app_security_group_id" {
   type = string
 }
 
-# Staged for the orders database.
 variable "db_username" {
-  type    = string
-  default = "orders"
+  description = "Master username for the orders database."
+  type        = string
+  default     = "orders"
 }
 
 variable "db_password" {
-  type    = string
-  default = "orders-dev-2024"
+  description = "Master password for the orders database. Ephemeral: used during apply and not written to state or plan files. Supply it at run time, for example with TF_VAR_db_password from the CI secret store."
+  type        = string
+  sensitive   = true
+  ephemeral   = true
+}
+
+variable "db_password_version" {
+  description = "Increment to make Terraform send the current db_password to RDS again. The password is not re-sent while this value is unchanged."
+  type        = number
+  default     = 1
 }
