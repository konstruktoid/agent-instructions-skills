diff --git a/main.tf b/main.tf
index 1500571..66faaa4 100644
--- a/main.tf
+++ b/main.tf
@@ -14,3 +14,34 @@ resource "aws_db_subnet_group" "orders" {
   name       = "orders"
   subnet_ids = var.private_subnet_ids
 }
+
+resource "aws_db_instance" "orders" {
+  identifier = "orders"
+
+  engine         = "postgres"
+  engine_version = "16"
+  instance_class = "db.t4g.micro"
+
+  allocated_storage = 20
+  storage_type      = "gp3"
+  storage_encrypted = true
+
+  db_name  = "orders"
+  username = var.db_username
+
+  # Write-only: the password is sent to RDS but never stored in state or plan files.
+  # Bump db_password_version to rotate it.
+  password_wo         = var.db_password
+  password_wo_version = var.db_password_version
+
+  db_subnet_group_name   = aws_db_subnet_group.orders.name
+  vpc_security_group_ids = [aws_security_group.orders_db.id]
+  publicly_accessible    = false
+
+  backup_retention_period      = 7
+  deletion_protection          = true
+  copy_tags_to_snapshot        = true
+  skip_final_snapshot          = false
+  final_snapshot_identifier    = "orders-final"
+  performance_insights_enabled = true
+}
diff --git a/outputs.tf b/outputs.tf
index 856ecf0..a5100b6 100644
--- a/outputs.tf
+++ b/outputs.tf
@@ -1,3 +1,23 @@
 output "db_security_group_id" {
   value = aws_security_group.orders_db.id
 }
+
+output "db_address" {
+  description = "DNS name of the orders database instance."
+  value       = aws_db_instance.orders.address
+}
+
+output "db_port" {
+  description = "Port the orders database listens on."
+  value       = aws_db_instance.orders.port
+}
+
+output "db_name" {
+  description = "Name of the initial database on the orders instance."
+  value       = aws_db_instance.orders.db_name
+}
+
+output "db_username" {
+  description = "Master username for the orders database."
+  value       = var.db_username
+}
diff --git a/variables.tf b/variables.tf
index 5a3c309..451c796 100644
--- a/variables.tf
+++ b/variables.tf
@@ -12,11 +12,20 @@ variable "app_security_group_id" {
 
 # Staged for the orders database.
 variable "db_username" {
-  type    = string
-  default = "orders"
+  type        = string
+  description = "Master username for the orders database."
+  default     = "orders"
 }
 
 variable "db_password" {
-  type    = string
-  default = "orders-dev-2024"
+  type        = string
+  description = "Master password for the orders database. Supplied at run time, for example through TF_VAR_db_password, and not stored in state."
+  sensitive   = true
+  ephemeral   = true
+}
+
+variable "db_password_version" {
+  type        = number
+  description = "Version counter for db_password. Increasing it sends the current db_password value to RDS as the new master password."
+  default     = 1
 }
