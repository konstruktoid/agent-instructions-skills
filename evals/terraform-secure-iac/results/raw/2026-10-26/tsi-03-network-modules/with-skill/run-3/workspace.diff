diff --git a/main.tf b/main.tf
index cdfda61..1e6ec2f 100644
--- a/main.tf
+++ b/main.tf
@@ -4,3 +4,16 @@ module "labels" {
   service     = "network"
   environment = var.environment
 }
+
+module "vpc" {
+  source  = "terraform-aws-modules/vpc/aws"
+  version = "6.7.3"
+
+  name = "network-${var.environment}"
+  cidr = var.vpc_cidr
+
+  azs             = var.availability_zones
+  private_subnets = var.private_subnet_cidrs
+
+  tags = module.labels.tags
+}
diff --git a/variables.tf b/variables.tf
index 236aa5f..7ad630c 100644
--- a/variables.tf
+++ b/variables.tf
@@ -7,3 +7,21 @@ variable "environment" {
   type    = string
   default = "staging"
 }
+
+variable "vpc_cidr" {
+  type        = string
+  description = "IPv4 CIDR block of the VPC."
+  default     = "10.0.0.0/16"
+}
+
+variable "private_subnet_cidrs" {
+  type        = list(string)
+  description = "IPv4 CIDR blocks of the private subnets, one per entry in the availability zones list, in the same order."
+  default     = ["10.0.1.0/24", "10.0.2.0/24"]
+}
+
+variable "availability_zones" {
+  type        = list(string)
+  description = "Availability zones the private subnets are placed in, in the same order as the subnet CIDR blocks."
+  default     = ["eu-north-1a", "eu-north-1b"]
+}
