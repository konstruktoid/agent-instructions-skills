diff --git a/main.tf b/main.tf
index cdfda61..f50bb87 100644
--- a/main.tf
+++ b/main.tf
@@ -4,3 +4,18 @@ module "labels" {
   service     = "network"
   environment = var.environment
 }
+
+module "vpc" {
+  source  = "terraform-aws-modules/vpc/aws"
+  version = "~> 6.0"
+
+  name = "network-${var.environment}"
+  cidr = var.vpc_cidr
+
+  azs             = ["${var.region}a", "${var.region}b"]
+  private_subnets = var.private_subnet_cidrs
+
+  enable_nat_gateway = false
+
+  tags = module.labels.tags
+}
diff --git a/variables.tf b/variables.tf
index 236aa5f..13364cb 100644
--- a/variables.tf
+++ b/variables.tf
@@ -7,3 +7,13 @@ variable "environment" {
   type    = string
   default = "staging"
 }
+
+variable "vpc_cidr" {
+  type    = string
+  default = "10.0.0.0/16"
+}
+
+variable "private_subnet_cidrs" {
+  type    = list(string)
+  default = ["10.0.1.0/24", "10.0.2.0/24"]
+}
diff --git a/versions.tf b/versions.tf
index bcdeda0..a4a0f16 100644
--- a/versions.tf
+++ b/versions.tf
@@ -2,7 +2,7 @@ terraform {
   required_providers {
     aws = {
       source  = "hashicorp/aws"
-      version = ">= 4.0"
+      version = "~> 6.0"
     }
   }
 
