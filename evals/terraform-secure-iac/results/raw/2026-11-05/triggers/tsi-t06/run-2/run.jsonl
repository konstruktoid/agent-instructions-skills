er to.\n","numLines":14,"startLine":1,"totalLines":14}},"tool_result_meta":[{"id":"toolu_01UXfT2N2p7mqUBDVwC8hxTB","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
