diff --git a/ci.tf b/ci.tf
new file mode 100644
index 0000000..ae4c6dd
--- /dev/null
+++ b/ci.tf
@@ -0,0 +1,304 @@
+variable "github_repository" {
+  description = "GitHub repository (owner/name) whose Actions workflow may assume the CI roles."
+  type        = string
+  default     = "platform/ingest"
+}
+
+variable "state_bucket" {
+  description = "Name of the S3 bucket holding this configuration's remote state, as set in the backend block."
+  type        = string
+  default     = "ingest-terraform-state"
+}
+
+variable "state_key" {
+  description = "Object key of the state file in the state bucket, as set in the backend block."
+  type        = string
+  default     = "ingest/terraform.tfstate"
+}
+
+data "aws_caller_identity" "current" {}
+
+data "aws_partition" "current" {}
+
+locals {
+  partition  = data.aws_partition.current.partition
+  account_id = data.aws_caller_identity.current.account_id
+
+  state_bucket_arn = "arn:${local.partition}:s3:::${var.state_bucket}"
+  state_object_arn = "${local.state_bucket_arn}/${var.state_key}"
+  lock_object_arn  = "${local.state_bucket_arn}/${var.state_key}.tflock"
+
+  landing_bucket_arn = aws_s3_bucket.landing.arn
+  events_queue_arn   = aws_sqs_queue.events.arn
+  checkpoints_arn    = aws_dynamodb_table.checkpoints.arn
+}
+
+# One GitHub OIDC provider exists per account. If another configuration already
+# manages it, import it here or replace this resource with a data source.
+resource "aws_iam_openid_connect_provider" "github" {
+  url            = "https://token.actions.githubusercontent.com"
+  client_id_list = ["sts.amazonaws.com"]
+}
+
+# ---------------------------------------------------------------------------
+# Plan role: assumed by pull_request runs, read-only on managed resources.
+# ---------------------------------------------------------------------------
+
+data "aws_iam_policy_document" "plan_trust" {
+  statement {
+    actions = ["sts:AssumeRoleWithWebIdentity"]
+
+    principals {
+      type        = "Federated"
+      identifiers = [aws_iam_openid_connect_provider.github.arn]
+    }
+
+    condition {
+      test     = "StringEquals"
+      variable = "token.actions.githubusercontent.com:aud"
+      values   = ["sts.amazonaws.com"]
+    }
+
+    condition {
+      test     = "StringEquals"
+      variable = "token.actions.githubusercontent.com:sub"
+      values   = ["repo:${var.github_repository}:pull_request"]
+    }
+  }
+}
+
+resource "aws_iam_role" "ci_plan" {
+  name                 = "ingest-ci-plan"
+  description          = "Assumed by the pull_request workflow in ${var.github_repository} to run terraform plan."
+  assume_role_policy   = data.aws_iam_policy_document.plan_trust.json
+  max_session_duration = 3600
+}
+
+data "aws_iam_policy_document" "plan" {
+  statement {
+    sid       = "StateRead"
+    actions   = ["s3:GetObject"]
+    resources = [local.state_object_arn]
+  }
+
+  statement {
+    sid       = "StateList"
+    actions   = ["s3:ListBucket"]
+    resources = [local.state_bucket_arn]
+
+    condition {
+      test     = "StringEquals"
+      variable = "s3:prefix"
+      values   = [var.state_key]
+    }
+  }
+
+  # use_lockfile makes plan write and remove a lock object next to the state.
+  statement {
+    sid       = "StateLock"
+    actions   = ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"]
+    resources = [local.lock_object_arn]
+  }
+
+  statement {
+    sid = "RefreshLandingBucket"
+    actions = [
+      "s3:ListBucket",
+      "s3:GetBucketLocation",
+      "s3:GetBucketPolicy",
+      "s3:GetBucketAcl",
+      "s3:GetBucketCORS",
+      "s3:GetBucketLogging",
+      "s3:GetBucketObjectLockConfiguration",
+      "s3:GetBucketOwnershipControls",
+      "s3:GetBucketPublicAccessBlock",
+      "s3:GetBucketRequestPayment",
+      "s3:GetBucketTagging",
+      "s3:GetBucketVersioning",
+      "s3:GetBucketWebsite",
+      "s3:GetAccelerateConfiguration",
+      "s3:GetEncryptionConfiguration",
+      "s3:GetLifecycleConfiguration",
+      "s3:GetReplicationConfiguration",
+    ]
+    resources = [local.landing_bucket_arn]
+  }
+
+  statement {
+    sid = "RefreshEventsQueue"
+    actions = [
+      "sqs:GetQueueAttributes",
+      "sqs:GetQueueUrl",
+      "sqs:ListQueueTags",
+    ]
+    resources = [local.events_queue_arn]
+  }
+
+  statement {
+    sid = "RefreshCheckpointsTable"
+    actions = [
+      "dynamodb:DescribeTable",
+      "dynamodb:DescribeContinuousBackups",
+      "dynamodb:DescribeTimeToLive",
+      "dynamodb:ListTagsOfResource",
+    ]
+    resources = [local.checkpoints_arn]
+  }
+
+  # These calls do not support resource-level permissions.
+  statement {
+    sid       = "ListQueuesForLookup"
+    actions   = ["sqs:ListQueues"]
+    resources = ["*"]
+  }
+}
+
+resource "aws_iam_role_policy" "ci_plan" {
+  name   = "terraform-plan"
+  role   = aws_iam_role.ci_plan.id
+  policy = data.aws_iam_policy_document.plan.json
+}
+
+# ---------------------------------------------------------------------------
+# Apply role: assumed only by runs on main, write access scoped to the three
+# managed resources and the state objects. No IAM permissions.
+# ---------------------------------------------------------------------------
+
+data "aws_iam_policy_document" "apply_trust" {
+  statement {
+    actions = ["sts:AssumeRoleWithWebIdentity"]
+
+    principals {
+      type        = "Federated"
+      identifiers = [aws_iam_openid_connect_provider.github.arn]
+    }
+
+    condition {
+      test     = "StringEquals"
+      variable = "token.actions.githubusercontent.com:aud"
+      values   = ["sts.amazonaws.com"]
+    }
+
+    condition {
+      test     = "StringEquals"
+      variable = "token.actions.githubusercontent.com:sub"
+      values   = ["repo:${var.github_repository}:ref:refs/heads/main"]
+    }
+  }
+}
+
+resource "aws_iam_role" "ci_apply" {
+  name                 = "ingest-ci-apply"
+  description          = "Assumed by the main-branch workflow in ${var.github_repository} to run terraform apply."
+  assume_role_policy   = data.aws_iam_policy_document.apply_trust.json
+  max_session_duration = 3600
+}
+
+data "aws_iam_policy_document" "apply" {
+  statement {
+    sid       = "StateReadWrite"
+    actions   = ["s3:GetObject", "s3:PutObject"]
+    resources = [local.state_object_arn]
+  }
+
+  statement {
+    sid       = "StateLock"
+    actions   = ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"]
+    resources = [local.lock_object_arn]
+  }
+
+  statement {
+    sid       = "StateList"
+    actions   = ["s3:ListBucket"]
+    resources = [local.state_bucket_arn]
+
+    condition {
+      test     = "StringEquals"
+      variable = "s3:prefix"
+      values   = [var.state_key]
+    }
+  }
+
+  statement {
+    sid = "ManageLandingBucket"
+    actions = [
+      "s3:CreateBucket",
+      "s3:DeleteBucket",
+      "s3:ListBucket",
+      "s3:GetBucketLocation",
+      "s3:GetBucketPolicy",
+      "s3:PutBucketPolicy",
+      "s3:DeleteBucketPolicy",
+      "s3:GetBucketAcl",
+      "s3:GetBucketCORS",
+      "s3:GetBucketLogging",
+      "s3:GetBucketObjectLockConfiguration",
+      "s3:GetBucketOwnershipControls",
+      "s3:GetBucketPublicAccessBlock",
+      "s3:GetBucketRequestPayment",
+      "s3:GetBucketTagging",
+      "s3:PutBucketTagging",
+      "s3:GetBucketVersioning",
+      "s3:GetBucketWebsite",
+      "s3:GetAccelerateConfiguration",
+      "s3:GetEncryptionConfiguration",
+      "s3:GetLifecycleConfiguration",
+      "s3:GetReplicationConfiguration",
+    ]
+    resources = [local.landing_bucket_arn]
+  }
+
+  statement {
+    sid = "ManageEventsQueue"
+    actions = [
+      "sqs:CreateQueue",
+      "sqs:DeleteQueue",
+      "sqs:GetQueueAttributes",
+      "sqs:GetQueueUrl",
+      "sqs:SetQueueAttributes",
+      "sqs:ListQueueTags",
+      "sqs:TagQueue",
+      "sqs:UntagQueue",
+    ]
+    resources = [local.events_queue_arn]
+  }
+
+  statement {
+    sid = "ManageCheckpointsTable"
+    actions = [
+      "dynamodb:CreateTable",
+      "dynamodb:DeleteTable",
+      "dynamodb:UpdateTable",
+      "dynamodb:DescribeTable",
+      "dynamodb:DescribeContinuousBackups",
+      "dynamodb:DescribeTimeToLive",
+      "dynamodb:ListTagsOfResource",
+      "dynamodb:TagResource",
+      "dynamodb:UntagResource",
+    ]
+    resources = [local.checkpoints_arn]
+  }
+
+  # These calls do not support resource-level permissions.
+  statement {
+    sid       = "ListQueuesForLookup"
+    actions   = ["sqs:ListQueues"]
+    resources = ["*"]
+  }
+}
+
+resource "aws_iam_role_policy" "ci_apply" {
+  name   = "terraform-apply"
+  role   = aws_iam_role.ci_apply.id
+  policy = data.aws_iam_policy_document.apply.json
+}
+
+output "ci_plan_role_arn" {
+  description = "ARN of the role the pull_request workflow assumes to run terraform plan."
+  value       = aws_iam_role.ci_plan.arn
+}
+
+output "ci_apply_role_arn" {
+  description = "ARN of the role the main-branch workflow assumes to run terraform apply."
+  value       = aws_iam_role.ci_apply.arn
+}
