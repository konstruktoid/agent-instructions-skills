+}
diff --git a/variables.tf b/variables.tf
new file mode 100644
index 0000000..1f8e9e1
--- /dev/null
+++ b/variables.tf
@@ -0,0 +1,28 @@
+variable "github_repository" {
+  type        = string
+  description = "GitHub repository, in owner/name form, whose workflow may assume the CI roles. Only workflow runs from this repository are trusted."
+  default     = "platform/ingest"
+
+  validation {
+    condition     = can(regex("^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", var.github_repository))
+    error_message = "github_repository must be in owner/name form with no wildcards."
+  }
+}
+
+variable "apply_branch" {
+  type        = string
+  description = "Branch whose workflow runs may assume the apply role. Runs from any other ref are refused."
+  default     = "main"
+}
+
+variable "state_bucket" {
+  type        = string
+  description = "Name of the S3 bucket holding this configuration's remote state. Must match the backend block in versions.tf."
+  default     = "ingest-terraform-state"
+}
+
+variable "state_key" {
+  type        = string
+  description = "Object key of this configuration's state file in the state bucket. Must match the backend block in versions.tf."
+  default     = "ingest/terraform.tfstate"
+}
