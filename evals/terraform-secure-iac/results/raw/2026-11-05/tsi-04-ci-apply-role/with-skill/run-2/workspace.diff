diff --git a/ci.tf b/ci.tf
new file mode 100644
index 0000000..b924cdb
--- /dev/null
+++ b/ci.tf
@@ -0,0 +1,202 @@
+# AWS side of the CI handover: the platform/ingest GitHub Actions workflow
+# authenticates through OIDC and assumes one of two roles. No static keys exist.
+#   plan  - pull requests; read-only on the managed resources.
+#   apply - merges to main, via a protected GitHub environment (see locals).
+
+locals {
+  github_repo = "platform/ingest"
+  # Apply is bound to the main branch via the job's GitHub environment. Protect
+  # the "ingest-apply" environment (required reviewers, main-only deployments).
+  github_apply_environment = "ingest-apply"
+
+  state_bucket_arn   = "arn:aws:s3:::ingest-terraform-state"
+  state_object_arn   = "${local.state_bucket_arn}/ingest/terraform.tfstate"
+  state_lockfile_arn = "${local.state_bucket_arn}/ingest/terraform.tfstate.tflock"
+
+  managed_bucket_arn = aws_s3_bucket.landing.arn
+  managed_queue_arn  = aws_sqs_queue.events.arn
+  managed_table_arn  = aws_dynamodb_table.checkpoints.arn
+}
+
+resource "aws_iam_openid_connect_provider" "github" {
+  url            = "https://token.actions.githubusercontent.com"
+  client_id_list = ["sts.amazonaws.com"]
+  # AWS validates GitHub's certificate chain against its trusted CA library;
+  # thumbprint_list is not required.
+}
+
+# ---------- plan role (pull requests, read-only) ----------
+
+data "aws_iam_policy_document" "plan_trust" {
+  statement {
+    actions = ["sts:AssumeRoleWithWebIdentity"]
+    principals {
+      type        = "Federated"
+      identifiers = [aws_iam_openid_connect_provider.github.arn]
+    }
+    condition {
+      test     = "StringEquals"
+      variable = "token.actions.githubusercontent.com:aud"
+      values   = ["sts.amazonaws.com"]
+    }
+    condition {
+      test     = "StringEquals"
+      variable = "token.actions.githubusercontent.com:sub"
+      values   = ["repo:${local.github_repo}:pull_request"]
+    }
+  }
+}
+
+resource "aws_iam_role" "ci_plan" {
+  name                 = "ingest-ci-plan"
+  description          = "Assumed by the platform/ingest pull-request workflow to run terraform plan."
+  assume_role_policy   = data.aws_iam_policy_document.plan_trust.json
+  max_session_duration = 3600
+}
+
+data "aws_iam_policy_document" "plan" {
+  statement {
+    sid       = "StateRead"
+    actions   = ["s3:GetObject"]
+    resources = [local.state_object_arn]
+  }
+  statement {
+    sid       = "StateBucketList"
+    actions   = ["s3:ListBucket"]
+    resources = [local.state_bucket_arn]
+  }
+  # use_lockfile needs write on the lock object only; state itself stays read-only.
+  statement {
+    sid       = "StateLock"
+    actions   = ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"]
+    resources = [local.state_lockfile_arn]
+  }
+  statement {
+    sid = "RefreshBucket"
+    actions = [
+      "s3:GetBucketAcl", "s3:GetBucketCORS", "s3:GetBucketLocation", "s3:GetBucketLogging",
+      "s3:GetBucketObjectLockConfiguration", "s3:GetBucketOwnershipControls",
+      "s3:GetBucketPolicy", "s3:GetBucketPublicAccessBlock", "s3:GetBucketRequestPayment",
+      "s3:GetBucketTagging", "s3:GetBucketVersioning", "s3:GetBucketWebsite",
+      "s3:GetAccelerateConfiguration", "s3:GetEncryptionConfiguration",
+      "s3:GetLifecycleConfiguration", "s3:GetReplicationConfiguration", "s3:ListBucket",
+    ]
+    resources = [local.managed_bucket_arn]
+  }
+  statement {
+    sid       = "RefreshQueue"
+    actions   = ["sqs:GetQueueAttributes", "sqs:GetQueueUrl", "sqs:ListQueueTags"]
+    resources = [local.managed_queue_arn]
+  }
+  statement {
+    sid = "RefreshTable"
+    actions = [
+      "dynamodb:DescribeTable", "dynamodb:DescribeContinuousBackups",
+      "dynamodb:DescribeTimeToLive", "dynamodb:ListTagsOfResource",
+    ]
+    resources = [local.managed_table_arn]
+  }
+}
+
+resource "aws_iam_role_policy" "ci_plan" {
+  name   = "plan"
+  role   = aws_iam_role.ci_plan.id
+  policy = data.aws_iam_policy_document.plan.json
+}
+
+# ---------- apply role (main branch, approval-gated environment) ----------
+
+data "aws_iam_policy_document" "apply_trust" {
+  statement {
+    actions = ["sts:AssumeRoleWithWebIdentity"]
+    principals {
+      type        = "Federated"
+      identifiers = [aws_iam_openid_connect_provider.github.arn]
+    }
+    condition {
+      test     = "StringEquals"
+      variable = "token.actions.githubusercontent.com:aud"
+      values   = ["sts.amazonaws.com"]
+    }
+    condition {
+      test     = "StringEquals"
+      variable = "token.actions.githubusercontent.com:sub"
+      values   = ["repo:${local.github_repo}:environment:${local.github_apply_environment}"]
+    }
+  }
+}
+
+resource "aws_iam_role" "ci_apply" {
+  name                 = "ingest-ci-apply"
+  description          = "Assumed by the platform/ingest merge workflow to run terraform apply."
+  assume_role_policy   = data.aws_iam_policy_document.apply_trust.json
+  max_session_duration = 3600
+}
+
+data "aws_iam_policy_document" "apply" {
+  statement {
+    sid       = "StateReadWrite"
+    actions   = ["s3:GetObject", "s3:PutObject"]
+    resources = [local.state_object_arn]
+  }
+  statement {
+    sid       = "StateLock"
+    actions   = ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"]
+    resources = [local.state_lockfile_arn]
+  }
+  statement {
+    sid       = "StateBucketList"
+    actions   = ["s3:ListBucket"]
+    resources = [local.state_bucket_arn]
+  }
+  statement {
+    sid = "ManageBucket"
+    actions = [
+      "s3:CreateBucket", "s3:DeleteBucket",
+      "s3:GetBucketAcl", "s3:GetBucketCORS", "s3:GetBucketLocation", "s3:GetBucketLogging",
+      "s3:GetBucketObjectLockConfiguration", "s3:GetBucketOwnershipControls",
+      "s3:GetBucketPolicy", "s3:GetBucketPublicAccessBlock", "s3:GetBucketRequestPayment",
+      "s3:GetBucketTagging", "s3:GetBucketVersioning", "s3:GetBucketWebsite",
+      "s3:GetAccelerateConfiguration", "s3:GetEncryptionConfiguration",
+      "s3:GetLifecycleConfiguration", "s3:GetReplicationConfiguration", "s3:ListBucket",
+      "s3:PutBucketTagging", "s3:PutBucketVersioning", "s3:PutBucketPublicAccessBlock",
+      "s3:PutBucketOwnershipControls", "s3:PutEncryptionConfiguration",
+      "s3:PutLifecycleConfiguration", "s3:PutBucketPolicy", "s3:DeleteBucketPolicy",
+    ]
+    resources = [local.managed_bucket_arn]
+  }
+  statement {
+    sid = "ManageQueue"
+    actions = [
+      "sqs:CreateQueue", "sqs:DeleteQueue", "sqs:GetQueueAttributes", "sqs:GetQueueUrl",
+      "sqs:ListQueueTags", "sqs:SetQueueAttributes", "sqs:TagQueue", "sqs:UntagQueue",
+    ]
+    resources = [local.managed_queue_arn]
+  }
+  statement {
+    sid = "ManageTable"
+    actions = [
+      "dynamodb:CreateTable", "dynamodb:DeleteTable", "dynamodb:UpdateTable",
+      "dynamodb:DescribeTable", "dynamodb:DescribeContinuousBackups",
+      "dynamodb:DescribeTimeToLive", "dynamodb:ListTagsOfResource",
+      "dynamodb:TagResource", "dynamodb:UntagResource",
+    ]
+    resources = [local.managed_table_arn]
+  }
+}
+
+resource "aws_iam_role_policy" "ci_apply" {
+  name   = "apply"
+  role   = aws_iam_role.ci_apply.id
+  policy = data.aws_iam_policy_document.apply.json
+}
+
+output "ci_plan_role_arn" {
+  description = "ARN of the role the pull-request workflow assumes for terraform plan."
+  value       = aws_iam_role.ci_plan.arn
+}
+
+output "ci_apply_role_arn" {
+  description = "ARN of the role the merge workflow assumes for terraform apply."
+  value       = aws_iam_role.ci_apply.arn
+}
