diff --git a/.gitignore b/.gitignore
new file mode 100644
index 0000000..415e7f4
--- /dev/null
+++ b/.gitignore
@@ -0,0 +1,6 @@
+.terraform/
+*.tfstate
+*.tfstate.*
+*.tfplan
+crash.log
+crash.*.log
diff --git a/main.tf b/main.tf
index cdfda61..371fa26 100644
--- a/main.tf
+++ b/main.tf
@@ -4,3 +4,16 @@ module "labels" {
   service     = "network"
   environment = var.environment
 }
+
+module "vpc" {
+  source  = "terraform-aws-modules/vpc/aws"
+  version = "6.7.3"
+
+  name = "network-${var.environment}"
+  cidr = var.vpc_cidr
+
+  azs             = var.availability_zones
+  private_subnets = var.private_subnet_cidrs
+
+  # Tags reach every resource through the provider's default_tags, which are set from module.labels.
+}
diff --git a/variables.tf b/variables.tf
index 236aa5f..9299990 100644
--- a/variables.tf
+++ b/variables.tf
@@ -7,3 +7,21 @@ variable "environment" {
   type    = string
   default = "staging"
 }
+
+variable "vpc_cidr" {
+  type        = string
+  description = "IPv4 CIDR block of the VPC."
+  default     = "10.0.0.0/16"
+}
+
+variable "availability_zones" {
+  type        = list(string)
+  description = "Availability zones that receive one private subnet each, in the same order as private_subnet_cidrs."
+  default     = ["eu-north-1a", "eu-north-1b"]
+}
+
+variable "private_subnet_cidrs" {
+  type        = list(string)
+  description = "IPv4 CIDR blocks of the private subnets, one per entry in availability_zones."
+  default     = ["10.0.1.0/24", "10.0.2.0/24"]
+}
diff --git a/versions.tf b/versions.tf
index bcdeda0..a57677a 100644
--- a/versions.tf
+++ b/versions.tf
@@ -1,8 +1,10 @@
 terraform {
+  required_version = ">= 1.10"
+
   required_providers {
     aws = {
       source  = "hashicorp/aws"
-      version = ">= 4.0"
+      version = "~> 6.0"
     }
   }
 
