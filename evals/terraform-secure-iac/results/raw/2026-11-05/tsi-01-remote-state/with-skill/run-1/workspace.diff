diff --git a/bootstrap/variables.tf b/bootstrap/variables.tf
new file mode 100644
index 0000000..f720751
--- /dev/null
+++ b/bootstrap/variables.tf
@@ -0,0 +1,25 @@
+variable "region" {
+  type        = string
+  description = "AWS region the state bucket is created in. Must match the region in the backend block of the root configuration."
+  default     = "eu-north-1"
+}
+
+variable "state_bucket_name" {
+  type        = string
+  description = "Name of the S3 bucket that holds Terraform state. S3 bucket names are global, so choose one that is unique to your organization."
+
+  validation {
+    condition     = can(regex("^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$", var.state_bucket_name))
+    error_message = "The bucket name must be 3-63 characters of lowercase letters, digits, dots, and hyphens."
+  }
+}
+
+variable "state_access_principal_arns" {
+  type        = list(string)
+  description = "IAM role or user ARNs allowed to read and write state objects. Access is denied to every other principal except the identity that applies this configuration."
+
+  validation {
+    condition     = length(var.state_access_principal_arns) > 0
+    error_message = "Provide at least one principal ARN."
+  }
+}
