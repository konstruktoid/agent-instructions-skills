@@ -0,0 +1,9 @@
+output "state_bucket_name" {
+  value       = aws_s3_bucket.state.id
+  description = "Name of the state bucket, for the bucket argument of the backend block."
+}
+
+output "state_kms_key_arn" {
+  value       = aws_kms_key.state.arn
+  description = "ARN of the key that encrypts state. Principals that run Terraform need kms:Encrypt, kms:Decrypt, and kms:GenerateDataKey on it."
+}
