index 0000000..fc6aa86
--- /dev/null
+++ b/backend.tf
@@ -0,0 +1,10 @@
+# Partial configuration: the bucket name is passed at init time
+# (terraform init -backend-config="bucket=<name>"), see README.
+terraform {
+  backend "s3" {
+    key          = "reports/terraform.tfstate"
+    region       = "eu-north-1"
+    encrypt      = true
+    use_lockfile = true
+  }
+}
