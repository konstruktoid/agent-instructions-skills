t."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":173,"cache_read_input_tokens":13556,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":173},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"636e21fa-010e-4f09-86d6-9674a7c582b4","uuid":"ca2a2e9c-c909-4ece-8f19-f011a5c812eb","timestamp":"2026-10-28T09:27:56.175Z","request_id":"req_011CgUQ29eoQjejjF9ZrGyMm"}
