index 0000000..dab72ba
--- /dev/null
+++ b/ci.tf
@@ -0,0 +1,210 @@
+# AWS side of the GitHub Actions handover for the platform/ingest repository.
+#
+# Two roles, split by trust:
+#   - ci_plan:  assumable from pull_request runs; read-only plus the state lock.
+#   - ci_apply: assumable ONLY from runs on refs/heads/main; can change the
+#               resources in this configuration. It has no IAM permissions, so
+#               it cannot grant itself or anyone else more access.
+#
+# Bootstrap: apply this once from a laptop, then set the role ARNs as GitHub
+# variables. The workflow needs `permissions: id-token: write`.
+
+locals {
+  github_repo = "platform/ingest"
+
+  state_bucket = "ingest-terraform-state"
+  state_key    = "ingest/terraform.tfstate"
+
+  landing_bucket_arn = "arn:aws:s3:::ingest-landing-staging"
+  queue_arn          = "arn:aws:sqs:eu-north-1:${data.aws_caller_identity.current.account_id}:ingest-events-staging"
+  table_arn          = "arn:aws:dynamodb:eu-north-1:${data.aws_caller_identity.current.account_id}:table/ingest-checkpoints-staging"
+}
+
+data "aws_caller_identity" "current" {}
+
+# An account can hold only one provider per URL. If GitHub's already exists in
+# this account, import it (terraform import aws_iam_openid_connect_provider.github <arn>).
+resource "aws_iam_openid_connect_provider" "github" {
+  url            = "https://token.actions.githubusercontent.com"
+  client_id_list = ["sts.amazonaws.com"]
+}
+
+data "aws_iam_policy_document" "plan_trust" {
+  statement {
+    actions = ["sts:AssumeRoleWithWebIdentity"]
+
+    principals {
+      type        = "Federated"
+      identifiers = [aws_iam_openid_connect_provider.github.arn]
+    }
+
+    condition {
+      test     = "StringEquals"
+      variable = "token.actions.githubusercontent.com:aud"
+      values   = ["sts.amazonaws.com"]
+    }
+
+    condition {
+      test     = "StringEquals"
+      variable = "token.actions.githubusercontent.com:sub"
+      values   = ["repo:${local.github_repo}:pull_request"]
+    }
+  }
+}
+
+data "aws_iam_policy_document" "apply_trust" {
+  statement {
+    actions = ["sts:AssumeRoleWithWebIdentity"]
+
+    principals {
+      type        = "Federated"
+      identifiers = [aws_iam_openid_connect_provider.github.arn]
+    }
+
+    condition {
+      test     = "StringEquals"
+      variable = "token.actions.githubusercontent.com:aud"
+      values   = ["sts.amazonaws.com"]
+    }
+
+    condition {
+      test     = "StringEquals"
+      variable = "token.actions.githubusercontent.com:sub"
+      values   = ["repo:${local.github_repo}:ref:refs/heads/main"]
+    }
+  }
+}
+
+# --- State backend access (S3 native locking, use_lockfile = true) ---
+
+data "aws_iam_policy_document" "state_read" {
+  statement {
+    sid       = "StateList"
+    actions   = ["s3:ListBucket"]
+    resources = ["arn:aws:s3:::${local.state_bucket}"]
+    condition {
+      test     = "StringLike"
+      variable = "s3:prefix"
+      values   = [local.state_key, "${local.state_key}.tflock"]
+    }
+  }
+
+  statement {
+    sid       = "StateRead"
+    actions   = ["s3:GetObject"]
+    resources = ["arn:aws:s3:::${local.state_bucket}/${local.state_key}"]
+  }
+
+  statement {
+    sid       = "StateLock"
+    actions   = ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"]
+    resources = ["arn:aws:s3:::${local.state_bucket}/${local.state_key}.tflock"]
+  }
+}
+
+data "aws_iam_policy_document" "state_write" {
+  statement {
+    sid       = "StateWrite"
+    actions   = ["s3:PutObject"]
+    resources = ["arn:aws:s3:::${local.state_bucket}/${local.state_key}"]
+  }
+}
+
+# --- Read-only access to the managed resources (refresh during plan) ---
+
+data "aws_iam_policy_document" "managed_read" {
+  statement {
+    sid       = "S3Read"
+    actions   = ["s3:Get*", "s3:ListBucket"]
+    resources = [local.landing_bucket_arn]
+  }
+
+  statement {
+    sid       = "SqsRead"
+    actions   = ["sqs:GetQueueAttributes", "sqs:GetQueueUrl", "sqs:ListQueueTags"]
+    resources = [local.queue_arn]
+  }
+
+  statement {
+    sid = "DynamoRead"
+    actions = [
+      "dynamodb:DescribeTable",
+      "dynamodb:DescribeContinuousBackups",
+      "dynamodb:DescribeTimeToLive",
+      "dynamodb:ListTagsOfResource",
+    ]
+    resources = [local.table_arn]
+  }
+}
+
+# --- Write access to the managed resources (apply) ---
+
+data "aws_iam_policy_document" "managed_write" {
+  statement {
+    sid       = "S3Manage"
+    actions   = ["s3:*"]
+    resources = [local.landing_bucket_arn]
+  }
+
+  statement {
+    sid       = "SqsManage"
+    actions   = ["sqs:*"]
+    resources = [local.queue_arn]
+  }
+
+  statement {
+    sid       = "DynamoManage"
+    actions   = ["dynamodb:*"]
+    resources = [local.table_arn]
+  }
+}
+
+resource "aws_iam_role" "ci_plan" {
+  name                 = "ingest-ci-plan"
+  assume_role_policy   = data.aws_iam_policy_document.plan_trust.json
+  max_session_duration = 3600
+}
+
+resource "aws_iam_role_policy" "ci_plan_state" {
+  name   = "state"
+  role   = aws_iam_role.ci_plan.id
+  policy = data.aws_iam_policy_document.state_read.json
+}
+
+resource "aws_iam_role_policy" "ci_plan_read" {
+  name   = "managed-read"
+  role   = aws_iam_role.ci_plan.id
+  policy = data.aws_iam_policy_document.managed_read.json
+}
+
+resource "aws_iam_role" "ci_apply" {
+  name                 = "ingest-ci-apply"
+  assume_role_policy   = data.aws_iam_policy_document.apply_trust.json
+  max_session_duration = 3600
+}
+
+resource "aws_iam_role_policy" "ci_apply_state" {
+  name   = "state"
+  role   = aws_iam_role.ci_apply.id
+  policy = data.aws_iam_policy_document.state_read.json
+}
+
+resource "aws_iam_role_policy" "ci_apply_state_write" {
+  name   = "state-write"
+  role   = aws_iam_role.ci_apply.id
+  policy = data.aws_iam_policy_document.state_write.json
+}
+
