@@ -0,0 +1,9 @@
+output "ci_plan_role_arn" {
+  description = "ARN of the role pull_request workflow runs assume to run terraform plan."
+  value       = aws_iam_role.plan.arn
+}
+
+output "ci_apply_role_arn" {
