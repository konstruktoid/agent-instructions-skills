diff --git a/ci_access.tf b/ci_access.tf
new file mode 100644
index 0000000..50c32e7
--- /dev/null
+++ b/ci_access.tf
@@ -0,0 +1,194 @@
+# AWS side of the GitHub Actions handover: an OIDC provider and two roles.
+#   - plan:  assumed by pull_request runs, read-only on the managed resources.
+#   - apply: assumed only by runs on the protected branch, write on the managed resources.
+# No static keys are issued; each run exchanges its GitHub token for a one-hour session.
+
+locals {
+  github_oidc_url = "token.actions.githubusercontent.com"
+  github_oidc_arn = aws_iam_openid_connect_provider.github.arn
+
+  state_object_arn = "arn:aws:s3:::${var.state_bucket}/${var.state_key}"
+  lock_object_arn  = "arn:aws:s3:::${var.state_bucket}/${var.state_key}.tflock"
+
+  bucket_read = [
+    "s3:GetAccelerateConfiguration", "s3:GetBucketAcl", "s3:GetBucketCORS",
+    "s3:GetBucketLocation", "s3:GetBucketLogging", "s3:GetBucketObjectLockConfiguration",
+    "s3:GetBucketOwnershipControls", "s3:GetBucketPolicy", "s3:GetBucketPublicAccessBlock",
+    "s3:GetBucketRequestPayment", "s3:GetBucketTagging", "s3:GetBucketVersioning",
+    "s3:GetBucketWebsite", "s3:GetEncryptionConfiguration", "s3:GetLifecycleConfiguration",
+    "s3:GetReplicationConfiguration", "s3:ListBucket",
+  ]
+  bucket_write = [
+    "s3:CreateBucket", "s3:DeleteBucket", "s3:PutBucketTagging",
+    "s3:PutBucketVersioning", "s3:PutBucketPublicAccessBlock", "s3:PutBucketOwnershipControls",
+    "s3:PutEncryptionConfiguration", "s3:PutBucketPolicy", "s3:DeleteBucketPolicy",
+    "s3:PutLifecycleConfiguration", "s3:PutBucketLogging", "s3:PutBucketCORS",
+    "s3:PutAccelerateConfiguration", "s3:PutBucketRequestPayment",
+  ]
+  queue_read = ["sqs:GetQueueAttributes", "sqs:GetQueueUrl", "sqs:ListQueueTags"]
+  queue_write = [
+    "sqs:CreateQueue", "sqs:DeleteQueue", "sqs:SetQueueAttributes",
+    "sqs:TagQueue", "sqs:UntagQueue",
+  ]
+  table_read = [
+    "dynamodb:DescribeTable", "dynamodb:DescribeContinuousBackups", "dynamodb:DescribeTimeToLive",
+    "dynamodb:ListTagsOfResource",
+  ]
+  table_write = [
+    "dynamodb:CreateTable", "dynamodb:DeleteTable", "dynamodb:UpdateTable",
+    "dynamodb:UpdateContinuousBackups", "dynamodb:UpdateTimeToLive",
+    "dynamodb:TagResource", "dynamodb:UntagResource",
+  ]
+}
+
+resource "aws_iam_openid_connect_provider" "github" {
+  url            = "https://${local.github_oidc_url}"
+  client_id_list = ["sts.amazonaws.com"]
+}
+
+# Plan role: pull_request runs of this repository. The workflow must not run for fork PRs with
+# this role configured; add a repository/environment gate there if forks are allowed.
+data "aws_iam_policy_document" "plan_trust" {
+  statement {
+    actions = ["sts:AssumeRoleWithWebIdentity"]
+    principals {
+      type        = "Federated"
+      identifiers = [local.github_oidc_arn]
+    }
+    condition {
+      test     = "StringEquals"
+      variable = "${local.github_oidc_url}:aud"
+      values   = ["sts.amazonaws.com"]
+    }
+    condition {
+      test     = "StringEquals"
+      variable = "${local.github_oidc_url}:sub"
+      values   = ["repo:${var.github_repository}:pull_request"]
+    }
+  }
+}
+
+# Apply role: only workflow runs on the protected branch.
+data "aws_iam_policy_document" "apply_trust" {
+  statement {
+    actions = ["sts:AssumeRoleWithWebIdentity"]
+    principals {
+      type        = "Federated"
+      identifiers = [local.github_oidc_arn]
+    }
+    condition {
+      test     = "StringEquals"
+      variable = "${local.github_oidc_url}:aud"
+      values   = ["sts.amazonaws.com"]
+    }
+    condition {
+      test     = "StringEquals"
+      variable = "${local.github_oidc_url}:sub"
+      values   = ["repo:${var.github_repository}:ref:refs/heads/${var.apply_branch}"]
+    }
+  }
+}
+
+resource "aws_iam_role" "plan" {
+  name                 = "ingest-ci-plan"
+  description          = "Assumed by pull_request runs of ${var.github_repository} to run terraform plan."
+  assume_role_policy   = data.aws_iam_policy_document.plan_trust.json
+  max_session_duration = 3600
+}
+
+resource "aws_iam_role" "apply" {
+  name                 = "ingest-ci-apply"
+  description          = "Assumed by ${var.apply_branch} runs of ${var.github_repository} to run terraform apply."
+  assume_role_policy   = data.aws_iam_policy_document.apply_trust.json
+  max_session_duration = 3600
+}
+
+# State access shared by both roles. Plan needs the lock object too (use_lockfile), which is the
+# only write the plan role holds.
+data "aws_iam_policy_document" "state_read" {
+  statement {
+    sid       = "ListStateBucket"
+    actions   = ["s3:ListBucket"]
+    resources = ["arn:aws:s3:::${var.state_bucket}"]
+    condition {
+      test     = "StringLike"
+      variable = "s3:prefix"
+      values   = [var.state_key, "${var.state_key}.tflock"]
+    }
+  }
+  statement {
+    sid       = "ReadState"
+    actions   = ["s3:GetObject"]
+    resources = [local.state_object_arn, local.lock_object_arn]
+  }
+  statement {
+    sid       = "HoldStateLock"
+    actions   = ["s3:PutObject", "s3:DeleteObject"]
+    resources = [local.lock_object_arn]
+  }
+}
+
+data "aws_iam_policy_document" "state_write" {
+  statement {
+    sid       = "WriteState"
+    actions   = ["s3:PutObject"]
+    resources = [local.state_object_arn]
+  }
+}
+
+data "aws_iam_policy_document" "plan" {
+  source_policy_documents = [data.aws_iam_policy_document.state_read.json]
+
+  statement {
+    sid     = "ReadManagedResources"
+    actions = concat(local.bucket_read, local.queue_read, local.table_read)
+    resources = [
+      aws_s3_bucket.landing.arn,
+      aws_sqs_queue.events.arn,
+      aws_dynamodb_table.checkpoints.arn,
+    ]
+  }
+
+  # Refreshing the CI-access resources in this same configuration.
+  statement {
+    sid = "ReadCiAccess"
+    actions = [
+      "iam:GetOpenIDConnectProvider", "iam:GetRole", "iam:GetRolePolicy",
+      "iam:ListRolePolicies", "iam:ListAttachedRolePolicies", "iam:ListInstanceProfilesForRole",
+    ]
+    resources = [
+      aws_iam_openid_connect_provider.github.arn,
+      aws_iam_role.plan.arn,
+      aws_iam_role.apply.arn,
+    ]
+  }
+}
+
+data "aws_iam_policy_document" "apply" {
+  source_policy_documents = [
+    data.aws_iam_policy_document.plan.json,
+    data.aws_iam_policy_document.state_write.json,
+  ]
+
+  statement {
+    sid     = "ChangeManagedResources"
+    actions = concat(local.bucket_write, local.queue_write, local.table_write)
+    resources = [
+      aws_s3_bucket.landing.arn,
+      aws_sqs_queue.events.arn,
+      aws_dynamodb_table.checkpoints.arn,
+    ]
+  }
+}
+
+resource "aws_iam_role_policy" "plan" {
+  name   = "terraform-plan"
+  role   = aws_iam_role.plan.id
+  policy = data.aws_iam_policy_document.plan.json
+}
+
+resource "aws_iam_role_policy" "apply" {
+  name   = "terraform-apply"
+  role   = aws_iam_role.apply.id
+  policy = data.aws_iam_policy_document.apply.json
+}
diff --git a/outputs.tf b/outputs.tf
