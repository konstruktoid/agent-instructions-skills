+}
diff --git a/variables.tf b/variables.tf
new file mode 100644
index 0000000..a431775
--- /dev/null
+++ b/variables.tf
@@ -0,0 +1,28 @@
+variable "github_repository" {
+  type        = string
+  description = "GitHub repository, in owner/name form, whose workflows may assume the CI roles. Only tokens issued to this repository match the role trust policies."
+  default     = "platform/ingest"
+
+  validation {
+    condition     = can(regex("^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", var.github_repository))
+    error_message = "Use the owner/name form, for example platform/ingest."
+  }
+}
+
+variable "apply_branch" {
+  type        = string
+  description = "Branch whose workflow runs may assume the apply role. Runs from any other ref, including pull requests, are refused by the trust policy."
+  default     = "main"
+}
+
+variable "state_bucket" {
+  type        = string
+  description = "Name of the S3 bucket that holds this configuration's remote state. Must match the bucket in the backend block, which cannot take variables."
+  default     = "ingest-terraform-state"
+}
+
+variable "state_key" {
+  type        = string
+  description = "Object key of this configuration's state file. Must match the key in the backend block. The lock file is the same key with a .tflock suffix."
+  default     = "ingest/terraform.tfstate"
+}
