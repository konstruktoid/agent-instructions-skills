diff --git a/bootstrap/main.tf b/bootstrap/main.tf
new file mode 100644
index 0000000..4538ebf
--- /dev/null
+++ b/bootstrap/main.tf
@@ -0,0 +1,255 @@
+data "aws_caller_identity" "current" {}
+data "aws_region" "current" {}
+
+locals {
+  account_id = data.aws_caller_identity.current.account_id
+  region     = data.aws_region.current.region
+
+  bucket_arn = "arn:aws:s3:::${var.landing_bucket}"
+  queue_arn  = "arn:aws:sqs:${local.region}:${local.account_id}:${var.events_queue}"
+  table_arn  = "arn:aws:dynamodb:${local.region}:${local.account_id}:table/${var.checkpoints_table}"
+
+  state_bucket_arn = "arn:aws:s3:::${var.state_bucket}"
+  state_object_arns = [
+    "${local.state_bucket_arn}/${var.state_key}",
+    "${local.state_bucket_arn}/${var.state_key}.tflock",
+  ]
+
+  oidc_host = "token.actions.githubusercontent.com"
+}
+
+resource "aws_iam_openid_connect_provider" "github" {
+  url            = "https://${local.oidc_host}"
+  client_id_list = ["sts.amazonaws.com"]
+}
+
+# Plan role: assumable from pull request runs, read-only on managed resources.
+data "aws_iam_policy_document" "plan_trust" {
+  statement {
+    actions = ["sts:AssumeRoleWithWebIdentity"]
+
+    principals {
+      type        = "Federated"
+      identifiers = [aws_iam_openid_connect_provider.github.arn]
+    }
+
+    condition {
+      test     = "StringEquals"
+      variable = "${local.oidc_host}:aud"
+      values   = ["sts.amazonaws.com"]
+    }
+
+    condition {
+      test     = "StringEquals"
+      variable = "${local.oidc_host}:sub"
+      values   = ["repo:${var.github_repository}:pull_request"]
+    }
+  }
+}
+
+# Apply role: assumable only from runs on the protected branch.
+data "aws_iam_policy_document" "apply_trust" {
+  statement {
+    actions = ["sts:AssumeRoleWithWebIdentity"]
+
+    principals {
+      type        = "Federated"
+      identifiers = [aws_iam_openid_connect_provider.github.arn]
+    }
+
+    condition {
+      test     = "StringEquals"
+      variable = "${local.oidc_host}:aud"
+      values   = ["sts.amazonaws.com"]
+    }
+
+    condition {
+      test     = "StringEquals"
+      variable = "${local.oidc_host}:sub"
+      values   = ["repo:${var.github_repository}:ref:refs/heads/${var.apply_branch}"]
+    }
+  }
+}
+
+# State access shared by both roles. Plan needs write on the lock object only,
+# so the state object itself is read-only for the plan role.
+data "aws_iam_policy_document" "state_read" {
+  statement {
+    sid       = "ListStateBucket"
+    actions   = ["s3:ListBucket"]
+    resources = [local.state_bucket_arn]
+
+    condition {
+      test     = "StringEquals"
+      variable = "s3:prefix"
+      values   = [var.state_key, "${var.state_key}.tflock"]
+    }
+  }
+
+  statement {
+    sid       = "ReadState"
+    actions   = ["s3:GetObject"]
+    resources = local.state_object_arns
+  }
+
+  statement {
+    sid       = "HoldStateLock"
+    actions   = ["s3:PutObject", "s3:DeleteObject"]
+    resources = ["${local.state_bucket_arn}/${var.state_key}.tflock"]
+  }
+}
+
+data "aws_iam_policy_document" "state_write" {
+  statement {
+    sid       = "WriteState"
+    actions   = ["s3:PutObject", "s3:DeleteObject"]
+    resources = ["${local.state_bucket_arn}/${var.state_key}"]
+  }
+}
+
+data "aws_iam_policy_document" "read_managed" {
+  statement {
+    sid = "ReadBucket"
+    actions = [
+      "s3:ListBucket",
+      "s3:GetAccelerateConfiguration",
+      "s3:GetBucketAcl",
+      "s3:GetBucketCORS",
+      "s3:GetBucketLocation",
+      "s3:GetBucketLogging",
+      "s3:GetBucketObjectLockConfiguration",
+      "s3:GetBucketPolicy",
+      "s3:GetBucketPublicAccessBlock",
+      "s3:GetBucketRequestPayment",
+      "s3:GetBucketTagging",
+      "s3:GetBucketVersioning",
+      "s3:GetBucketWebsite",
+      "s3:GetEncryptionConfiguration",
+      "s3:GetLifecycleConfiguration",
+      "s3:GetReplicationConfiguration",
+    ]
+    resources = [local.bucket_arn]
+  }
+
+  statement {
+    sid = "ReadQueue"
+    actions = [
+      "sqs:GetQueueAttributes",
+      "sqs:GetQueueUrl",
+      "sqs:ListQueueTags",
+    ]
+    resources = [local.queue_arn]
+  }
+
+  statement {
+    sid = "ReadTable"
+    actions = [
+      "dynamodb:DescribeContinuousBackups",
+      "dynamodb:DescribeTable",
+      "dynamodb:DescribeTimeToLive",
+      "dynamodb:ListTagsOfResource",
+    ]
+    resources = [local.table_arn]
+  }
+}
+
+data "aws_iam_policy_document" "write_managed" {
+  statement {
+    sid = "ManageBucket"
+    actions = [
+      "s3:CreateBucket",
+      "s3:DeleteBucket",
+      "s3:PutAccelerateConfiguration",
+      "s3:PutBucketAcl",
+      "s3:PutBucketCORS",
+      "s3:PutBucketLogging",
+      "s3:PutBucketObjectLockConfiguration",
+      "s3:PutBucketPolicy",
+      "s3:DeleteBucketPolicy",
+      "s3:PutBucketPublicAccessBlock",
+      "s3:PutBucketRequestPayment",
+      "s3:PutBucketTagging",
+      "s3:PutBucketVersioning",
+      "s3:PutEncryptionConfiguration",
+      "s3:PutLifecycleConfiguration",
+      "s3:PutReplicationConfiguration",
+    ]
+    resources = [local.bucket_arn]
+  }
+
+  statement {
+    sid = "ManageQueue"
+    actions = [
+      "sqs:CreateQueue",
+      "sqs:DeleteQueue",
+      "sqs:SetQueueAttributes",
+      "sqs:TagQueue",
+      "sqs:UntagQueue",
+    ]
+    resources = [local.queue_arn]
+  }
+
+  statement {
+    sid = "ManageTable"
+    actions = [
+      "dynamodb:CreateTable",
+      "dynamodb:DeleteTable",
+      "dynamodb:TagResource",
+      "dynamodb:UntagResource",
+      "dynamodb:UpdateContinuousBackups",
+      "dynamodb:UpdateTable",
+      "dynamodb:UpdateTimeToLive",
+    ]
+    resources = [local.table_arn]
+  }
+}
+
+resource "aws_iam_role" "plan" {
+  name                 = "ingest-ci-plan"
+  description          = "Assumed by pull request runs of the ingest workflow to run terraform plan with read-only access."
+  assume_role_policy   = data.aws_iam_policy_document.plan_trust.json
+  max_session_duration = var.apply_session_seconds
+}
+
+resource "aws_iam_role_policy" "plan_state" {
+  name   = "state-read"
+  role   = aws_iam_role.plan.id
+  policy = data.aws_iam_policy_document.state_read.json
+}
+
+resource "aws_iam_role_policy" "plan_managed" {
+  name   = "managed-read"
+  role   = aws_iam_role.plan.id
+  policy = data.aws_iam_policy_document.read_managed.json
+}
+
+resource "aws_iam_role" "apply" {
+  name                 = "ingest-ci-apply"
+  description          = "Assumed by main-branch runs of the ingest workflow to run terraform apply on the ingest configuration."
+  assume_role_policy   = data.aws_iam_policy_document.apply_trust.json
+  max_session_duration = var.apply_session_seconds
+}
+
+resource "aws_iam_role_policy" "apply_state" {
+  name   = "state-read-write"
+  role   = aws_iam_role.apply.id
+  policy = data.aws_iam_policy_document.state_read.json
+}
+
+resource "aws_iam_role_policy" "apply_state_write" {
+  name   = "state-write"
+  role   = aws_iam_role.apply.id
+  policy = data.aws_iam_policy_document.state_write.json
+}
+
+resource "aws_iam_role_policy" "apply_managed_read" {
+  name   = "managed-read"
+  role   = aws_iam_role.apply.id
+  policy = data.aws_iam_policy_document.read_managed.json
+}
+
+resource "aws_iam_role_policy" "apply_managed_write" {
+  name   = "managed-write"
+  role   = aws_iam_role.apply.id
+  policy = data.aws_iam_policy_document.write_managed.json
+}
diff --git a/bootstrap/outputs.tf b/bootstrap/outputs.tf
new file mode 100644
index 0000000..df2bc97
--- /dev/null
+++ b/bootstrap/outputs.tf
@@ -0,0 +1,9 @@
+output "plan_role_arn" {
+  description = "ARN of the role the pull request plan job assumes. Set as the role-to-assume of the plan step in the workflow."
+  value       = aws_iam_role.plan.arn
+}
+
+output "apply_role_arn" {
+  description = "ARN of the role the main-branch apply job assumes. Set as the role-to-assume of the apply step in the workflow."
+  value       = aws_iam_role.apply.arn
+}
