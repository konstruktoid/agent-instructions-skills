diff --git a/bootstrap/variables.tf b/bootstrap/variables.tf
new file mode 100644
index 0000000..c111420
--- /dev/null
+++ b/bootstrap/variables.tf
@@ -0,0 +1,57 @@
+variable "github_repository" {
+  type        = string
+  description = "GitHub repository, as owner/name, whose workflow may assume the CI roles. Only tokens issued for this repository match the role trust policies."
+  default     = "platform/ingest"
+
+  validation {
+    condition     = can(regex("^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", var.github_repository))
+    error_message = "github_repository must be in owner/name form, with no wildcards."
+  }
+}
+
+variable "apply_branch" {
+  type        = string
+  description = "Branch whose workflow runs may assume the apply role. Runs from any other ref are refused."
+  default     = "main"
+}
+
+variable "state_bucket" {
+  type        = string
+  description = "Name of the S3 bucket holding the ingest Terraform state. Both CI roles get access to the state key and its lock object in this bucket."
+  default     = "ingest-terraform-state"
+}
+
+variable "state_key" {
+  type        = string
+  description = "Object key of the ingest configuration state file. The lock object is this key with a .tflock suffix."
+  default     = "ingest/terraform.tfstate"
+}
+
+variable "landing_bucket" {
+  type        = string
+  description = "Name of the landing bucket the ingest configuration manages."
+  default     = "ingest-landing-staging"
+}
+
+variable "events_queue" {
+  type        = string
+  description = "Name of the SQS event queue the ingest configuration manages."
+  default     = "ingest-events-staging"
+}
+
+variable "checkpoints_table" {
+  type        = string
+  description = "Name of the DynamoDB checkpoint table the ingest configuration manages."
+  default     = "ingest-checkpoints-staging"
+}
+
+variable "apply_session_seconds" {
+  type        = number
+  description = "Maximum session length in seconds for the CI roles. Credentials issued by the OIDC exchange expire after this time."
+  default     = 3600
+
+  validation {
+    condition     = var.apply_session_seconds >= 3600 && var.apply_session_seconds <= 43200
+    error_message = "apply_session_seconds must be between 3600 and 43200."
+  }
+}
diff --git a/bootstrap/versions.tf b/bootstrap/versions.tf
new file mode 100644
index 0000000..0785e82
--- /dev/null
+++ b/bootstrap/versions.tf
@@ -0,0 +1,18 @@
+terraform {
+  required_version = ">= 1.10.0"
+
+  required_providers {
+    aws = {
+      source  = "hashicorp/aws"
+      version = "~> 6.0"
+    }
+  }
+
+  backend "s3" {
+    bucket       = "ingest-terraform-state"
+    key          = "ingest/bootstrap/terraform.tfstate"
+    region       = "eu-north-1"
+    encrypt      = true
+    use_lockfile = true
+  }
+}
