diff --git a/bootstrap/variables.tf b/bootstrap/variables.tf
new file mode 100644
index 0000000..9e3258e
--- /dev/null
+++ b/bootstrap/variables.tf
@@ -0,0 +1,21 @@
+variable "region" {
+  type        = string
+  description = "AWS region the state bucket is created in."
+  default     = "eu-north-1"
+}
+
+variable "state_bucket_name" {
+  type        = string
+  description = "Name of the S3 bucket that holds Terraform state. S3 bucket names are global, so choose one unique to your organization."
+
+  validation {
+    condition     = can(regex("^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$", var.state_bucket_name))
+    error_message = "Use 3-63 characters: lowercase letters, digits, hyphens and dots, starting and ending with a letter or digit."
+  }
+}
+
+variable "noncurrent_version_retention_days" {
+  type        = number
+  description = "Days a replaced or deleted state version is kept before S3 removes it. Older versions cannot be rolled back to."
+  default     = 90
+}
