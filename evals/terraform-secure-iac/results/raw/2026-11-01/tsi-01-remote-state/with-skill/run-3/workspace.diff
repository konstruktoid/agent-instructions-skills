diff --git a/bootstrap/variables.tf b/bootstrap/variables.tf
new file mode 100644
index 0000000..892603a
--- /dev/null
+++ b/bootstrap/variables.tf
@@ -0,0 +1,21 @@
+variable "region" {
+  type        = string
+  description = "AWS region the state bucket is created in. Must match the region in the backend block of the parent configuration."
+  default     = "eu-north-1"
+}
+
+variable "state_bucket_name" {
+  type        = string
+  description = "Name of the S3 bucket that holds Terraform state. S3 bucket names are global, so choose a unique one. Must match the bucket in the backend block of the parent configuration."
+
+  validation {
+    condition     = can(regex("^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$", var.state_bucket_name))
+    error_message = "The bucket name must be 3 to 63 characters of lowercase letters, digits, dots, and hyphens."
+  }
+}
+
+variable "noncurrent_version_retention_days" {
+  type        = number
+  description = "Days a superseded state version is kept before it is deleted. Older versions are the rollback history for a corrupt or truncated state."
+  default     = 90
+}
