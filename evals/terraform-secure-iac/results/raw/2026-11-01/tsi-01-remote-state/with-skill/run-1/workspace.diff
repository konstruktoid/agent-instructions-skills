diff --git a/bootstrap/variables.tf b/bootstrap/variables.tf
new file mode 100644
index 0000000..1bb8e98
--- /dev/null
+++ b/bootstrap/variables.tf
@@ -0,0 +1,25 @@
+variable "region" {
+  type        = string
+  description = "AWS region the state bucket and its KMS key are created in."
+  default     = "eu-north-1"
+}
+
+variable "state_bucket_name" {
+  type        = string
+  description = "Name of the S3 bucket that holds Terraform state. S3 bucket names are global, so choose one unique to your organisation."
+
+  validation {
+    condition     = can(regex("^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$", var.state_bucket_name))
+    error_message = "The bucket name must be 3-63 characters of lowercase letters, digits, dots and hyphens."
+  }
+}
+
+variable "state_access_principal_arns" {
+  type        = list(string)
+  description = "IAM role or user ARNs allowed to read and write state. Every other principal is denied by the bucket policy. Include the identity that runs this bootstrap configuration, or it locks itself out."
+
+  validation {
+    condition     = length(var.state_access_principal_arns) > 0
+    error_message = "Provide at least one principal ARN, otherwise nobody can use the bucket."
+  }
+}
