diff --git a/main.tf b/main.tf
index 1500571..6846112 100644
--- a/main.tf
+++ b/main.tf
@@ -14,3 +14,35 @@ resource "aws_db_subnet_group" "orders" {
   name       = "orders"
   subnet_ids = var.private_subnet_ids
 }
+
+resource "aws_db_instance" "orders" {
+  identifier = "orders"
+  db_name    = "orders"
+
+  engine         = "postgres"
+  engine_version = "17"
+  instance_class = "db.t4g.micro"
+
+  allocated_storage = 20
+  storage_type      = "gp3"
+  storage_encrypted = true
+
+  username = var.db_username
+  # Write-only: the password is sent to RDS but never stored in state or plan.
+  # Bump db_password_version to rotate it.
+  password_wo         = var.db_password
+  password_wo_version = var.db_password_version
+
+  db_subnet_group_name   = aws_db_subnet_group.orders.name
+  vpc_security_group_ids = [aws_security_group.orders_db.id]
+  publicly_accessible    = false
+
+  backup_retention_period             = 7
+  auto_minor_version_upgrade          = true
+  iam_database_authentication_enabled = true
+  deletion_protection                 = true
+  copy_tags_to_snapshot               = true
+  skip_final_snapshot                 = false
+  final_snapshot_identifier           = "orders-final"
+  enabled_cloudwatch_logs_exports     = ["postgresql"]
+}
diff --git a/outputs.tf b/outputs.tf
index 856ecf0..1f51e94 100644
--- a/outputs.tf
+++ b/outputs.tf
@@ -1,3 +1,23 @@
 output "db_security_group_id" {
   value = aws_security_group.orders_db.id
 }
+
+output "db_address" {
+  description = "Hostname of the orders database."
+  value       = aws_db_instance.orders.address
+}
+
+output "db_port" {
+  description = "Port the orders database listens on."
+  value       = aws_db_instance.orders.port
+}
+
+output "db_name" {
+  description = "Name of the initial database."
+  value       = aws_db_instance.orders.db_name
+}
+
+output "db_username" {
+  description = "Master username of the orders database."
+  value       = aws_db_instance.orders.username
+}
diff --git a/variables.tf b/variables.tf
index 5a3c309..007d496 100644
--- a/variables.tf
+++ b/variables.tf
@@ -17,6 +17,14 @@ variable "db_username" {
 }
 
 variable "db_password" {
-  type    = string
-  default = "orders-dev-2024"
+  type        = string
+  description = "Master password for the orders database. Supply it at run time, for example through TF_VAR_db_password; it is not written to state or plan."
+  sensitive   = true
+  ephemeral   = true
+}
+
+variable "db_password_version" {
+  type        = number
+  description = "Version of the master password. Increasing it makes Terraform send the current db_password to RDS again."
+  default     = 1
 }
